---
import BaseLayout from "../components/layout/BaseLayout.astro";

const siteUrl = "https://ynsweb.studio";
const pageUrl = `${siteUrl}/about`;

const principles = [
  {
    number: "01",
    title: "Strategy Before Design",
    description:
      "We start with the business goal, target audience, offer and conversion path before deciding how the interface should look.",
  },
  {
    number: "02",
    title: "Built Around Enquiries",
    description:
      "Clear calls-to-action, WhatsApp flows, enquiry forms and frictionless contact paths are treated as part of the website architecture.",
  },
  {
    number: "03",
    title: "Performance & SEO Foundation",
    description:
      "Clean structure, responsive layouts, semantic HTML, metadata and performance-conscious development create a stronger technical foundation.",
  },
  {
    number: "04",
    title: "Built to Scale",
    description:
      "From business websites to database-backed applications, the technology is selected around the actual requirements of the project.",
  },
];

const capabilities = [
  "Business Websites",
  "Landing Pages",
  "E-Commerce",
  "Booking Systems",
  "Admin Dashboards",
  "Custom Web Applications",
  "React & Next.js",
  "SEO-Friendly Architecture",
];

const services = [
  {
    title: "Business Website Development",
    href: "/services/business-website-development",
    price: "₹20,000+",
  },
  {
    title: "Landing Page Development",
    href: "/services/landing-page-development",
    price: "₹12,000+",
  },
  {
    title: "E-Commerce Development",
    href: "/services/ecommerce-development",
    price: "₹60,000+",
  },
  {
    title: "Next.js & React Development",
    href: "/services/nextjs-development",
    price: "₹50,000+",
  },
  {
    title: "Custom Web Applications",
    href: "/services/custom-web-development",
    price: "₹1,00,000+",
  },
  {
    title: "Booking & Appointment Websites",
    href: "/services/booking-appointment-websites",
    price: "₹45,000+",
  },
];

const faqs = [
  {
    question: "What is YNS Web Studio?",
    answer:
      "YNS Web Studio is a Jaipur-based web development studio focused on structured, high-performance websites and custom web applications for businesses, startups and service-based brands.",
  },
  {
    question: "What type of websites do you build?",
    answer:
      "We build business websites, landing pages, e-commerce websites, booking and appointment websites, corporate websites, real estate websites, hospitality websites and custom web applications.",
  },
  {
    question: "Do you only work with businesses in Jaipur?",
    answer:
      "No. YNS Web Studio is based in Jaipur and works with local businesses as well as projects that can be handled remotely.",
  },
  {
    question: "Do you use React and Next.js?",
    answer:
      "Yes. React and Next.js are used for projects that benefit from reusable components, application-level functionality, API integrations, authentication and scalable architecture.",
  },
  {
    question: "Can you build a website around my business requirements?",
    answer:
      "Yes. The structure, technology and functionality are selected around the business requirement rather than forcing every project into the same template.",
  },
];

const iconPaths = {
  arrow: `<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>`,
  check: `<path d="m5 12 4 4L19 6"></path>`,
  shield: `<path d="M12 3 20 6v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z"></path><path d="m9 12 2 2 4-4"></path>`,
  chart: `<path d="M4 19V5"></path><path d="M4 19h16"></path><path d="m7 15 3-4 3 2 5-7"></path>`,
  search: `<circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path>`,
  code: `<path d="m8 9-3 3 3 3"></path><path d="m16 9 3 3-3 3"></path><path d="m14 5-4 14"></path>`,
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": `${pageUrl}#about`,
      url: pageUrl,
      name: "About YNS Web Studio",
      description: "About YNS Web Studio, a Jaipur-based web development studio.",
      isPartOf: {
        "@type": "WebSite",
        name: "YNS Web Studio",
        url: siteUrl,
      },
    },
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}#business`,
      name: "YNS Web Studio",
      url: siteUrl,
      description:
        "Web development studio in Jaipur building business websites, e-commerce websites, booking systems and custom web applications.",
      areaServed: [
        { "@type": "City", name: "Jaipur" },
        { "@type": "Country", name: "India" },
      ],
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
        { "@type": "ListItem", position: 2, name: "About", item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title="About YNS Web Studio Jaipur | Conversion-Focused Web Developers"
  description="Learn about YNS Web Studio, a Jaipur-based web development studio building structured, fast and conversion-focused websites and web applications for businesses."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="business-page">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>

      <div class="container hero-container">

        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <span aria-current="page">About</span>
        </nav>

        <div class="hero-layout">

          <div class="hero-copy">

            <div class="eyebrow">
              <span class="eyebrow-dot"></span>
              Based in Jaipur · Web Engineering Studio
            </div>

            <h1>
              We build websites that
              <em>do more than exist.</em>
            </h1>

            <p class="hero-description">
              YNS Web Studio builds structured, high-performance websites and web applications designed around clarity, credibility and real business outcomes.
            </p>

            <div class="hero-actions">
              <a
                href="/work"
                class="button button-primary"
              >
                See Our Work
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.arrow}></g>
                </svg>
              </a>

              <a href="https://wa.me/919352563337" target="_blank" rel="noopener noreferrer" class="button button-secondary">
                Start a Project
              </a>
            </div>

            <div class="hero-stats">
              <div>
                <strong>01</strong>
                <span>Strategy-led</span>
              </div>
              <div>
                <strong>02</strong>
                <span>Performance-focused</span>
              </div>
              <div>
                <strong>03</strong>
                <span>Business-first</span>
              </div>
            </div>

          </div>

          <!-- WEBSITE PREVIEW MOCKUP -->
          <div class="hero-visual">

            <div class="visual-label visual-label-top">
              <span></span>
              WEB DEVELOPMENT / JAIPUR
            </div>

            <div class="browser-window">

              <div class="browser-top">
                <div class="browser-controls">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <div class="browser-url">
                  <span class="lock">⌁</span>
                  ynsweb.studio/about
                </div>

                <div class="browser-menu">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>

              <div class="website-preview">

                <div class="preview-nav">
                  <div class="preview-brand">
                    <span class="brand-mark">Y</span>
                    <span>YNS STUDIO</span>
                  </div>

                  <div class="preview-links">
                    <span>Mission</span>
                    <span>Principles</span>
                    <span>Stack</span>
                  </div>

                  <div class="preview-nav-button">Jaipur</div>
                </div>

                <div class="preview-hero">
                  <div class="preview-hero-copy">
                    <span class="mini-label">ENGINEERING INTEGRITY</span>

                    <div class="preview-heading">
                      Strategy.<br />
                      Structure.<br />
                      <i>Results.</i>
                    </div>

                    <div class="preview-lines">
                      <span></span>
                      <span></span>
                    </div>

                    <div class="preview-cta-row">
                      <span class="preview-button"></span>
                      <span class="preview-link"></span>
                    </div>
                  </div>

                  <div class="preview-visual-card">
                    <div class="visual-card-shape shape-one"></div>
                    <div class="visual-card-shape shape-two"></div>
                    <div class="visual-card-inner">
                      <span>100%</span>
                      <strong>CUSTOM</strong>
                    </div>
                  </div>
                </div>

                <div class="preview-bottom">
                  <div>
                    <span>01</span>
                    <small>No templates</small>
                  </div>
                  <div>
                    <span>02</span>
                    <small>Fast & light</small>
                  </div>
                  <div>
                    <span>03</span>
                    <small>Built to scale</small>
                  </div>
                </div>

              </div>
            </div>

            <div class="floating-card floating-card-one">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.chart}></g>
                </svg>
              </span>
              <div>
                <strong>Business Assets</strong>
                <small>Websites with a job to do</small>
              </div>
            </div>

            <div class="floating-card floating-card-two">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.shield}></g>
                </svg>
              </span>
              <div>
                <strong>Technical SEO</strong>
                <small>Search engine ready</small>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- MISSION -->
    <section class="intro-section">
      <div class="container">
        <div class="intro-grid">

          <div class="section-number">01</div>

          <div class="intro-content">
            <p class="section-kicker">Why YNS Web Studio</p>

            <h2>
              A website should be an
              <span>asset.</span>
            </h2>

            <div class="intro-text-grid">
              <p>
                A business website shouldn't simply sit online with an attractive design. It should explain what you do, establish trust, make the next step obvious and give customers a simple way to contact you.
              </p>

              <p>
                That's the thinking behind YNS Web Studio. We combine design, frontend engineering, technical SEO and conversion-focused structure to create digital experiences that have a job to do.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- PRINCIPLES -->
    <section class="benefits-section">
      <div class="container">

        <div class="section-heading split-heading">
          <div>
            <p class="section-kicker">How we work</p>
            <h2>Principles behind<br /><span>every build.</span></h2>
          </div>

          <p>
            The goal isn't to make every website look the same. The goal is to make every website solve the right problem.
          </p>
        </div>

        <div class="benefit-grid">
          {
            principles.map((principle) => (
              <article class="benefit-card">
                <div class="card-number">{principle.number}</div>

                <div class="card-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.code}></g>
                  </svg>
                </div>

                <h3>{principle.title}</h3>
                <p>{principle.description}</p>

                <span class="card-arrow">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.arrow}></g>
                  </svg>
                </span>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- WHAT WE BUILD -->
    <section class="included-section">
      <div class="container">

        <div class="included-layout">

          <div class="included-intro">
            <div class="dark-kicker">
              <span></span>
              What we build
            </div>

            <h2>
              From business websites
              <span>to web systems.</span>
            </h2>

            <p>
              Different businesses need different levels of functionality. We build from focused landing pages to database-backed applications and custom workflows.
            </p>

            <a
              href="/services"
              class="dark-button"
            >
              View all services
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.arrow}></g>
              </svg>
            </a>
          </div>

          <div class="feature-list">
            {
              capabilities.map((capability, index) => (
                <div class="feature-item">
                  <span class="feature-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="feature-check">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <g set:html={iconPaths.check}></g>
                    </svg>
                  </span>

                  <span>{capability}</span>
                </div>
              ))
            }
          </div>

        </div>
      </div>
    </section>

    <!-- SERVICES & STARTING PRICES -->
    <section class="pages-section">
      <div class="container">

        <div class="pages-header">
          <div>
            <p class="section-kicker">Services & starting prices</p>
            <h2>
              Choose the right
              <span>starting point.</span>
            </h2>
          </div>

          <p>
            Every project is scoped around its actual requirements. These starting prices give you a clear idea of where different types of projects begin.
          </p>
        </div>

        <div class="page-grid" style="grid-template-columns: repeat(2, 1fr);">
          {
  services.map(({ title, href, price }, index) => (
              <article class="page-card" style="min-height: 200px;">
                <div class="page-card-top">
                  <span>0{index + 1}</span>
                  <strong>{price}</strong>
                </div>

                <h3 style="margin-top: 30px;">{title}</h3>

                <a href={href} class="text-link" style="margin-top: 20px; display: inline-flex;">
                  Explore service <span>→</span>
                </a>

                <div class="page-line"></div>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- STATEMENT -->
    <section class="statement-section">
      <div class="container">
        <div class="statement">
          <span class="statement-mark">“</span>
          <h2>
            Don't build a website just because your competitors have one.
            <em>Build one that gives people a reason to choose you.</em>
          </h2>
          <div class="statement-footer">
            <span>YNS WEB STUDIO</span>
            <span>JAIPUR · INDIA</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="faq-section">
      <div class="container faq-container">

        <div class="faq-heading">
          <p class="section-kicker">Common questions</p>

          <h2>
            About the
            <span>studio.</span>
          </h2>

          <p>
            A few straightforward answers before we start working together.
          </p>
        </div>

        <div class="faq-list">
          {
            faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>
                  <span class="faq-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="faq-question">{faq.question}</span>

                  <span class="faq-toggle">
                    <span></span>
                    <span></span>
                  </span>
                </summary>

                <div class="faq-answer">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))
          }
        </div>

      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="final-cta-section">
      <div class="container">

        <div class="final-cta">

          <div class="cta-grid"></div>
          <div class="cta-glow"></div>

          <div class="cta-content">
            <div class="dark-kicker">
              <span></span>
              Let's build
            </div>

            <h2>
              Your business deserves
              <span>a better website.</span>
            </h2>

            <p>
              Tell us what you're building, what isn't working right now and what you want the website to achieve.
            </p>

            <div class="cta-actions">
              <a
                href="https://wa.me/919352563337"
                target="_blank"
                rel="noopener noreferrer"
                class="cta-primary"
              >
                Start a Project
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.arrow}></g>
                </svg>
              </a>

              <a href="/work" class="cta-secondary">
                View Our Work
              </a>
            </div>

            <div class="cta-location">
              <span></span>
              Based in Jaipur, Rajasthan · Available for web projects
            </div>
          </div>

          <div class="cta-side">
            <div class="cta-side-number">YNS</div>
            <p>Strategy.<br />Design.<br /><strong>Growth.</strong></p>
          </div>

        </div>

      </div>
    </section>

  </div>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    background: #f7f7f5;
  }

  .business-page {
    --ink: #111111;
    --muted: #696969;
    --soft: #f1f1ee;
    --line: #deded9;
    --dark: #101010;
    --white: #ffffff;
    --accent: #c9ff4a;
    color: var(--ink);
    overflow: hidden;
  }

  .container {
    width: min(1240px, calc(100% - 40px));
    margin: 0 auto;
  }

  /* HERO */
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 850px;
    overflow: hidden;
    background:
      radial-gradient(circle at 80% 18%, rgba(201, 255, 74, 0.12), transparent 28%),
      #101010;
    color: white;
  }

  .hero-grid,
  .cta-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.28;
    background-image:
      linear-gradient(rgba(255,255,255,0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.055) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
  }

  .hero-glow {
    position: absolute;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.12;
    pointer-events: none;
  }

  .hero-glow-one {
    right: -180px;
    top: 120px;
    background: #c9ff4a;
  }

  .hero-glow-two {
    left: -250px;
    bottom: -280px;
    background: #ffffff;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    padding-top: 32px;
    padding-bottom: 90px;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: #777;
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .breadcrumb a {
    color: #888;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: white;
  }

  .breadcrumb span:last-child {
    color: #d4d4d4;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(460px, 0.86fr);
    align-items: center;
    gap: 70px;
    min-height: 750px;
  }

  .hero-copy {
    max-width: 690px;
    padding-top: 20px;
  }

  .eyebrow,
  .dark-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #a5a5a5;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .eyebrow-dot,
  .dark-kicker span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 16px rgba(201,255,74,0.65);
  }

  .hero h1 {
    max-width: 760px;
    margin: 28px 0 0;
    font-size: clamp(52px, 6vw, 88px);
    line-height: 0.98;
    letter-spacing: -0.065em;
    font-weight: 500;
  }

  .hero h1 em {
    display: block;
    color: #777;
    font-style: normal;
  }

  .hero-description {
    max-width: 650px;
    margin-top: 30px;
    color: #a7a7a7;
    font-size: 18px;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 38px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform 0.25s ease,
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .button svg,
  .dark-button svg,
  .pricing-button svg,
  .text-link svg,
  .related-card svg,
  .cta-primary svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    color: #111;
    background: var(--accent);
  }

  .button-primary:hover {
    background: #d9ff79;
  }

  .button-secondary {
    color: white;
    border: 1px solid #3d3d3d;
    background: rgba(255,255,255,0.02);
  }

  .button-secondary:hover {
    border-color: #666;
    background: rgba(255,255,255,0.06);
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 650px;
    margin-top: 65px;
    border-top: 1px solid #303030;
    padding-top: 22px;
  }

  .hero-stats div {
    padding-right: 20px;
  }

  .hero-stats div + div {
    padding-left: 20px;
    border-left: 1px solid #303030;
  }

  .hero-stats strong {
    display: block;
    font-size: 15px;
    font-weight: 600;
    color: white;
  }

  .hero-stats span {
    display: block;
    margin-top: 6px;
    color: #666;
    font-size: 11px;
  }

  /* HERO VISUAL MOCKUP */
  .hero-visual {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .visual-label {
    position: absolute;
    z-index: 5;
    color: #777;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  .visual-label-top {
    top: 18px;
    right: 10px;
  }

  .visual-label-top span {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .browser-window {
    width: min(100%, 570px);
    overflow: hidden;
