---
import BaseLayout from "../components/layout/BaseLayout.astro";
---

<BaseLayout
  title="About YNS Web Studio Jaipur | Conversion-Focused Web Developers"
  description="Learn about YNS Web Studio based in Jaipur. Discover how we build structured, lightning-fast, high-converting websites for local businesses, gyms, and clinics."
>

  <!-- Header Section -->
  <section class="relative bg-gradient-to-b from-slate-50 via-white to-slate-50 py-24 md:py-32 overflow-hidden border-b border-slate-100 text-center">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-96 h-96 bg-emerald-100/50 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-6 relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-xs font-semibold text-slate-700 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Based in Jaipur, Rajasthan • Web Engineering Studio
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
        About <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-600">YNS Web Studio</span>
      </h1>

      <p class="mt-6 text-lg md:text-xl text-slate-600 max-w-2xl mx-auto font-normal leading-relaxed">
        We don’t just build disposable online brochures — we engineer structured, high-performance web systems designed specifically to generate real enquiries and drive revenue for local businesses.
      </p>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-24 bg-gradient-to-b from-white via-slate-50/50 to-white border-b border-slate-100 text-center">
    <div class="max-w-4xl mx-auto px-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-xs font-semibold text-blue-600 mb-4 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span>
        Our Core Purpose
      </div>

      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
        Our Mission
      </h2>

      <p class="mt-6 text-xl text-slate-700 font-medium leading-relaxed max-w-3xl mx-auto">
        "To help local service businesses, gyms, clinics, and retailers turn their digital presence into a reliable, lead-generating asset instead of an expensive, silent website."
      </p>
    </div>
  </section>

  <!-- Approach / Pillars Section -->
  <section class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 text-center">
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-100 text-xs font-semibold text-emerald-600 mb-4 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
        How We Operate
      </div>

      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
        Our Engineering Principles
      </h2>
      <p class="mt-3 text-slate-600 text-base max-w-xl mx-auto">
        The standards we follow on every single client build.
      </p>

      <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8 text-left">

        <!-- Pillar 1 -->
        <div class="p-8 rounded-2xl bg-slate-50/80 border border-slate-200/60 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-lg mb-6">
            🎯
          </div>
          <h3 class="text-xl font-bold text-slate-900">Strategy Before Design</h3>
          <p class="mt-3 text-slate-600 text-sm leading-relaxed">
            We focus intensely on user clarity, value messaging, and conversion architecture before touching any visual styling or templates.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div class="p-8 rounded-2xl bg-slate-50/80 border border-slate-200/60 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-lg mb-6">
            💬
          </div>
          <h3 class="text-xl font-bold text-slate-900">Built Exclusively for Enquiries</h3>
          <p class="mt-3 text-slate-600 text-sm leading-relaxed">
            Every website is structured around compelling calls-to-action, prominent WhatsApp integrations, and frictionless contact paths.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div class="p-8 rounded-2xl bg-slate-50/80 border border-slate-200/60 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-lg mb-6">
            ⚡
          </div>
          <h3 class="text-xl font-bold text-slate-900">Performance & SEO Ready</h3>
          <p class="mt-3 text-slate-600 text-sm leading-relaxed">
            Clean codebases, lightning-fast mobile-first load speeds, and structured semantic headings built for superior search engine rankings.
          </p>
        </div>

        <!-- Pillar 4 -->
        <div class="p-8 rounded-2xl bg-slate-50/80 border border-slate-200/60 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-lg mb-6">
            📈
          </div>
          <h3 class="text-xl font-bold text-slate-900">Long-Term Scalability</h3>
          <p class="mt-3 text-slate-600 text-sm leading-relaxed">
            We don't build disposable sites. We build robust technical foundations using modern stacks like Next.js and Astro that scale with your business.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- Final Call To Action -->
  <section class="relative bg-zinc-950 text-white py-24 md:py-32 overflow-hidden border-t border-zinc-800 text-center">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-3xl mx-auto px-6 relative z-10">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        Let’s Build Something That <span class="text-emerald-400">Actually Works</span>
      </h2>
      <p class="mt-6 text-lg text-zinc-400 max-w-xl mx-auto leading-relaxed">
        If you’re serious about elevating your local business online and generating real enquiries, let’s start a conversation today.
      </p>
      <div class="mt-10">
        <a
          href="https://wa.me/919352563337"
          target="_blank"
          class="inline-flex items-center justify-center rounded-xl bg-emerald-500 text-zinc-950 px-8 py-4 font-bold hover:bg-emerald-400 transition shadow-xl shadow-emerald-500/20"
        >
          Start a Conversation on WhatsApp
        </a>
      </div>
      <p class="mt-5 text-xs text-zinc-500">
        Based in Jaipur, Rajasthan • Direct developer collaboration.
      </p>
    </div>
  </section>

</BaseLayout>