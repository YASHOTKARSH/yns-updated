---
import BaseLayout from "../components/layout/BaseLayout.astro";
---

<BaseLayout
  title="Website Pricing & Packages | YNS Web Studio Jaipur"
  description="Transparent pricing for high-converting websites starting from ₹8,999. Designed to generate more enquiries for local businesses, gyms, and clinics in Jaipur."
>

  <!-- Header Section -->
  <section class="relative bg-gradient-to-b from-slate-50 via-white to-slate-50 py-24 md:py-32 overflow-hidden border-b border-slate-100 text-center">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-96 h-96 bg-emerald-100/50 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-6 relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-xs font-semibold text-slate-700 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Transparent Investment • No Hidden Surprises
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
        Simple & <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-600">Transparent Pricing</span>
      </h1>

      <p class="mt-6 text-lg md:text-xl text-slate-600 max-w-2xl mx-auto font-normal leading-relaxed">
        No bloated agency fees. Just honest pricing for structured, high-speed web systems built specifically to scale your local business in Jaipur.
      </p>
    </div>
  </section>

  <!-- Pricing Cards Section -->
  <section class="py-24 bg-gradient-to-b from-white via-slate-50/50 to-white border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-10 items-stretch">

      <!-- Starter Plan -->
      <div class="bg-white p-8 md:p-10 rounded-2xl border border-slate-200/85 shadow-sm hover:shadow-xl hover:border-emerald-200 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-bold text-slate-900">Starter Website</h2>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-bold uppercase tracking-wider">Launch Ready</span>
          </div>

          <p class="mt-4 text-4xl font-extrabold text-slate-900">₹8,999</p>
          <p class="mt-2 text-sm text-slate-500">
            Ideal for small local service businesses and clinics starting online.
          </p>

          <ul class="mt-8 space-y-4 text-sm font-medium text-slate-700 pt-6 border-t border-slate-100">
            <li class="flex items-center gap-3"><span class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span> Up to 4 custom pages</li>
            <li class="flex items-center gap-3"><span class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span> Instant WhatsApp chat integration</li>
            <li class="flex items-center gap-3"><span class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span> Conversion-focused contact form</li>
            <li class="flex items-center gap-3"><span class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span> Mobile-first responsive design</li>
            <li class="flex items-center gap-3"><span class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span> Basic local SEO-ready structure</li>
            <li class="flex items-center gap-3"><span class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span> 1 month direct developer support</li>
          </ul>
        </div>

        <div class="mt-10 pt-6 border-t border-slate-100">
          <a
            href="https://wa.me/919352563337"
            target="_blank"
            class="w-full inline-flex items-center justify-center rounded-xl bg-slate-900 text-white px-6 py-3.5 font-semibold hover:bg-slate-800 transition shadow-sm"
          >
            Get Started on WhatsApp
          </a>
        </div>
      </div>

      <!-- Growth Plan -->
      <div class="bg-white p-8 md:p-10 rounded-2xl border-2 border-emerald-500 shadow-xl relative flex flex-col justify-between transform md:-translate-y-2">
        <div class="absolute -top-3.5 right-8 bg-emerald-500 text-white text-xs font-extrabold uppercase px-3.5 py-1 rounded-full shadow-sm tracking-wider">
          Most Popular
        </div>

        <div>
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-bold text-slate-900">Growth Website</h2>
            <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-600 text-xs font-bold uppercase tracking-wider">Scale Up</span>
          </div>

          <p class="mt-4 text-4xl font-extrabold text-slate-900">₹16,999</p>
          <p class="mt-2 text-sm text-slate-500">
            For established local businesses ready to dominate their local market.
          </p>

          <ul class="mt-8 space-y-4 text-sm font-medium text-slate-700 pt-6 border-t border-slate-100">
            <li class="flex items-center gap-3"><span class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span> Up to 7 custom pages</li>
            <li class="flex items-center gap-3"><span class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span> Advanced custom UI/UX design architecture</li>
            <li class="flex items-center gap-3"><span class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span> WhatsApp + Form multi-channel enquiry flow</li>
            <li class="flex items-center gap-3"><span class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span> Google Maps local listing embedded</li>
            <li class="flex items-center gap-3"><span class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span> 99+ Lighthouse speed optimization</li>
            <li class="flex items-center gap-3"><span class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span> Advanced local SEO metadata setup</li>
            <li class="flex items-center gap-3"><span class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span> 2 months priority direct support</li>
          </ul>
        </div>

        <div class="mt-10 pt-6 border-t border-slate-100">
          <a
            href="https://wa.me/919352563337"
            target="_blank"
            class="w-full inline-flex items-center justify-center rounded-xl bg-emerald-600 text-white px-6 py-3.5 font-semibold hover:bg-emerald-700 transition shadow-lg shadow-emerald-600/20"
          >
            Get Growth Plan on WhatsApp
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 bg-white text-center">
    <div class="max-w-4xl mx-auto px-6">
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-xs font-semibold text-blue-600 mb-4 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span>
        Clear Answers
      </div>

      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
        Frequently Asked Questions
      </h2>

      <div class="mt-14 text-left space-y-6">

        <div class="p-6 rounded-2xl bg-slate-50/80 border border-slate-200/60 shadow-sm">
          <h3 class="font-bold text-lg text-slate-900">Do I need to provide website content?</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            You provide basic business details, services, and photos. I personally help rewrite and structure it into crisp, persuasive copy optimized for conversions.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50/80 border border-slate-200/60 shadow-sm">
          <h3 class="font-bold text-lg text-slate-900">How long does it take to build the website?</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            Standard websites (Starter & Growth plans) are fully designed, optimized, and launched within just **7 to 10 working days** after content submission.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50/80 border border-slate-200/60 shadow-sm">
          <h3 class="font-bold text-lg text-slate-900">Who will I be talking to during development?</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            You deal directly with me (Yashotkarsh). No middlemen, no junior customer support reps—ensuring absolute clarity and fast execution.
          </p>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>