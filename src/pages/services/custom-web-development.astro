---
import BaseLayout from "../../components/layout/BaseLayout.astro";

const siteUrl = "https://ynsweb.studio";
const pageUrl = "https://ynsweb.studio/services/custom-web-development";

const faqs = [
  {
    question: "How much does a custom web application cost in Jaipur?",
    answer:
      "Custom web application development at YNS Web Studio starts from around ₹1,00,000. The final investment depends on the application's workflows, user roles, database requirements, integrations and overall scope.",
  },
  {
    question: "What type of custom web applications do you build?",
    answer:
      "We build dashboards, customer portals, SaaS products, internal management systems, booking platforms, workflow applications, API-driven products and other database-powered web applications.",
  },
  {
    question: "How long does custom web development take?",
    answer:
      "A typical custom web application takes around 4–10 weeks. Larger products can require more time depending on the number of features, integrations, user roles and testing requirements.",
  },
  {
    question: "Can you build both the frontend and backend?",
    answer:
      "Yes. We provide full-stack development covering the frontend interface, backend APIs, authentication, database integration, third-party services and deployment.",
  },
  {
    question: "Can you connect an existing API or software?",
    answer:
      "Yes. Existing APIs and business systems can be integrated when suitable documentation and access are available. The integration is planned around the application's data flow and security requirements.",
  },
  {
    question: "Do you provide post-launch support?",
    answer:
      "Yes. Ongoing support can be arranged for bug fixes, updates, monitoring, improvements and additional development after launch.",
  },
];

const capabilities = [
  {
    number: "01",
    title: "Business Logic",
    text: "Turn real business rules and workflows into reliable application functionality.",
  },
  {
    number: "02",
    title: "Dashboards",
    text: "Create role-specific dashboards for operations, customers, data and reporting.",
  },
  {
    number: "03",
    title: "Authentication",
    text: "Implement login, protected routes, user roles and permission-based access.",
  },
  {
    number: "04",
    title: "Database Systems",
    text: "Structure application data around your entities, relationships and workflows.",
  },
  {
    number: "05",
    title: "API Development",
    text: "Build and connect APIs so your application can communicate with other systems.",
  },
  {
    number: "06",
    title: "Integrations",
    text: "Connect payments, storage, communication tools and other third-party services.",
  },
];

const applicationTypes = [
  {
    title: "SaaS Products",
    text: "Account-based software designed around a recurring customer problem.",
  },
  {
    title: "Business Dashboards",
    text: "Private workspaces for managing operations, data and performance.",
  },
  {
    title: "Customer Portals",
    text: "Secure areas where customers can access services, information or documents.",
  },
  {
    title: "Management Systems",
    text: "Digital workflows that replace repetitive manual processes.",
  },
  {
    title: "Booking Platforms",
    text: "Systems for managing services, availability, customers and appointments.",
  },
  {
    title: "Custom Platforms",
    text: "Product-specific applications where generic software is not enough.",
  },
];

const stack = [
  "Next.js",
  "React",
  "JavaScript",
  "Node.js",
  "Express",
  "MongoDB",
  "PostgreSQL",
  "MySQL",
  "Tailwind CSS",
  "REST APIs",
  "Git",
  "Cloudinary",
  "Razorpay",
];

const process = [
  {
    number: "01",
    title: "Discovery",
    text: "Understand the business, users and core problem.",
  },
  {
    number: "02",
    title: "Architecture",
    text: "Define workflows, data, integrations and technical structure.",
  },
  {
    number: "03",
    title: "Development",
    text: "Build the core product in focused, testable increments.",
  },
  {
    number: "04",
    title: "Testing",
    text: "Validate workflows, responsive behaviour and critical states.",
  },
  {
    number: "05",
    title: "Launch",
    text: "Deploy the application and prepare the foundation for iteration.",
  },
];

const iconPaths = {
  arrow: `<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>`,
  check: `<path d="m5 12 4 4L19 6"></path>`,
  layers: `<path d="m12 2 9 5-9 5-9-5 9-5Z"></path><path d="m3 12 9 5 9-5"></path><path d="m3 17 9 5 9-5"></path>`,
  shield: `<path d="M12 3 20 6v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z"></path><path d="m9 12 2 2 4-4"></path>`,
  chart: `<path d="M4 19V5"></path><path d="M4 19h16"></path><path d="m7 15 3-4 3 2 5-7"></path>`,
  search: `<circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path>`,
  code: `<path d="m8 9-3 3 3 3"></path><path d="m16 9 3 3-3 3"></path><path d="m14 5-4 14"></path>`,
  user: `<circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path>`,
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "YNS Web Studio",
      url: siteUrl,
      description:
        "Custom web development company in Jaipur building full-stack web applications, dashboards, SaaS products, and customer portals.",
      areaServed: ["Jaipur", "Rajasthan", "India"],
      serviceType: "Custom Web Development",
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: "Custom Web Development",
      serviceType: "Custom Web Development",
      provider: {
        "@id": `${siteUrl}/#organization`,
      },
      areaServed: ["Jaipur", "Rajasthan", "India"],
      url: pageUrl,
      description:
        "Custom full-stack web application development for dashboards, SaaS products, customer portals, business workflows, APIs and database-driven platforms.",
      offers: {
        "@type": "Offer",
        priceCurrency: "INR",
        price: "100000",
      },
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: "Custom Web Development Company Jaipur | YNS Web Studio",
      isPartOf: {
        "@id": `${siteUrl}/#website`,
      },
      about: {
        "@id": `${pageUrl}#service`,
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: siteUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Services",
          item: `${siteUrl}/services`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Custom Web Development",
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="Custom Web Development Company Jaipur | YNS Web Studio"
  description="YNS Web Studio builds custom web applications in Jaipur and across India, including dashboards, SaaS products, customer portals, APIs, authentication and database systems."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta
      name="keywords"
      content="custom web development Jaipur, web application development Jaipur, SaaS development company Jaipur, full stack developer Jaipur, custom software development Jaipur"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Custom Web Development Company Jaipur | YNS Web Studio" />
    <meta
      property="og:description"
      content="Custom full-stack web applications built around your business workflows, users, data and integrations."
    />
    <meta property="og:url" content={pageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Custom Web Development Company Jaipur | YNS Web Studio" />
    <meta
      name="twitter:description"
      content="Custom web application development for dashboards, SaaS products, customer portals and business systems."
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="business-page">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>

      <div class="container hero-container">

        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/services">Services</a>
          <span>/</span>
          <span aria-current="page">Custom Web Development</span>
        </nav>

        <div class="hero-layout">

          <div class="hero-copy">

            <div class="eyebrow">
              <span class="eyebrow-dot"></span>
              Custom Web Development Company in Jaipur
            </div>

            <h1>
              Build software around
              <em>the way your business works.</em>
            </h1>

            <p class="hero-description">
              We build custom web applications for businesses and startups in Jaipur and across India. From internal dashboards and customer portals to SaaS products and API-driven platforms, we turn complex workflows into practical digital systems.
            </p>

            <div class="hero-actions">
              <a
                href="https://wa.me/919352563337"
                target="_blank"
                rel="noopener noreferrer"
                class="button button-primary"
              >
                Discuss Your Application
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.arrow}></g>
                </svg>
              </a>

              <a href="#capabilities" class="button button-secondary">
                Explore capabilities
              </a>
            </div>

            <div class="hero-stats">
              <div>
                <strong>₹1L+</strong>
                <span>Starting investment</span>
              </div>
              <div>
                <strong>4–10</strong>
                <span>Typical weeks</span>
              </div>
              <div>
                <strong>100%</strong>
                <span>Full-stack custom</span>
              </div>
            </div>

          </div>

          <!-- APP PREVIEW -->
          <div class="hero-visual">

            <div class="visual-label visual-label-top">
              <span></span>
              DATABASE-POWERED WORKFLOWS
            </div>

            <div class="browser-window">

              <div class="browser-top">
                <div class="browser-controls">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <div class="browser-url">
                  <span class="lock">⌁</span>
                  app.yourbusiness.com / dashboard
                </div>

                <div class="browser-menu">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>

              <div class="website-preview">

                <div class="preview-nav">
                  <div class="preview-brand">
                    <span class="brand-mark">Y</span>
                    <span>APP WORKSPACE</span>
                  </div>

                  <div class="preview-links">
                    <span>Analytics</span>
                    <span>Users</span>
                    <span>Database</span>
                  </div>

                  <div class="preview-nav-button">Admin v2.4</div>
                </div>

                <div class="preview-hero">
                  <div class="preview-hero-copy">
                    <span class="mini-label">REALTIME METRICS</span>

                    <div class="preview-heading">
                      System logic.
                      <br />
                      Secure auth.
                      <br />
                      <i>Scalable DB.</i>
                    </div>

                    <div class="preview-lines">
                      <span></span>
                      <span></span>
                    </div>

                    <div class="preview-cta-row">
                      <span class="preview-button"></span>
                      <span class="preview-link"></span>
                    </div>
                  </div>

                  <div class="preview-visual-card">
                    <div class="visual-card-shape shape-one"></div>
                    <div class="visual-card-shape shape-two"></div>
                    <div class="visual-card-inner">
                      <span>API</span>
                      <strong>CONNECTED</strong>
                    </div>
                  </div>
                </div>

                <div class="preview-bottom">
                  <div>
                    <span>01</span>
                    <small>Auth & Roles</small>
                  </div>
                  <div>
                    <span>02</span>
                    <small>Custom Logic</small>
                  </div>
                  <div>
                    <span>03</span>
                    <small>REST / GraphQL</small>
                  </div>
                </div>

              </div>
            </div>

            <div class="floating-card floating-card-one">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.code}></g>
                </svg>
              </span>
              <div>
                <strong>Full-Stack Architecture</strong>
                <small>React, Node & DB</small>
              </div>
            </div>

            <div class="floating-card floating-card-two">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.shield}></g>
                </svg>
              </span>
              <div>
                <strong>Secure Endpoints</strong>
                <small>Protected routes & RBAC</small>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="intro-section">
      <div class="container">
        <div class="intro-grid">

          <div class="section-number">01</div>

          <div class="intro-content">
            <p class="section-kicker">When standard software is not enough</p>

            <h2>
              Your workflow should shape
              <span>the software.</span>
            </h2>

            <div class="intro-text-grid">
              <p>
                Many businesses eventually outgrow spreadsheets, disconnected tools and generic software. A custom web application brings users, data and workflows into one system designed around the way the business actually operates.
              </p>

              <p>
                We approach custom development as both a product and engineering problem: understand the workflow, define the architecture, build the core experience and create a foundation that can evolve as the business grows.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- WHAT WE BUILD -->
    <section class="benefits-section" id="capabilities">
      <div class="container">

        <div class="section-heading split-heading">
          <div>
            <p class="section-kicker">What we build</p>
            <h2>Full-stack development around<br /><span>your requirements.</span></h2>
          </div>

          <p>
            From the interface your users see to the data and logic behind it, we can build the core layers required by your custom web application.
          </p>
        </div>

        <div class="benefit-grid">
          {
            capabilities.map((item) => (
              <article class="benefit-card">
                <div class="card-number">{item.number}</div>

                <div class="card-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.code}></g>
                  </svg>
                </div>

                <h3>{item.title}</h3>
                <p>{item.text}</p>

                <span class="card-arrow">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.arrow}></g>
                  </svg>
                </span>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- APPLICATION TYPES -->
    <section class="pages-section">
      <div class="container">

        <div class="pages-header">
          <div>
            <p class="section-kicker">Application types</p>
            <h2>
              What can a custom web application
              <span>replace or improve?</span>
            </h2>
          </div>

          <p>
            Tailored software built to solve specific operational roadblocks or power brand new digital products.
          </p>
        </div>

        <div class="page-grid">
          {
            applicationTypes.map((app, index) => (
              <article class="page-card">
                <div class="page-card-top">
                  <span>0{index + 1}</span>

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.layers}></g>
                  </svg>
                </div>

                <h3>{app.title}</h3>
                <p>{app.text}</p>

                <div class="page-line"></div>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- TECH STACK -->
    <section class="included-section">
      <div class="container">

        <div class="included-layout">

          <div class="included-intro">
            <div class="dark-kicker">
              <span></span>
              Technology stack
            </div>

            <h2>
              Modern full-stack
              <span>development tools.</span>
            </h2>

            <p>
              We select technologies based on product requirements, integrations and expected maintenance needs rather than forcing every project into one architecture.
            </p>

            <a
              href="https://wa.me/919352563337"
              target="_blank"
              rel="noopener noreferrer"
              class="dark-button"
            >
              Discuss technical stack
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.arrow}></g>
              </svg>
            </a>
          </div>

          <div class="feature-list">
            {
              stack.map((technology, index) => (
                <div class="feature-item">
                  <span class="feature-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="feature-check">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <g set:html={iconPaths.check}></g>
                    </svg>
                  </span>

                  <span>{technology}</span>
                </div>
              ))
            }
          </div>

        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="process-section">
      <div class="container">

        <div class="process-header">
          <p class="section-kicker">Development process</p>

          <h2>
            Reduce risk by solving
            <span>the right problem first.</span>
          </h2>

          <p>
            Custom software works best when the scope is clear before implementation begins.
          </p>
        </div>

        <div class="process-grid">
          {
            process.map((step, index) => (
              <article class="process-card">
                <div class="process-top">
                  <span>{step.number}</span>

                  {index < process.length - 1 && (
                    <div class="process-connector"></div>
                  )}
                </div>

                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- PRICING -->
    <section class="pricing-section">
      <div class="container">

        <div class="pricing-layout">

          <div class="pricing-copy">
            <p class="dark-kicker">
              <span></span>
              Investment
            </p>

            <h2>
              Custom development starts at
              <strong>₹1,00,000+</strong>
            </h2>

            <p>
              The final quote depends on functionality, user roles, integrations, database architecture, design requirements and project complexity.
            </p>

            <div class="pricing-note">
              <span class="pricing-note-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.shield}></g>
                </svg>
              </span>

              <div>
                <strong>Transparent scoping</strong>
                <span>
                  You receive a detailed technical scope and milestone plan before building starts.
                </span>
              </div>
            </div>
          </div>

          <div class="pricing-panel">

            <div class="pricing-option featured-price">
              <div>
                <span class="pricing-label">Custom web application</span>
                <strong>₹1,00,000+</strong>
                <p>Full-stack portal, dashboard or SaaS MVP.</p>
              </div>

              <span class="pricing-badge">Starting</span>
            </div>

            <div class="pricing-option">
              <div>
                <span class="pricing-label">Enterprise Product</span>
                <strong>Custom quote</strong>
                <p>Complex business logic, multi-tenant DB & high scale.</p>
              </div>
            </div>

            <div class="pricing-option">
              <div>
                <span class="pricing-label">Ongoing iteration</span>
                <strong>Custom</strong>
                <p>Post-launch feature development and support.</p>
              </div>
            </div>

            <a
              href="https://wa.me/919352563337"
              target="_blank"
              rel="noopener noreferrer"
              class="pricing-button"
            >
              Get a Project Estimate
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.arrow}></g>
              </svg>
            </a>

          </div>

        </div>

      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="faq-section">
      <div class="container faq-container">

        <div class="faq-heading">
          <p class="section-kicker">FAQ</p>

          <h2>
            Custom web development
            <span>questions.</span>
          </h2>

          <p>
            Everything you should know before starting your custom software project.
          </p>
        </div>

        <div class="faq-list">
          {
            faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>
                  <span class="faq-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="faq-question">{faq.question}</span>

                  <span class="faq-toggle">
                    <span></span>
                    <span></span>
                  </span>
                </summary>

                <div class="faq-answer">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))
          }
        </div>

      </div>
    </section>

    <!-- RELATED SERVICES -->
    <section class="related-section">
      <div class="container">

        <div class="related-header">
          <div>
            <p class="section-kicker">Explore more</p>
            <h2>Looking for a different type of web project?</h2>
          </div>

          <a href="/services" class="text-link">
            View all services
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <g set:html={iconPaths.arrow}></g>
            </svg>
          </a>
        </div>

        <div class="related-grid">

          <a href="/services/nextjs-development" class="related-card">
            <span>01</span>
            <h3>Next.js Development</h3>
            <p>High-performance React and Next.js web applications.</p>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <g set:html={iconPaths.arrow}></g>
            </svg>
          </a>

          <a href="/services/ecommerce-development" class="related-card">
            <span>02</span>
            <h3>E-Commerce Development</h3>
            <p>Custom online stores built with Shopify Storefront API.</p>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <g set:html={iconPaths.arrow}></g>
            </svg>
          </a>

          <a href="/services/business-website-development" class="related-card">
            <span>03</span>
            <h3>Business Websites</h3>
            <p>Professional websites for company credibility and leads.</p>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <g set:html={iconPaths.arrow}></g>
            </svg>
          </a>

          <a href="/services/booking-appointment-websites" class="related-card">
            <span>04</span>
            <h3>Booking Websites</h3>
            <p>Automated scheduling and appointment booking systems.</p>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <g set:html={iconPaths.arrow}></g>
            </svg>
          </a>

        </div>

      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="final-cta-section">
      <div class="container">

        <div class="final-cta">

          <div class="cta-grid"></div>
          <div class="cta-glow"></div>

          <div class="cta-content">
            <div class="dark-kicker">
              <span></span>
              Have a custom idea?
            </div>

            <h2>
              Let's turn the workflow
              <span>into software.</span>
            </h2>

            <p>
              Share what you are trying to build, who will use it and what the application needs to do. We can define the right technical scope from there.
            </p>

            <div class="cta-actions">
              <a
                href="https://wa.me/919352563337"
                target="_blank"
                rel="noopener noreferrer"
                class="cta-primary"
              >
                Start a Conversation
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.arrow}></g>
                </svg>
              </a>

