---
import BaseLayout from "../../components/layout/BaseLayout.astro";

const siteUrl = "https://ynsweb.studio";
const pageUrl = "https://ynsweb.studio/services/landing-page-development";

const features = [
  {
    title: "Conversion-Focused Structure",
    text: "Every section is planned around one clear objective: turning visitors into enquiries, leads, bookings or customers.",
  },
  {
    title: "Strong Above-the-Fold",
    text: "Clear messaging, focused calls-to-action and visual hierarchy help visitors understand your offer within seconds.",
  },
  {
    title: "Responsive Design",
    text: "Pixel-clean layouts across mobile, tablet and desktop so your landing page works wherever your traffic comes from.",
  },
  {
    title: "Lead Capture",
    text: "Connect forms, WhatsApp, calls, email and other conversion points so interested visitors have an easy next step.",
  },
  {
    title: "Speed & Performance",
    text: "Lightweight implementation and optimized assets help reduce friction and improve the user experience.",
  },
  {
    title: "SEO-Ready Foundation",
    text: "Clean structure, metadata, headings and semantic content provide a strong technical foundation for search visibility.",
  },
];

const useCases = [
  "Google Ads Landing Pages",
  "Meta Ads Campaigns",
  "Product Launches",
  "Service Promotions",
  "Lead Generation",
  "Event Registrations",
  "Real Estate Campaigns",
  "Local Business Offers",
  "SaaS & Startup Products",
  "Personal Brands",
];

const process = [
  {
    number: "01",
    title: "Understand the Offer",
    text: "We identify your audience, offer, differentiator, campaign goal and the action you want visitors to take.",
  },
  {
    number: "02",
    title: "Plan the Journey",
    text: "We structure the page from hook and proof to benefits, objections, CTA and conversion.",
  },
  {
    number: "03",
    title: "Design",
    text: "We create a focused visual system with strong hierarchy, responsive layouts and clear calls-to-action.",
  },
  {
    number: "04",
    title: "Develop",
    text: "We turn the design into a fast, responsive and maintainable landing page.",
  },
  {
    number: "05",
    title: "Optimize",
    text: "We check mobile usability, performance, forms, links, metadata and conversion friction.",
  },
  {
    number: "06",
    title: "Launch",
    text: "We deploy the page and connect the required enquiry, analytics and campaign tools.",
  },
];

const faqs = [
  {
    question: "How much does a landing page cost?",
    answer:
      "Landing page development at YNS Web Studio starts from ₹12,000. The final price depends on the page complexity, copy requirements, animations, integrations and number of sections.",
  },
  {
    question: "How long does it take to build a landing page?",
    answer:
      "A focused landing page typically takes around 3–5 days once the required content, branding assets and project requirements are available.",
  },
  {
    question: "Can you build a landing page for Google or Meta Ads?",
    answer:
      "Yes. We can structure landing pages specifically around paid campaigns, with focused messaging, conversion sections, forms and tracking requirements.",
  },
  {
    question: "Can you add WhatsApp, forms and call buttons?",
    answer:
      "Yes. WhatsApp, click-to-call, enquiry forms, email CTAs and other conversion actions can be integrated based on your campaign.",
  },
  {
    question: "Will the landing page be mobile responsive?",
    answer:
      "Yes. Every landing page is designed to work across mobile, tablet and desktop screen sizes.",
  },
  {
    question: "Can you write the landing page copy?",
    answer:
      "Copywriting can be included as an additional service. We can also work with your existing copy and restructure it for clarity and conversion.",
  },
  {
    question: "Can the page be connected to analytics?",
    answer:
      "Yes. Analytics and campaign tracking can be connected depending on the platforms and tracking setup required.",
  },
  {
    question: "Can you create multiple campaign landing pages?",
    answer:
      "Yes. We can build a landing page system with multiple campaign-specific pages while keeping the same brand and design language.",
  },
];

const relatedServices = [
  { title: "Business Website Development", href: "/services/business-website-development" },
  { title: "E-Commerce Website Development", href: "/services/ecommerce-development" },
  { title: "Next.js Development", href: "/services/nextjs-development" },
  { title: "Custom Web Development", href: "/services/custom-web-development" },
];

const technologies = [
  "Astro",
  "Next.js",
  "React",
  "JavaScript",
  "Tailwind CSS",
  "HTML",
  "CSS",
  "Node.js",
  "Express",
  "Analytics",
  "WhatsApp",
];

const iconPaths = {
  arrow: `<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>`,
  check: `<path d="m5 12 4 4L19 6"></path>`,
  layers: `<path d="m12 2 9 5-9 5-9-5 9-5Z"></path><path d="m3 12 9 5 9-5"></path><path d="m3 17 9 5 9-5"></path>`,
  shield: `<path d="M12 3 20 6v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z"></path><path d="m9 12 2 2 4-4"></path>`,
  chart: `<path d="M4 19V5"></path><path d="M4 19h16"></path><path d="m7 15 3-4 3 2 5-7"></path>`,
  search: `<circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path>`,
  zap: `<path d="m13 2-9 12h7l-1 8 9-12h-7l1-8Z"></path>`,
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "YNS Web Studio",
      url: siteUrl,
      description:
        "Landing page development company in Jaipur building high-converting campaign pages for Google Ads, Meta Ads and lead generation.",
      areaServed: ["Jaipur", "Rajasthan", "India"],
      serviceType: "Landing Page Development",
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: "Landing Page Development",
      serviceType: "Landing Page Development",
      provider: {
        "@id": `${siteUrl}/#organization`,
      },
      areaServed: ["Jaipur", "Rajasthan", "India"],
      url: pageUrl,
      description:
        "Conversion-focused landing page development services for ads, campaigns, launches and lead generation by YNS Web Studio.",
      offers: {
        "@type": "Offer",
        priceCurrency: "INR",
        price: "12000",
      },
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: "Landing Page Development Company Jaipur | YNS Web Studio",
      isPartOf: {
        "@id": `${siteUrl}/#website`,
      },
      about: {
        "@id": `${pageUrl}#service`,
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: siteUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Services",
          item: `${siteUrl}/services`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Landing Page Development",
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="Landing Page Development Company Jaipur | YNS Web Studio"
  description="YNS Web Studio builds high-converting landing pages in Jaipur for Google Ads, Meta Ads, lead generation, product launches and service campaigns with responsive design, fast performance and clear CTAs."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta
      name="keywords"
      content="landing page development Jaipur, landing page design company Jaipur, PPC landing page design, Google Ads landing page Jaipur, lead generation landing page development"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Landing Page Development Company Jaipur | YNS Web Studio" />
    <meta
      property="og:description"
      content="High-converting landing pages for ads, campaigns, launches and lead generation."
    />
    <meta property="og:url" content={pageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Landing Page Development Company Jaipur | YNS Web Studio" />
    <meta
      name="twitter:description"
      content="High-converting landing pages for ads, campaigns, launches and lead generation."
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="business-page">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>

      <div class="container hero-container">

        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/services">Services</a>
          <span>/</span>
          <span aria-current="page">Landing Page Development</span>
        </nav>

        <div class="hero-layout">

          <div class="hero-copy">

            <div class="eyebrow">
              <span class="eyebrow-dot"></span>
              Landing Page Development in Jaipur
            </div>

            <h1>
              Turn campaign
              <em>traffic into action.</em>
            </h1>

            <p class="hero-description">
              High-performance landing pages for ads, campaigns, launches and lead generation — built around one clear offer and one clear next step.
            </p>

            <div class="hero-actions">
              <a
                href="https://wa.me/919352563337"
                target="_blank"
                rel="noopener noreferrer"
                class="button button-primary"
              >
                Build My Landing Page
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.arrow}></g>
                </svg>
              </a>

              <a href="#features" class="button button-secondary">
                Explore features
              </a>
            </div>

            <div class="hero-stats">
              <div>
                <strong>₹12K+</strong>
                <span>Starting investment</span>
              </div>
              <div>
                <strong>3–5</strong>
                <span>Typical days</span>
              </div>
              <div>
                <strong>100%</strong>
                <span>Conversion focused</span>
              </div>
            </div>

          </div>

          <!-- WEBSITE PREVIEW -->
          <div class="hero-visual">

            <div class="visual-label visual-label-top">
              <span></span>
              HIGH-CONVERSION CAMPAIGN PAGE
            </div>

            <div class="browser-window">

              <div class="browser-top">
                <div class="browser-controls">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <div class="browser-url">
                  <span class="lock">⌁</span>
                  yourcampaign.com
                </div>

                <div class="browser-menu">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>

              <div class="website-preview">

                <div class="preview-nav">
                  <div class="preview-brand">
                    <span class="brand-mark">Y</span>
                    <span>CAMPAIGN BRAND</span>
                  </div>

                  <div class="preview-links">
                    <span>Offer</span>
                    <span>Benefits</span>
                    <span>Contact</span>
                  </div>

                  <div class="preview-nav-button">Get Started</div>
                </div>

                <div class="preview-hero">
                  <div class="preview-hero-copy">
                    <span class="mini-label">LIMITED CAMPAIGN</span>

                    <div class="preview-heading">
                      A better way to
                      <br />
                      <i>get started.</i>
                    </div>

                    <div class="preview-lines">
                      <span></span>
                      <span></span>
                    </div>

                    <div class="preview-cta-row">
                      <span class="preview-button"></span>
                      <span class="preview-link"></span>
                    </div>
                  </div>

                  <div class="preview-visual-card">
                    <div class="visual-card-shape shape-one"></div>
                    <div class="visual-card-shape shape-two"></div>
                    <div class="visual-card-inner">
                      <span>01</span>
                      <strong>LEAD GEN</strong>
                    </div>
                  </div>
                </div>

                <div class="preview-bottom">
                  <div>
                    <span>01</span>
                    <small>Clear offer</small>
                  </div>
                  <div>
                    <span>02</span>
                    <small>Strong proof</small>
                  </div>
                  <div>
                    <span>03</span>
                    <small>Easy action</small>
                  </div>
                </div>

              </div>
            </div>

            <div class="floating-card floating-card-one">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.chart}></g>
                </svg>
              </span>
              <div>
                <strong>Built for conversion</strong>
                <small>Focused user journey</small>
              </div>
            </div>

            <div class="floating-card floating-card-two">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.zap}></g>
                </svg>
              </span>
              <div>
                <strong>Mobile optimized</strong>
                <small>Fast & responsive</small>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="intro-section">
      <div class="container">
        <div class="intro-grid">

          <div class="section-number">01</div>

          <div class="intro-content">
            <p class="section-kicker">Built for conversion</p>

            <h2>
              A landing page should have
              <span>one job.</span>
            </h2>

            <div class="intro-text-grid">
              <p>
                A landing page is different from a normal website. Instead of sending visitors in multiple directions, it focuses their attention on one offer, one audience and one primary action.
              </p>

              <p>
                We design the page around your campaign goal — whether that means generating leads, getting WhatsApp enquiries, collecting registrations, selling a product or booking a consultation.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section id="features" class="benefits-section">
      <div class="container">

        <div class="section-heading split-heading">
          <div>
            <p class="section-kicker">What you get</p>
            <h2>Everything needed for a<br /><span>focused campaign page.</span></h2>
          </div>

          <p>
            Less distraction. Better hierarchy. A clearer path from first impression to conversion.
          </p>
        </div>

        <div class="benefit-grid">
          {
            features.map((item, index) => (
              <article class="benefit-card">
                <div class="card-number">0{index + 1}</div>

                <div class="card-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g
                      set:html={
                        [
                          iconPaths.chart,
                          iconPaths.search,
                          iconPaths.shield,
                          iconPaths.layers,
                          iconPaths.zap,
                          iconPaths.check,
                        ][index]
                      }
                    ></g>
                  </svg>
                </div>

                <h3>{item.title}</h3>
                <p>{item.text}</p>

                <span class="card-arrow">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.arrow}></g>
                  </svg>
                </span>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- CONVERSION ARCHITECTURE -->
    <section class="pages-section">
      <div class="container">

        <div class="pages-header">
          <div>
            <p class="section-kicker">Conversion architecture</p>
            <h2>
              The page structure follows the
              <span>decision-making process.</span>
            </h2>
          </div>

          <p>
            We remove unnecessary navigation and organize information in the order visitors need it: understand the offer, believe it, overcome objections and take action.
          </p>
        </div>

        <div class="page-grid">
          {[
            { number: "01", title: "Attention", text: "Headline, visual and value proposition" },
            { number: "02", title: "Understanding", text: "Benefits, features and offer details" },
            { number: "03", title: "Trust", text: "Proof, results, testimonials or credibility" },
            { number: "04", title: "Objections", text: "Answers to common concerns and FAQs" },
            { number: "05", title: "Action", text: "Focused CTA, form, WhatsApp or booking flow" },
            { number: "06", title: "Follow-up", text: "Post-conversion confirmation and next steps" },
          ].map((item) => (
            <article class="page-card">
              <div class="page-card-top">
                <span>{item.number}</span>

                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.arrow}></g>
                </svg>
              </div>

              <h3>{item.title}</h3>
              <p>{item.text}</p>

              <div class="page-line"></div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- USE CASES -->
    <section class="usecases-section">
      <div class="container">

        <div class="usecases-layout">

          <div class="usecases-copy">
            <p class="section-kicker">Use cases</p>

            <h2>
              One landing page.
              <span>Many campaign goals.</span>
            </h2>

            <p>
              Tailored campaign pages built specifically to maximize ROAS on paid acquisition or drive maximum conversion on specific product launches.
            </p>

            <div class="mini-stat">
              <strong>Campaign ready.</strong>
              <span>Designed for Google Ads, Meta Ads and targeted traffic.</span>
            </div>
          </div>

          <div class="usecase-list">
            {
              useCases.map((item, index) => (
                <div class="usecase-item">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{item}</strong>

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.arrow}></g>
                  </svg>
                </div>
              ))
            }
          </div>

        </div>

      </div>
    </section>

    <!-- PERFORMANCE & SEO -->
    <section class="capabilities-section">
      <div class="container">

        <div class="capabilities-heading">
          <p class="section-kicker">Performance & SEO</p>
          <h2>
            Fast pages create
            <span>less friction.</span>
          </h2>
        </div>

        <div class="capability-grid">

          <article class="capability-card capability-featured">
            <div class="capability-number">01</div>

            <div class="capability-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.zap}></g>
              </svg>
            </div>

            <h3>Speed & Responsiveness</h3>

            <p>
              Optimized images, lightweight code and responsive layouts keep the experience smooth and lightning-fast across mobile, tablet and desktop.
            </p>

            <div class="capability-tags">
              <span>Fast</span>
              <span>Responsive</span>
              <span>Optimized</span>
            </div>
          </article>

          <article class="capability-card">
            <div class="capability-number">02</div>

            <div class="capability-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.search}></g>
              </svg>
            </div>

            <h3>Technical Foundation</h3>

            <p>
              Semantic headings, clean structure, metadata support and clean URLs provide a solid technical foundation for search visibility.
            </p>

            <div class="capability-tags">
              <span>SEO-Ready</span>
              <span>Metadata</span>
              <span>Semantic</span>
            </div>
          </article>

          <article class="capability-card">
            <div class="capability-number">03</div>

            <div class="capability-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.chart}></g>
              </svg>
            </div>

            <h3>Analytics & Tracking</h3>

            <p>
              Campaign tracking and analytics can be connected so you can accurately measure visits, engagement and campaign conversions.
            </p>

            <div class="capability-tags">
              <span>Pixels</span>
              <span>Analytics</span>
              <span>Tracking</span>
            </div>
          </article>

        </div>

      </div>
    </section>

    <!-- TECHNOLOGY -->
    <section class="included-section">
      <div class="container">

        <div class="included-layout">

          <div class="included-intro">
            <div class="dark-kicker">
              <span></span>
              Technology stack
            </div>

            <h2>
              Modern stack.
              <span>Clean implementation.</span>
            </h2>

            <p>
              We choose the implementation according to the project — not the other way around, ensuring maximum performance and easy maintenance.
            </p>

            <a
              href="https://wa.me/919352563337"
              target="_blank"
              rel="noopener noreferrer"
              class="dark-button"
            >
              Discuss technical stack
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.arrow}></g>
              </svg>
            </a>
          </div>

          <div class="feature-list">
            {
              technologies.map((tech, index) => (
                <div class="feature-item">
                  <span class="feature-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="feature-check">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <g set:html={iconPaths.check}></g>
                    </svg>
                  </span>

                  <span>{tech}</span>
                </div>
              ))
            }
          </div>

        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="process-section">
      <div class="container">

        <div class="process-header">
          <p class="section-kicker">Our process</p>

          <h2>
            From campaign brief
            <span>to live page.</span>
          </h2>

          <p>
            A streamlined workflow ensures your landing page is planned, designed, tested and deployed quickly.
          </p>
        </div>

        <div class="process-grid">
          {
            process.map((step, index) => (
              <article class="process-card">
                <div class="process-top">
                  <span>{step.number}</span>

                  {index < process.length - 1 && (
                    <div class="process-connector"></div>
                  )}
                </div>

                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- PRICING -->
    <section class="pricing-section">
      <div class="container">

        <div class="pricing-layout">

          <div class="pricing-copy">
            <p class="dark-kicker">
              <span></span>
              Starting investment
            </p>

            <h2>
              Landing pages from
              <strong>₹12,000+</strong>
            </h2>

            <p>
              A typical project includes a responsive landing page, conversion-focused sections, CTA integration, basic SEO setup and deployment. Advanced animation, copywriting, tracking and custom integrations can be scoped separately.
            </p>

            <div class="pricing-note">
              <span class="pricing-note-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.shield}></g>
                </svg>
              </span>

              <div>
                <strong>Transparent scoping</strong>
                <span>
                  Receive a clear quote and timeline before development begins.
                </span>
              </div>
            </div>
          </div>

          <div class="pricing-panel">

            <div class="pricing-option featured-price">
              <div>
                <span class="pricing-label">Landing Page</span>
                <strong>₹12,000+</strong>
                <p>High-conversion campaign page with responsive layout.</p>
              </div>

              <span class="pricing-badge">Starting</span>
            </div>

            <div class="pricing-option">
              <div>
                <span class="pricing-label">Multi-Page Campaign System</span>
                <strong>Custom quote</strong>
                <p>Multiple variant pages for A/B testing or ad groups.</p>
              </div>
            </div>

            <div class="pricing-option">
              <div>
                <span class="pricing-label">Copywriting & Optimization</span>
                <strong>Custom</strong>
                <p>Conversion copywriting and tracking integration.</p>
              </div>
            </div>

            <a
              href="https://wa.me/919352563337"
              target="_blank"
              rel="noopener noreferrer"
              class="pricing-button"
            >
              Get a Quote
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.arrow}></g>
              </svg>
            </a>

          </div>

