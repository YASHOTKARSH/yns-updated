---
import BaseLayout from "../../components/layout/BaseLayout.astro";

const siteUrl = "https://ynsweb.studio";
const pageUrl = "https://ynsweb.studio/services/ecommerce-development";

const faqs = [
  {
    question: "How much does an e-commerce website cost in Jaipur?",
    answer:
      "E-commerce website development at YNS Web Studio starts from ₹60,000. The final investment depends on product count, design complexity, payment gateway, shipping, customer accounts, admin workflows, integrations and custom functionality.",
  },
  {
    question: "How long does it take to build an e-commerce website?",
    answer:
      "A standard e-commerce website generally takes around 3–5 weeks. Larger stores with custom workflows, integrations or extensive product architecture may require additional development time.",
  },
  {
    question: "Can you integrate Razorpay or other payment gateways?",
    answer:
      "Yes. We can integrate payment gateways such as Razorpay and connect the checkout experience with the required order and payment workflows.",
  },
  {
    question: "Can you build a custom e-commerce website instead of using a ready-made theme?",
    answer:
      "Yes. YNS Web Studio builds custom e-commerce experiences around your brand, products and business requirements instead of forcing your store into a generic template.",
  },
  {
    question: "Will my e-commerce website be mobile-friendly?",
    answer:
      "Yes. Every store is designed and developed with a mobile-first approach so product discovery, cart and checkout remain easy to use across phones, tablets and desktops.",
  },
  {
    question: "Do you provide SEO for e-commerce websites?",
    answer:
      "Every e-commerce build includes a technical SEO foundation such as crawlable architecture, semantic markup, metadata support, responsive implementation, performance-conscious development and search-friendly product structures. Ongoing SEO campaigns are available separately.",
  },
  {
    question: "Can you connect WhatsApp, analytics and other tools?",
    answer:
      "Yes. We can integrate WhatsApp, Google Analytics, Search Console, marketing tools, APIs and other business systems when they fit the project requirements.",
  },
];

const features = [
  {
    title: "Product Architecture",
    text: "Structured product, category, collection and variant experiences designed for easy browsing and future growth.",
    icon: "box",
  },
  {
    title: "Search & Filters",
    text: "Help customers find products faster with practical search, sorting, filtering and category navigation.",
    icon: "search",
  },
  {
    title: "Cart & Checkout",
    text: "A focused purchasing flow designed to reduce friction between product discovery and completed orders.",
    icon: "cart",
  },
  {
    title: "Payment Integration",
    text: "Connect your preferred payment gateway and build a reliable order and payment experience.",
    icon: "card",
  },
  {
    title: "Order Workflows",
    text: "Create clear order states and customer-facing flows that support your day-to-day operations.",
    icon: "package",
  },
  {
    title: "SEO-Ready Structure",
    text: "Build product and category pages with a technical foundation that supports organic search visibility.",
    icon: "globe",
  },
];

const journey = [
  {
    number: "01",
    title: "Discover",
    text: "Clear navigation, categories and search help customers find the right products quickly.",
  },
  {
    number: "02",
    title: "Evaluate",
    text: "Product details, imagery, variants, pricing and trust signals answer buying questions.",
  },
  {
    number: "03",
    title: "Decide",
    text: "Focused calls to action and a friction-free cart make the next step obvious.",
  },
  {
    number: "04",
    title: "Checkout",
    text: "A simple, mobile-friendly checkout reduces unnecessary abandonment.",
  },
  {
    number: "05",
    title: "Pay",
    text: "Payment gateway integration connects the order to the required transaction workflow.",
  },
  {
    number: "06",
    title: "Return",
    text: "Useful order communication and a strong post-purchase experience support repeat business.",
  },
];

const audience = [
  {
    title: "D2C Brands",
    text: "Launch a polished store around your products and brand identity.",
  },
  {
    title: "Local Businesses",
    text: "Turn local demand into a professional online ordering experience.",
  },
  {
    title: "Growing Stores",
    text: "Improve an outdated store with better UX, performance and architecture.",
  },
  {
    title: "New Product Brands",
    text: "Create a scalable foundation for a growing catalogue and customer base.",
  },
];

const technologies = [
  "Next.js",
  "React",
  "JavaScript",
  "Node.js",
  "Express",
  "MongoDB",
  "PostgreSQL",
  "MySQL",
  "Tailwind CSS",
  "Razorpay",
  "REST APIs",
  "Cloudinary",
];

const process = [
  {
    number: "01",
    title: "Discover",
    text: "Understand your products, customers, competitors and business goals.",
  },
  {
    number: "02",
    title: "Plan",
    text: "Define information architecture, product structure, pages and required integrations.",
  },
  {
    number: "03",
    title: "Develop",
    text: "Build the storefront, commerce workflows, responsive UI and technical foundation.",
  },
  {
    number: "04",
    title: "Launch",
    text: "Test key flows, connect analytics, deploy and prepare the store for growth.",
  },
];

const iconPaths = {
  arrow: `<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>`,
  check: `<path d="m5 12 4 4L19 6"></path>`,
  box: `<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z" stroke-linejoin="round"></path><path d="m4.5 7.5 7.5 4 7.5-4M12 12v9" stroke-linecap="round"></path>`,
  search: `<circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4" stroke-linecap="round"></path>`,
  cart: `<path d="M4 5h2l1.5 9.5h9L19 8H7" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="9" cy="19" r="1.2"></circle><circle cx="17" cy="19" r="1.2"></circle>`,
  card: `<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 10h18"></path>`,
  package: `<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z" stroke-linejoin="round"></path><path d="m4.5 7.5 7.5 4 7.5-4M12 12v9" stroke-linecap="round"></path>`,
  globe: `<circle cx="12" cy="12" r="8.5"></circle><path d="M3.8 9h16.4M3.8 15h16.4M12 3.5c2.2 2.4 3.3 5.2 3.3 8.5S14.2 18.1 12 20.5c-2.2-2.4-3.3-5.2-3.3-8.5S9.8 5.9 12 3.5Z"></path>`,
  shield: `<path d="M12 3 20 6v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z"></path><path d="m9 12 2 2 4-4"></path>`,
  chart: `<path d="M4 19V5"></path><path d="M4 19h16"></path><path d="m7 15 3-4 3 2 5-7"></path>`,
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "YNS Web Studio",
      url: siteUrl,
      description:
        "E-commerce website development company in Jaipur building conversion-focused online stores with payment gateways and product architecture.",
      areaServed: ["Jaipur", "Rajasthan", "India"],
      serviceType: "E-Commerce Website Development",
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: "E-Commerce Website Development",
      serviceType: "E-Commerce Website Development",
      provider: {
        "@id": `${siteUrl}/#organization`,
      },
      areaServed: ["Jaipur", "Rajasthan", "India"],
      url: pageUrl,
      description:
        "Custom e-commerce website development with product architecture, search, filters, cart, checkout, payment integration, order workflows and SEO-ready development.",
      offers: {
        "@type": "Offer",
        priceCurrency: "INR",
        price: "60000",
      },
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: "E-Commerce Website Development Jaipur | YNS Web Studio",
      isPartOf: {
        "@id": `${siteUrl}/#website`,
      },
      about: {
        "@id": `${pageUrl}#service`,
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: siteUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Services",
          item: `${siteUrl}/services`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "E-Commerce Website Development",
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="E-Commerce Website Development Jaipur | YNS Web Studio"
  description="YNS Web Studio builds fast, conversion-focused e-commerce websites in Jaipur and across India with custom design, payment gateways, product architecture and SEO-ready pages."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta
      name="keywords"
      content="ecommerce website development Jaipur, online store design Jaipur, ecommerce web development company Jaipur, Shopify alternative development, custom ecommerce store Jaipur"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="E-Commerce Website Development Jaipur | YNS Web Studio" />
    <meta
      property="og:description"
      content="Custom e-commerce website development for brands that want a faster, better and more conversion-focused online store."
    />
    <meta property="og:url" content={pageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="E-Commerce Website Development Jaipur | YNS Web Studio" />
    <meta
      name="twitter:description"
      content="Custom e-commerce websites with product architecture, checkout, payment integration, SEO-ready development and scalable technology."
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="business-page">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>

      <div class="container hero-container">

        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/services">Services</a>
          <span>/</span>
          <span aria-current="page">E-Commerce Website Development</span>
        </nav>

        <div class="hero-layout">

          <div class="hero-copy">

            <div class="eyebrow">
              <span class="eyebrow-dot"></span>
              E-Commerce Website Development in Jaipur
            </div>

            <h1>
              Build an online store
              <em>designed to sell.</em>
            </h1>

            <p class="hero-description">
              We build custom e-commerce websites for growing brands in Jaipur and across India. From product discovery and search to cart, checkout, payments and SEO-ready product architecture, every part of your store is designed around the customer journey.
            </p>

            <div class="hero-actions">
              <a
                href="https://wa.me/919352563337"
                target="_blank"
                rel="noopener noreferrer"
                class="button button-primary"
              >
                Discuss Your Store
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.arrow}></g>
                </svg>
              </a>

              <a href="#features" class="button button-secondary">
                Explore store features
              </a>
            </div>

            <div class="hero-stats">
              <div>
                <strong>₹60K+</strong>
                <span>Starting investment</span>
              </div>
              <div>
                <strong>3–5</strong>
                <span>Typical weeks</span>
              </div>
              <div>
                <strong>100%</strong>
                <span>Conversion focused</span>
              </div>
            </div>

          </div>

          <!-- WEBSITE PREVIEW -->
          <div class="hero-visual">

            <div class="visual-label visual-label-top">
              <span></span>
              HIGH-CONVERSION STOREFRONT
            </div>

            <div class="browser-window">

              <div class="browser-top">
                <div class="browser-controls">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <div class="browser-url">
                  <span class="lock">⌁</span>
                  yourbrandstore.com
                </div>

                <div class="browser-menu">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>

              <div class="website-preview">

                <div class="preview-nav">
                  <div class="preview-brand">
                    <span class="brand-mark">Y</span>
                    <span>STOREFRONT</span>
                  </div>

                  <div class="preview-links">
                    <span>Shop</span>
                    <span>Collections</span>
                    <span>About</span>
                  </div>

                  <div class="preview-nav-button">Cart (1)</div>
                </div>

                <div class="preview-hero">
                  <div class="preview-hero-copy">
                    <span class="mini-label">NEW D2C COLLECTION</span>

                    <div class="preview-heading">
                      Seamless checkout.
                      <br />
                      Fast catalog.
                      <br />
                      <i>Optimized sales.</i>
                    </div>

                    <div class="preview-lines">
                      <span></span>
                      <span></span>
                    </div>

                    <div class="preview-cta-row">
                      <span class="preview-button"></span>
                      <span class="preview-link"></span>
                    </div>
                  </div>

                  <div class="preview-visual-card">
                    <div class="visual-card-shape shape-one"></div>
                    <div class="visual-card-shape shape-two"></div>
                    <div class="visual-card-inner">
                      <span>₹2,499</span>
                      <strong>IN STOCK</strong>
                    </div>
                  </div>
                </div>

                <div class="preview-bottom">
                  <div>
                    <span>01</span>
                    <small>Product Catalog</small>
                  </div>
                  <div>
                    <span>02</span>
                    <small>Razorpay Checkout</small>
                  </div>
                  <div>
                    <span>03</span>
                    <small>SEO Architecture</small>
                  </div>
                </div>

              </div>
            </div>

            <div class="floating-card floating-card-one">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.card}></g>
                </svg>
              </span>
              <div>
                <strong>Secure Payments</strong>
                <small>Razorpay integrated</small>
              </div>
            </div>

            <div class="floating-card floating-card-two">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.chart}></g>
                </svg>
              </span>
              <div>
                <strong>Conversion Ready</strong>
                <small>Friction-free funnel</small>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="intro-section">
      <div class="container">
        <div class="intro-grid">

          <div class="section-number">01</div>

          <div class="intro-content">
            <p class="section-kicker">More than a storefront</p>

            <h2>
              Your e-commerce website is
              <span>part of the sales process.</span>
            </h2>

            <div class="intro-text-grid">
              <p>
                A strong online store should make it easy for customers to understand your products, compare options, trust your brand and complete a purchase without unnecessary friction. That is why our e-commerce website development process combines user experience, responsive design, performance, technical SEO and business logic from the beginning.
              </p>

              <p>
                Whether you are launching a new D2C brand, moving beyond social-media sales or rebuilding an outdated store, we create an e-commerce experience that can grow with your catalogue and operations.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section id="features" class="benefits-section">
      <div class="container">

        <div class="section-heading split-heading">
          <div>
            <p class="section-kicker">What we build</p>
            <h2>Everything customers need to<br /><span>buy with confidence.</span></h2>
          </div>

          <p>
            A practical e-commerce foundation that balances customer experience with the functionality your business needs behind the scenes.
          </p>
        </div>

        <div class="benefit-grid">
          {
            features.map((item, index) => (
              <article class="benefit-card">
                <div class="card-number">0{index + 1}</div>

                <div class="card-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g
                      set:html={
                        [
                          iconPaths.box,
                          iconPaths.search,
                          iconPaths.cart,
                          iconPaths.card,
                          iconPaths.package,
                          iconPaths.globe,
                        ][index]
                      }
                    ></g>
                  </svg>
                </div>

                <h3>{item.title}</h3>
                <p>{item.text}</p>

                <span class="card-arrow">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.arrow}></g>
                  </svg>
                </span>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- CUSTOMER JOURNEY -->
    <section class="pages-section">
      <div class="container">

        <div class="pages-header">
          <div>
            <p class="section-kicker">Customer journey</p>
            <h2>
              From first click
              <span>to completed order.</span>
            </h2>
          </div>

          <p>
            Every important interaction has a job: communicate value, remove uncertainty and move the customer toward the next useful action.
          </p>
        </div>

        <div class="page-grid">
          {
            journey.map((step) => (
              <article class="page-card">
                <div class="page-card-top">
                  <span>{step.number}</span>

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.arrow}></g>
                  </svg>
                </div>

                <h3>{step.title}</h3>
                <p>{step.text}</p>

                <div class="page-line"></div>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- CAPABILITIES / SEO -->
    <section class="capabilities-section">
      <div class="container">

        <div class="capabilities-heading">
          <p class="section-kicker">Built for growth</p>
          <h2>
            An online store should be
            <span>discoverable, fast and easy to use.</span>
          </h2>
        </div>

        <div class="capability-grid">

          <article class="capability-card capability-featured">
            <div class="capability-number">01</div>

            <div class="capability-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.search}></g>
              </svg>
            </div>

            <h3>Technical SEO foundation</h3>

            <p>
              Semantic structure, metadata support, crawlable pages and search-friendly architecture give search engines clear visibility over your product catalogue.
            </p>

            <div class="capability-tags">
              <span>Metadata</span>
              <span>Crawlable</span>
              <span>Schema</span>
            </div>
          </article>

          <article class="capability-card">
            <div class="capability-number">02</div>

            <div class="capability-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.globe}></g>
              </svg>
            </div>

            <h3>Performance & Mobile UX</h3>

            <p>
              Product discovery and checkout designed for phones, tablets and desktops with lightning-fast asset handling and responsive implementation.
            </p>

            <div class="capability-tags">
              <span>Fast</span>
              <span>Responsive</span>
              <span>Optimized</span>
            </div>
          </article>

          <article class="capability-card">
            <div class="capability-number">03</div>

            <div class="capability-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.chart}></g>
              </svg>
            </div>

            <h3>Analytics Ready</h3>

            <p>
              Connect analytics, tracking pixels and Search Console so you can accurately measure traffic, conversion rates and customer behaviour.
            </p>

            <div class="capability-tags">
              <span>Google Analytics</span>
              <span>Tracking</span>
              <span>Insights</span>
            </div>
          </article>

        </div>

      </div>
    </section>

    <!-- WHO WE HELP -->
    <section class="usecases-section">
      <div class="container">

        <div class="usecases-layout">

          <div class="usecases-copy">
            <p class="section-kicker">Who we help</p>

            <h2>
              Built for brands at
              <span>different stages of growth.</span>
            </h2>

            <p>
              Whether you are launching your first online store or migrating an existing brand to a custom stack, we engineer stores tailored to your business model.
            </p>

            <div class="mini-stat">
              <strong>Scalable foundations.</strong>
              <span>Built to handle high traffic and expanding product lines.</span>
            </div>
          </div>

          <div class="usecase-list">
            {
              audience.map((item, index) => (
                <div class="usecase-item">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <div>
                    <strong>{item.title}</strong>
                    <p style="margin: 3px 0 0; color: #777; font-size: 11px;">{item.text}</p>
                  </div>

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.arrow}></g>
                  </svg>
                </div>
              ))
            }
          </div>

        </div>

      </div>
    </section>

    <!-- TECHNOLOGY -->
    <section class="included-section">
      <div class="container">

        <div class="included-layout">

          <div class="included-intro">
            <div class="dark-kicker">
              <span></span>
              Technology stack
            </div>

            <h2>
              Modern technology without
              <span>unnecessary complexity.</span>
            </h2>

            <p>
              We choose the stack around your requirements, scale and integrations rather than forcing every business into the same implementation.
            </p>

            <a
              href="https://wa.me/919352563337"
              target="_blank"
              rel="noopener noreferrer"
              class="dark-button"
            >
              Discuss technical requirements
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.arrow}></g>
              </svg>
            </a>
          </div>

          <div class="feature-list">
            {
              technologies.map((technology, index) => (
                <div class="feature-item">
                  <span class="feature-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="feature-check">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <g set:html={iconPaths.check}></g>
                    </svg>
                  </span>

                  <span>{technology}</span>
                </div>
              ))
            }
          </div>

        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="process-section">
      <div class="container">

        <div class="process-header">
          <p class="section-kicker">Our process</p>

          <h2>
            A clear process
            <span>from idea to launch.</span>
          </h2>

          <p>
            Structured milestones ensure your catalogue, checkout workflows and payment gateways are thoroughly tested before going live.
          </p>
        </div>

        <div class="process-grid">
          {
            process.map((step, index) => (
              <article class="process-card">
                <div class="process-top">
                  <span>{step.number}</span>

                  {index < process.length - 1 && (
                    <div class="process-connector"></div>
                  )}
                </div>

                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- PRICING -->
    <section class="pricing-section">
      <div class="container">

        <div class="pricing-layout">

          <div class="pricing-copy">
            <p class="dark-kicker">
              <span></span>
              Investment
            </p>

            <h2>
              E-commerce websites from
              <strong>₹60,000+</strong>
            </h2>

            <p>
              The final price depends on product count, design complexity, payment gateway, shipping, customer accounts, admin workflows and custom functionality.
            </p>

