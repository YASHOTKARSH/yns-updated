                  </div>
                </div>

                <div class="py-8">
                  <div class="h-3 w-24 rounded-full bg-white/20"></div>
                  <div class="mt-5 h-8 max-w-sm rounded-lg bg-white/90"></div>
                  <div class="mt-3 h-8 w-3/4 rounded-lg bg-white/20"></div>

                  <div class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-3">
                    <div class="rounded-xl border border-white/10 bg-white/[0.05] p-4">
                      <div class="h-8 w-8 rounded-lg bg-white/10"></div>
                      <div class="mt-4 h-2 w-20 rounded-full bg-white/20"></div>
                      <div class="mt-2 h-2 w-14 rounded-full bg-white/10"></div>
                    </div>

                    <div class="rounded-xl border border-white/10 bg-white/[0.05] p-4">
                      <div class="h-8 w-8 rounded-lg bg-white/10"></div>
                      <div class="mt-4 h-2 w-20 rounded-full bg-white/20"></div>
                      <div class="mt-2 h-2 w-14 rounded-full bg-white/10"></div>
