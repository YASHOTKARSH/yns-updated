                    <div>
                      <div class="h-2 w-24 rounded-full bg-white/20"></div>
                      <div class="mt-2 h-2 w-16 rounded-full bg-white/10"></div>
                    </div>

                    <div class="rounded-lg bg-white px-4 py-2 text-xs font-semibold text-slate-950">
                      Get a Quote
                    </div>
