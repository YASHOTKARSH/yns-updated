  "YNS Web Studio builds fast, modern and SEO-friendly websites for small businesses in New Zealand. Get a professional business website, redesign, e-commerce store or custom React and Next.js website.";

const canonicalURL =
  "https://ynsweb.studio/services/website-development-new-zealand/";

const whatsappUrl =
  "https://wa.me/919352563337?text=Hi%20YNS%20Web%20Studio%2C%20I%20need%20a%20website%20for%20my%20New%20Zealand%20business.";

const services = [
  {
    title: "Business Websites",
    description:
      "Professional websites designed to explain your business clearly, build trust and generate enquiries.",
    href: "/services/business-website-development/",
    icon: "building",
  },
  {
    title: "Website Redesign",
    description:
      "Turn an outdated website into a modern, mobile-first and conversion-focused digital presence.",
    href: "/services/custom-web-development/",
    icon: "refresh",
  },
  {
    title: "Landing Pages",
    description:
      "Focused landing pages for services, campaigns, paid traffic and lead generation.",
    href: "/services/landing-page-development/",
    icon: "layout",
  },
  {
    title: "E-Commerce Websites",
    description:
      "Online stores with product pages, shopping flows and a strong foundation for growth.",
    href: "/services/ecommerce-development/",
    icon: "cart",
  },
  {
    title: "Booking Websites",
    description:
      "Websites that help customers discover your services and make appointments or enquiries.",
    href: "/services/booking-appointment-websites/",
    icon: "calendar",
  },
  {
    title: "React Development",
    description:
      "Modern React websites and interfaces for businesses that need flexible, interactive experiences.",
    href: "/services/react-development/",
    icon: "code",
  },
  {
    title: "Next.js Development",
    description:
      "Fast, SEO-friendly Next.js websites built for performance, scalability and modern web experiences.",
    href: "/services/nextjs-development/",
    icon: "bolt",
  },
  {
    title: "Custom Web Development",
    description:
      "Custom websites and web applications when a standard business website is not enough.",
    href: "/services/custom-web-development/",
    icon: "layers",
  },
];

const audiences = [
  {
    title: "Tradies & Local Services",
    description:
      "Plumbers, electricians, builders, roofers, landscapers, painters, cleaners and other service businesses.",
  },
  {
    title: "Professional Services",
    description:
      "Consultants, agencies, accountants, advisors and independent professionals who need a credible online presence.",
  },
  {
    title: "Restaurants & Cafés",
    description:
      "Modern websites for menus, enquiries, bookings, locations and local customer discovery.",
  },
  {
    title: "E-Commerce Businesses",
    description:
      "Businesses that want to sell products online through a professional and scalable storefront.",
  },
  {
    title: "Startups & New Businesses",
    description:
      "New businesses that need a strong website without building a large technical team.",
  },
  {
    title: "Businesses With Outdated Websites",
    description:
      "Existing businesses ready to replace a slow, outdated or difficult-to-use website.",
  },
];

const process = [
  {
    number: "01",
    title: "Understand Your Business",
    description:
      "We learn about your business, customers, services, goals and what the website needs to achieve.",
  },
  {
    number: "02",
    title: "Plan the Website",
    description:
      "We define the pages, content structure, user journey, calls-to-action and technical direction.",
  },
  {
    number: "03",
    title: "Design & Develop",
    description:
      "Your website is designed and developed with responsive layouts, clean code and a strong user experience.",
  },
  {
    number: "04",
    title: "SEO & Performance",
    description:
      "We build the technical foundation with structured metadata, semantic HTML, responsive design and performance in mind.",
  },
  {
    number: "05",
    title: "Review & Launch",
    description:
      "We test the website across devices, review the important details with you and prepare it for launch.",
  },
  {
    number: "06",
    title: "Improve & Grow",
    description:
      "After launch, your website can continue evolving with new pages, features, content and conversion improvements.",
  },
];

const faqs = [
  {
    question: "Can YNS Web Studio build websites for businesses in New Zealand?",
    answer:
      "Yes. YNS Web Studio is a Jaipur-based web development studio and can work remotely with businesses in New Zealand. Communication, planning, development and website delivery can all be handled online.",
  },
  {
    question: "What type of websites can you build for New Zealand businesses?",
    answer:
      "We build business websites, landing pages, e-commerce websites, booking websites, corporate websites, React websites, Next.js websites and custom web applications.",
  },
  {
    question: "How much does website development cost in New Zealand?",
    answer:
      "Website cost depends on the number of pages, design requirements, integrations, content, e-commerce functionality and custom development involved. We recommend defining the project scope first so the quote reflects what your business actually needs.",
  },
  {
    question: "Can you redesign an existing website?",
    answer:
      "Yes. If your current website is outdated, difficult to use, slow or not generating enough enquiries, we can redesign and rebuild it with a modern responsive interface and stronger conversion structure.",
  },
  {
    question: "Can you build a website for a New Zealand tradie business?",
    answer:
      "Yes. Tradie and local service businesses can benefit from a website focused on services, service areas, trust signals, enquiry forms, phone calls and quote requests. We can build the website around those customer actions.",
  },
  {
    question: "Do you build SEO-friendly websites?",
    answer:
      "Yes. Our websites are developed with SEO fundamentals such as semantic HTML, page structure, metadata, crawlable content, responsive layouts, internal linking and performance considerations.",
  },
  {
    question: "Can you build React or Next.js websites?",
    answer:
      "Yes. React and Next.js are available when a project benefits from a modern application architecture, custom interface or stronger performance and SEO capabilities.",
  },
  {
    question: "How do we work together remotely?",
    answer:
      "The entire project can be handled remotely through online communication. We can discuss requirements, share designs, review progress and coordinate the launch without requiring an in-person meeting.",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image="https://ynsweb.studio/og-image.jpg"
>
  <svelte:head>
    <link rel="canonical" href={canonicalURL} />
  </svelte:head>

  <main class="overflow-hidden bg-white text-slate-900">

    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section class="relative isolate">
      <div
        class="absolute inset-x-0 top-0 -z-10 h-[620px] bg-[radial-gradient(circle_at_top_right,_rgba(15,23,42,0.08),_transparent_45%),radial-gradient(circle_at_top_left,_rgba(59,130,246,0.07),_transparent_40%)]"
      ></div>

      <div class="mx-auto max-w-7xl px-6 pb-20 pt-16 sm:px-8 lg:px-10 lg:pb-28 lg:pt-24">
        <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">

          <div>
            <div
              class="mb-7 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-600 shadow-sm"
            >
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
              Website Development for New Zealand Businesses
            </div>

            <h1
              class="max-w-4xl text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl lg:leading-[1.05]"
            >
              Professional websites built for
              <span class="text-slate-500"> New Zealand businesses.</span>
            </h1>

            <p
              class="mt-7 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl"
            >
              YNS Web Studio builds fast, modern and SEO-friendly websites for
              small businesses, tradies, professional services and growing
              brands in New Zealand.
            </p>

            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
              <a
                href="/contact/"
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-950 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-slate-800"
              >
                Get a Free Website Review
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  class="h-4 w-4"
                >
                  <path d="M5 12h14" />
                  <path d="m13 6 6 6-6 6" />
                </svg>
              </a>

              <a
                href="/results/"
                class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-slate-800 transition hover:border-slate-400 hover:bg-slate-50"
              >
                View Our Work
              </a>
            </div>

            <div class="mt-9 flex flex-wrap gap-x-6 gap-y-3 text-sm text-slate-500">
              <span class="inline-flex items-center gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  class="h-4 w-4"
                >
                  <path d="m5 12 4 4L19 6" />
                </svg>
                Mobile-first
              </span>

              <span class="inline-flex items-center gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  class="h-4 w-4"
                >
                  <path d="m5 12 4 4L19 6" />
                </svg>
                SEO-ready
              </span>

              <span class="inline-flex items-center gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  class="h-4 w-4"
                >
                  <path d="m5 12 4 4L19 6" />
                </svg>
                Performance-focused
              </span>
            </div>
          </div>

          <!-- Hero visual -->
          <div class="relative">
            <div
              class="rounded-3xl border border-slate-200 bg-slate-950 p-3 shadow-2xl shadow-slate-900/10"
            >
              <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-6">
                <div class="flex items-center justify-between border-b border-white/10 pb-5">
