                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  class="h-5 w-5"
                >
                  <path d="M5 12h14" />
                  <path d="m13 6 6 6-6 6" />
                </svg>
              </div>

              <h3 class="mt-5 text-lg font-semibold text-slate-950">
                Generate enquiries
              </h3>

              <p class="mt-2 text-sm leading-6 text-slate-600">
                Put clear calls-to-action, enquiry forms and service information
                where customers need them.
              </p>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  class="h-5 w-5"
                >
                  <path d="M12 3v18M3 12h18" />
                  <path d="M5.5 5.5 18.5 18.5M18.5 5.5 5.5 18.5" />
                </svg>
              </div>

              <h3 class="mt-5 text-lg font-semibold text-slate-950">
                Get discovered
              </h3>

              <p class="mt-2 text-sm leading-6 text-slate-600">
                Build a technical foundation that makes your website easier for
                search engines and customers to understand.
              </p>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
