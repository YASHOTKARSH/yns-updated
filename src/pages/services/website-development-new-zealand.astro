                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      class="h-5 w-5"
                    >
                      <path d="M4 5h16v14H4z" />
                      <path d="M8 9h8M8 13h5" />
                    </svg>
                  </span>

                  <span class="text-xs font-medium uppercase tracking-wider text-slate-400">
                    NZ Business
                  </span>
                </div>

                <h3 class="mt-6 text-lg font-semibold text-slate-950">
                  {audience.title}
                </h3>

                <p class="mt-2 text-sm leading-6 text-slate-600">
                  {audience.description}
                </p>
              </article>
            ))
          }
        </div>

      </div>
    </section>


    <!-- ========================================================= -->
    <!-- SERVICES -->
