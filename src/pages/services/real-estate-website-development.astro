---
import BaseLayout from "../../components/layout/BaseLayout.astro";

const siteUrl = "https://ynsweb.studio";
const pageUrl = "https://ynsweb.studio/services/real-estate-website-development";

const faqs = [
  {
    question: "How much does a real estate website cost in Jaipur?",
    answer:
      "Real estate website development at YNS Web Studio starts from around ₹50,000. The final cost depends on property listing requirements, search and filters, enquiry flows, integrations, admin functionality, map features and the overall design scope.",
  },
  {
    question: "Can you build a property listing website?",
    answer:
      "Yes. We can build property listing websites for real estate companies, brokers, builders and property consultants with structured property pages, search, filters, enquiry forms and other features based on the business workflow.",
  },
  {
    question: "Can users search properties by location and budget?",
    answer:
      "Yes. Search and filtering can be designed around your inventory, including location, property type, budget, bedrooms, area, purpose and other relevant attributes.",
  },
  {
    question: "Can property details be managed from an admin panel?",
    answer:
      "Yes. An admin dashboard can be added to create, update, organize and manage property listings, images, details, enquiry information and other content.",
  },
  {
    question: "Can Google Maps or location features be integrated?",
    answer:
      "Yes. Map and location functionality can be integrated when useful for the project, including property locations, area information and location-based discovery.",
  },
  {
    question: "Can the website generate real estate leads?",
    answer:
      "Yes. The website can be structured around enquiry forms, WhatsApp CTAs, call actions, property-specific enquiries and clear conversion paths to help turn property traffic into leads.",
  },
];

const features = [
  {
    number: "01",
    title: "Property Listings",
    text: "Present residential, commercial, rental and other properties through structured, detailed listing pages.",
  },
  {
    number: "02",
    title: "Search & Filters",
    text: "Help visitors narrow properties by location, price, type, size, bedrooms and other relevant criteria.",
  },
  {
    number: "03",
    title: "Property Detail Pages",
    text: "Show galleries, specifications, amenities, location information, descriptions and enquiry actions.",
  },
  {
    number: "04",
    title: "Lead Capture",
    text: "Capture property-specific enquiries through forms, WhatsApp, calls and focused CTAs.",
  },
  {
    number: "05",
    title: "Admin Management",
    text: "Manage listings, images, availability and selected website content through an admin interface.",
  },
  {
    number: "06",
    title: "Maps & Location",
    text: "Add useful location context and map functionality to make property discovery easier.",
  },
];

const propertyTypes = [
  {
    title: "Residential",
    text: "Apartments, flats, villas, plots, independent houses and other residential properties.",
  },
  {
    title: "Commercial",
    text: "Offices, shops, showrooms, warehouses and commercial spaces.",
  },
  {
    title: "Rental",
    text: "Rental properties with relevant pricing, availability and enquiry information.",
  },
  {
    title: "New Projects",
    text: "Builder and developer projects with project details, amenities and lead capture.",
  },
  {
    title: "Plots & Land",
    text: "Land and plot listings organized around location, area and pricing.",
  },
  {
    title: "Luxury Properties",
    text: "Premium property presentation with rich visuals and detailed information.",
  },
];

const leadJourney = [
  {
    number: "01",
    title: "Discover",
    text: "Visitor finds your website through search, social media, referrals or direct traffic.",
  },
  {
    number: "02",
    title: "Search",
    text: "They browse listings and narrow the options using relevant filters.",
  },
  {
    number: "03",
    title: "Evaluate",
    text: "They review property photos, specifications, location and key details.",
  },
  {
    number: "04",
    title: "Enquire",
    text: "A clear call, WhatsApp or enquiry action makes contacting your team simple.",
  },
  {
    number: "05",
    title: "Follow up",
    text: "Your team receives the lead and continues the property conversation.",
  },
];

const stack = [
  "Next.js",
  "React",
  "Astro",
  "JavaScript",
  "Tailwind CSS",
  "Node.js",
  "Express",
  "MongoDB",
  "PostgreSQL",
  "REST APIs",
  "Google Maps",
  "Cloudinary",
];

const process = [
  {
    number: "01",
    title: "Discovery",
    text: "Understand your property inventory, customers and sales process.",
  },
  {
    number: "02",
    title: "Architecture",
    text: "Plan listing structure, filters, pages and enquiry journeys.",
  },
  {
    number: "03",
    title: "UI Design",
    text: "Design a premium property browsing experience.",
  },
  {
    number: "04",
    title: "Development",
    text: "Build the frontend, backend and integrations.",
  },
  {
    number: "05",
    title: "Launch",
    text: "Test the experience and deploy the website for real users.",
  },
];

const iconPaths = {
  arrow: `<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>`,
  check: `<path d="m5 12 4 4L19 6"></path>`,
  layers: `<path d="m12 2 9 5-9 5-9-5 9-5Z"></path><path d="m3 12 9 5 9-5"></path><path d="m3 17 9 5 9-5"></path>`,
  shield: `<path d="M12 3 20 6v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z"></path><path d="m9 12 2 2 4-4"></path>`,
  chart: `<path d="M4 19V5"></path><path d="M4 19h16"></path><path d="m7 15 3-4 3 2 5-7"></path>`,
  search: `<circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path>`,
  home: `<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline>`,
  map: `<polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line>`,
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "YNS Web Studio",
      url: siteUrl,
      description:
        "Real estate website development company in Jaipur building property listings, search filters, and lead generation platforms.",
      areaServed: ["Jaipur", "Rajasthan", "India"],
      serviceType: "Real Estate Website Development",
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: "Real Estate Website Development",
      serviceType: "Real Estate Website Development",
      provider: {
        "@id": `${siteUrl}/#organization`,
      },
      areaServed: ["Jaipur", "Rajasthan", "India"],
      url: pageUrl,
      description:
        "Real estate website development for brokers, builders, developers and property companies with listings, search, filters, maps and lead generation.",
      offers: {
        "@type": "Offer",
        priceCurrency: "INR",
        price: "50000",
      },
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: "Real Estate Website Development Company Jaipur | YNS Web Studio",
      isPartOf: {
        "@id": `${siteUrl}/#website`,
      },
      about: {
        "@id": `${pageUrl}#service`,
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: siteUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Services",
          item: `${siteUrl}/services`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Real Estate Website Development",
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="Real Estate Website Development Company Jaipur | YNS Web Studio"
  description="YNS Web Studio builds real estate websites in Jaipur for brokers, builders and property companies with property listings, search filters, enquiry forms, maps, admin dashboards and SEO-friendly pages."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta
      name="keywords"
      content="real estate website development Jaipur, property portal development Jaipur, real estate web design company Jaipur, builder website development, property listing website design"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Real Estate Website Development Company Jaipur | YNS Web Studio" />
    <meta
      property="og:description"
      content="Professional real estate websites with property listings, search, filters, maps, lead capture and admin management."
    />
    <meta property="og:url" content={pageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Real Estate Website Development Company Jaipur | YNS Web Studio" />
    <meta
      property="og:description"
      content="SEO-friendly real estate website development for brokers, builders and property businesses."
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="business-page">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>

      <div class="container hero-container">

        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/services">Services</a>
          <span>/</span>
          <span aria-current="page">Real Estate Website Development</span>
        </nav>

        <div class="hero-layout">

          <div class="hero-copy">

            <div class="eyebrow">
              <span class="eyebrow-dot"></span>
              Real Estate Website Development in Jaipur
            </div>

            <h1>
              Turn property listings into
              <em>qualified enquiries.</em>
            </h1>

            <p class="hero-description">
              We build modern real estate websites for brokers, builders, developers and property companies in Jaipur and across India. Showcase inventory, simplify property discovery and give prospects a direct path to enquire.
            </p>

            <div class="hero-actions">
              <a
                href="https://wa.me/919352563337"
                target="_blank"
                rel="noopener noreferrer"
                class="button button-primary"
              >
                Discuss Your Real Estate Website
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.arrow}></g>
                </svg>
              </a>

              <a href="#features" class="button button-secondary">
                Explore features
              </a>
            </div>

            <div class="hero-stats">
              <div>
                <strong>₹50K+</strong>
                <span>Starting investment</span>
              </div>
              <div>
                <strong>2–4</strong>
                <span>Typical weeks</span>
              </div>
              <div>
                <strong>100%</strong>
                <span>Lead generation ready</span>
              </div>
            </div>

          </div>

          <!-- WEBSITE PREVIEW -->
          <div class="hero-visual">

            <div class="visual-label visual-label-top">
              <span></span>
              PROPERTY PORTAL & INVENTORY
            </div>

            <div class="browser-window">

              <div class="browser-top">
                <div class="browser-controls">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <div class="browser-url">
                  <span class="lock">⌁</span>
                  yourpropertyhub.com
                </div>

                <div class="browser-menu">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>

              <div class="website-preview">

                <div class="preview-nav">
                  <div class="preview-brand">
                    <span class="brand-mark">Y</span>
                    <span>ESTATE HUB</span>
                  </div>

                  <div class="preview-links">
                    <span>Properties</span>
                    <span>Builders</span>
                    <span>Map Search</span>
                  </div>

                  <div class="preview-nav-button">Enquire</div>
                </div>

                <div class="preview-hero">
                  <div class="preview-hero-copy">
                    <span class="mini-label">VERIFIED LISTINGS</span>

                    <div class="preview-heading">
                      Find your space.
                      <br />
                      <i>Prime locations.</i>
                    </div>

                    <div class="preview-lines">
                      <span></span>
                      <span></span>
                    </div>

                    <div class="preview-cta-row">
                      <span class="preview-button"></span>
                      <span class="preview-link"></span>
                    </div>
                  </div>

                  <div class="preview-visual-card">
                    <div class="visual-card-shape shape-one"></div>
                    <div class="visual-card-shape shape-two"></div>
                    <div class="visual-card-inner">
                      <span>3 BHK</span>
                      <strong>₹85 LAKH</strong>
                    </div>
                  </div>
                </div>

                <div class="preview-bottom">
                  <div>
                    <span>01</span>
                    <small>Location Filters</small>
                  </div>
                  <div>
                    <span>02</span>
                    <small>Interactive Map</small>
                  </div>
                  <div>
                    <span>03</span>
                    <small>WhatsApp Leads</small>
                  </div>
                </div>

              </div>
            </div>

            <div class="floating-card floating-card-one">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.home}></g>
                </svg>
              </span>
              <div>
                <strong>Structured Listings</strong>
                <small>Detailed specifications</small>
              </div>
            </div>

            <div class="floating-card floating-card-two">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.map}></g>
                </svg>
              </span>
              <div>
                <strong>Map Integration</strong>
                <small>Location-based discovery</small>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="intro-section">
      <div class="container">
        <div class="intro-grid">

          <div class="section-number">01</div>

          <div class="intro-content">
            <p class="section-kicker">Property discovery</p>

            <h2>
              Make it easier for buyers and renters
              <span>to find the right property.</span>
            </h2>

            <div class="intro-text-grid">
              <p>
                A real estate website should do more than display a collection of property photos. Visitors need to quickly understand what is available, narrow their options and get enough information to decide whether they should contact your team.
              </p>

              <p>
                YNS Web Studio builds property websites around structured listings, useful search, clear property details and conversion-focused enquiry paths. The result is a digital property catalogue designed around how real estate customers actually browse.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- CORE FEATURES -->
    <section id="features" class="benefits-section">
      <div class="container">

        <div class="section-heading split-heading">
          <div>
            <p class="section-kicker">Core features</p>
            <h2>Everything needed for a<br /><span>modern property website.</span></h2>
          </div>

          <p>
            Start with the features that match your inventory and sales process, then extend the platform as your property portfolio grows.
          </p>
        </div>

        <div class="benefit-grid">
          {
            features.map((item) => (
              <article class="benefit-card">
                <div class="card-number">{item.number}</div>

                <div class="card-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.home}></g>
                  </svg>
                </div>

                <h3>{item.title}</h3>
                <p>{item.text}</p>

                <span class="card-arrow">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.arrow}></g>
                  </svg>
                </span>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- PROPERTY CATEGORIES -->
    <section class="pages-section">
      <div class="container">

        <div class="pages-header">
          <div>
            <p class="section-kicker">Property categories</p>
            <h2>
              Organize your inventory around
              <span>the way customers search.</span>
            </h2>
          </div>

          <p>
            Your property catalogue can be structured for one category or multiple property types, with dedicated details and search attributes for each.
          </p>
        </div>

        <div class="page-grid">
          {
            propertyTypes.map((prop, index) => (
              <article class="page-card">
                <div class="page-card-top">
                  <span>0{index + 1}</span>

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.layers}></g>
                  </svg>
                </div>

                <h3>{prop.title}</h3>
                <p>{prop.text}</p>

                <div class="page-line"></div>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- LEAD GENERATION -->
    <section class="included-section">
      <div class="container">

        <div class="included-layout">

          <div class="included-intro">
            <div class="dark-kicker">
              <span></span>
              Lead generation
            </div>

            <h2>
              Build the property journey
              <span>around enquiries.</span>
            </h2>

            <p>
              Every important property detail should support the next action. Clear contact options help visitors move from browsing to an actual conversation with your team.
            </p>

            <a
              href="https://wa.me/919352563337"
              target="_blank"
              rel="noopener noreferrer"
              class="dark-button"
            >
              Discuss lead generation flow
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.arrow}></g>
              </svg>
            </a>
          </div>

          <div class="feature-list">
            {
              leadJourney.map((step) => (
                <div class="feature-item">
                  <span class="feature-number">
                    {step.number}
                  </span>

                  <span class="feature-check">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <g set:html={iconPaths.check}></g>
                    </svg>
                  </span>

                  <span><strong>{step.title}:</strong> {step.text}</span>
                </div>
              ))
            }
          </div>

        </div>
      </div>
    </section>

    <!-- CAPABILITIES / SEO -->
    <section class="capabilities-section">
      <div class="container">

        <div class="capabilities-heading">
          <p class="section-kicker">SEO & performance</p>
          <h2>
            Create a real estate website that
            <span>can scale with your inventory.</span>
          </h2>
        </div>

        <div class="capability-grid">

          <article class="capability-card capability-featured">
            <div class="capability-number">01</div>

            <div class="capability-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.search}></g>
              </svg>
            </div>

            <h3>Technical SEO foundation</h3>

            <p>
              Metadata, headings, clean URLs, structured data and internal linking give search engines visibility over location and property type pages.
            </p>

            <div class="capability-tags">
              <span>Metadata</span>
              <span>Schema</span>
              <span>Clean URLs</span>
            </div>
          </article>

          <article class="capability-card">
            <div class="capability-number">02</div>

            <div class="capability-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.map}></g>
              </svg>
            </div>

            <h3>Responsive & Maps</h3>

            <p>
              Property browsing optimized for mobile, tablet and desktop with efficient imagery and interactive location maps.
            </p>

            <div class="capability-tags">
              <span>Responsive</span>
              <span>Google Maps</span>
              <span>Fast</span>
            </div>
          </article>

          <article class="capability-card">
            <div class="capability-number">03</div>

            <div class="capability-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.shield}></g>
              </svg>
            </div>

            <h3>Scalable Architecture</h3>

            <p>
              A robust backend and frontend foundation that can support additional listings, user accounts and advanced search functionality as you grow.
            </p>

            <div class="capability-tags">
              <span>Scalable</span>
              <span>Secure</span>
              <span>Admin Ready</span>
            </div>
          </article>

        </div>

      </div>
    </section>

    <!-- PROCESS -->
    <section class="process-section">
      <div class="container">

        <div class="process-header">
          <p class="section-kicker">Development process</p>

          <h2>
            From property requirements
            <span>to launch.</span>
          </h2>

          <p>
            Structured milestones ensure your inventory, search filters and lead funnels are properly engineered before launch.
          </p>
        </div>

        <div class="process-grid">
          {
            process.map((step, index) => (
              <article class="process-card">
                <div class="process-top">
                  <span>{step.number}</span>

                  {index < process.length - 1 && (
                    <div class="process-connector"></div>
                  )}
                </div>

                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- PRICING -->
    <section class="pricing-section">
      <div class="container">

        <div class="pricing-layout">

          <div class="pricing-copy">
            <p class="dark-kicker">
              <span></span>
              Investment
            </p>

            <h2>
              Real estate websites start from
              <strong>₹50,000+</strong>
            </h2>

            <p>
              Pricing depends on the number of property types, listing functionality, filters, admin features, maps, integrations, content and overall technical scope.
            </p>

            <div class="pricing-note">
              <span class="pricing-note-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.shield}></g>
                </svg>
              </span>

              <div>
                <strong>Transparent scoping</strong>
                <span>
                  Receive a detailed project proposal before any code is written.
                </span>
              </div>
            </div>
          </div>

          <div class="pricing-panel">

            <div class="pricing-option featured-price">
              <div>
                <span class="pricing-label">Real Estate Website</span>
                <strong>₹50,000+</strong>
                <p>Property listings, search filters, detail pages & lead capture.</p>
              </div>

              <span class="pricing-badge">Starting</span>
            </div>

            <div class="pricing-option">
              <div>
                <span class="pricing-label">Property Portal with Admin</span>
                <strong>Custom quote</strong>
                <p>Advanced admin dashboard, agent accounts & multi-location map search.</p>
              </div>
            </div>

            <div class="pricing-option">
              <div>
                <span class="pricing-label">Ongoing support</span>
                <strong>Custom</strong>
                <p>Maintenance, inventory updates and feature additions.</p>
              </div>
            </div>

            <a
              href="https://wa.me/919352563337"
              target="_blank"
              rel="noopener noreferrer"
              class="pricing-button"
            >
              Get a Real Estate Website Quote
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.arrow}></g>
              </svg>
            </a>

          </div>

        </div>

      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="faq-section">
      <div class="container faq-container">

        <div class="faq-heading">
          <p class="section-kicker">FAQ</p>

          <h2>
            Real estate website
            <span>questions.</span>
          </h2>

          <p>
            Everything you should know before starting your property website project.
          </p>
        </div>

        <div class="faq-list">
          {
            faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>
                  <span class="faq-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="faq-question">{faq.question}</span>

                  <span class="faq-toggle">
                    <span></span>
