  }

  .feature-item:nth-child(odd) {
    padding-right: 20px;
    border-right: 1px solid #303030;
  }

  .feature-item:nth-child(even) {
    padding-left: 20px;
  }

  .feature-number {
    color: #555;
    font-size: 9px;
    font-weight: 700;
  }

  .feature-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 21px;
    height: 21px;
    border-radius: 50%;
    background: #242424;
    color: var(--accent);
  }

  .feature-check svg {
    width: 11px;
    height: 11px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* PAGES */
  .pages-section {
    padding: 120px 0;
    border-bottom: 1px solid var(--line);
  }

  .pages-header {
    display: grid;
    grid-template-columns: 1fr 0.65fr;
    gap: 80px;
    align-items: end;
  }

  .pages-header > p {
    margin: 0 0 3px;
    color: #6d6d68;
    font-size: 15px;
    line-height: 1.8;
  }

  .page-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 65px;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .page-card {
    position: relative;
    min-height: 250px;
    padding: 28px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: #f7f7f5;
    transition: background 0.25s ease;
  }

  .page-card:hover {
    background: white;
  }

  .page-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .page-card-top > span {
    color: #a4a49f;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .page-card-top svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: #999;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .page-card h3 {
    margin: 60px 0 0;
    font-size: 23px;
    letter-spacing: -0.03em;
  }

  .page-card p {
    max-width: 330px;
    margin: 10px 0 0;
    color: #70706b;
    font-size: 13px;
    line-height: 1.7;
  }

  .page-line {
    width: 45px;
    height: 2px;
    margin-top: 25px;
    background: #111;
  }

  /* CAPABILITIES */
  .capabilities-section {
    padding: 120px 0;
    border-bottom: 1px solid var(--line);
  }

  .capabilities-heading {
    max-width: 780px;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.925fr 0.925fr;
    gap: 15px;
    margin-top: 60px;
  }

  .capability-card {
    position: relative;
    min-height: 410px;
    padding: 30px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: #efefeb;
    overflow: hidden;
    transition:
      transform 0.3s ease,
      background 0.3s ease;
  }

  .capability-card:hover {
    transform: translateY(-5px);
    background: white;
  }

  .capability-featured {
    background: #111;
    color: white;
    border-color: #111;
  }

  .capability-featured:hover {
    background: #161616;
  }

  .capability-number {
    position: absolute;
    top: 28px;
    right: 30px;
    color: #999;
    font-size: 10px;
    font-weight: 700;
  }

  .capability-featured .capability-number {
    color: #555;
  }

  .capability-icon {
    margin-top: 0;
  }

  .capability-card h3 {
    max-width: 330px;
    margin: 55px 0 0;
    font-size: 24px;
    letter-spacing: -0.035em;
  }

  .capability-card p {
    margin: 15px 0 0;
    color: #6d6d68;
    font-size: 13px;
    line-height: 1.75;
  }

  .capability-featured p {
    color: #888;
  }

  .capability-tags {
    position: absolute;
    left: 30px;
    bottom: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .capability-tags span {
    padding: 6px 9px;
    border: 1px solid #d5d5cf;
    border-radius: 99px;
    color: #777;
    font-size: 9px;
    font-weight: 700;
  }

  .capability-featured .capability-tags span {
    border-color: #333;
    color: #888;
  }

  /* USE CASES */
  .usecases-section {
    padding: 120px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .usecases-layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 100px;
  }

  .usecases-copy > p:last-of-type {
    max-width: 500px;
    margin-top: 25px;
    color: #6c6c67;
    font-size: 15px;
    line-height: 1.8;
  }

  .mini-stat {
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-width: 360px;
    margin-top: 55px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .mini-stat strong {
    font-size: 14px;
  }

  .mini-stat span {
    color: #888;
    font-size: 12px;
  }

  .usecase-list {
    border-top: 1px solid var(--line);
  }

  .usecase-item {
    display: grid;
    grid-template-columns: 42px 1fr 20px;
    align-items: center;
    gap: 15px;
    min-height: 66px;
    border-bottom: 1px solid var(--line);
    transition: padding 0.25s ease;
  }

  .usecase-item:hover {
    padding-left: 10px;
  }

  .usecase-item > span {
    color: #aaa;
    font-size: 10px;
    font-weight: 700;
  }

  .usecase-item strong {
    font-size: 14px;
    font-weight: 600;
  }

  .usecase-item svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: #aaa;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* PROCESS */
  .process-section {
    padding: 120px 0;
    border-bottom: 1px solid var(--line);
  }

  .process-header {
    max-width: 780px;
  }

  .process-header > p:last-child {
    max-width: 650px;
    margin-top: 25px;
    color: #6d6d68;
    font-size: 15px;
    line-height: 1.8;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 15px;
    margin-top: 65px;
  }

  .process-card {
    min-height: 280px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: #f7f7f5;
  }

  .process-top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .process-top > span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #111;
    color: var(--accent);
    font-size: 10px;
    font-weight: 700;
  }

  .process-connector {
    width: 25px;
    height: 1px;
    background: var(--line);
  }

  .process-card h3 {
    margin: 60px 0 0;
    font-size: 21px;
    letter-spacing: -0.025em;
  }

  .process-card p {
    margin: 12px 0 0;
    color: #6d6d68;
    font-size: 13px;
    line-height: 1.75;
  }

  /* PRICING */
  .pricing-section {
    padding: 120px 0;
  }

  .pricing-layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    align-items: center;
    gap: 100px;
  }

  .pricing-copy h2 {
    max-width: 650px;
    margin: 18px 0 0;
    color: white;
    font-size: clamp(42px, 5vw, 70px);
    line-height: 1;
    letter-spacing: -0.06em;
    font-weight: 500;
  }

  .pricing-copy h2 strong {
    display: block;
    color: var(--accent);
    font-weight: 500;
  }

  .pricing-copy > p {
    max-width: 530px;
    margin-top: 28px;
    color: #858581;
    font-size: 15px;
    line-height: 1.8;
  }

  .pricing-note {
    display: flex;
    align-items: center;
    gap: 13px;
    max-width: 430px;
    margin-top: 45px;
    padding-top: 20px;
    border-top: 1px solid #303030;
  }

  .pricing-note-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 37px;
    height: 37px;
    flex: 0 0 37px;
    border-radius: 10px;
    background: #222;
    color: var(--accent);
  }

  .pricing-note-icon svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pricing-note strong,
  .pricing-note span {
    display: block;
  }

  .pricing-note strong {
    color: white;
    font-size: 12px;
  }

  .pricing-note span {
    margin-top: 4px;
    color: #666;
    font-size: 10px;
  }

  .pricing-panel {
    padding: 10px;
    border: 1px solid #303030;
    border-radius: 24px;
    background: #181818;
  }

  .pricing-option {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 105px;
    padding: 18px 20px;
    border-bottom: 1px solid #2c2c2c;
  }

  .pricing-option:last-of-type {
    border-bottom: 0;
  }

  .pricing-option.featured-price {
    border-radius: 16px;
    background: #222;
  }

  .pricing-label {
    display: block;
    color: #aaa;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pricing-option strong {
    display: block;
    margin-top: 6px;
    color: white;
    font-size: 22px;
    letter-spacing: -0.03em;
  }

  .pricing-option p {
    margin: 5px 0 0;
    color: #666;
    font-size: 10px;
  }

  .pricing-badge {
    padding: 6px 9px;
    border-radius: 99px;
    background: var(--accent);
    color: #111;
    font-size: 8px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .pricing-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    width: 100%;
    min-height: 52px;
    margin-top: 10px;
    border-radius: 14px;
    background: white;
    color: #111;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.25s ease;
  }

  .pricing-button:hover {
    transform: translateY(-2px);
  }

  /* FAQ */
  .faq-section {
    padding: 120px 0;
    border-bottom: 1px solid var(--line);
  }

  .faq-container {
    max-width: 1000px;
  }

  .faq-heading {
    text-align: center;
  }

  .faq-heading > p:last-child {
    margin-top: 20px;
    color: #777;
    font-size: 14px;
  }

  .faq-list {
    margin-top: 60px;
    border-top: 1px solid var(--line);
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-item summary {
    display: grid;
    grid-template-columns: 42px 1fr 34px;
    align-items: center;
    gap: 12px;
    min-height: 85px;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-number {
    color: #aaa;
    font-size: 10px;
    font-weight: 700;
  }

  .faq-question {
    font-size: 15px;
    font-weight: 600;
  }

  .faq-toggle {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid #d7d7d1;
    border-radius: 50%;
  }

  .faq-toggle span {
    position: absolute;
    width: 11px;
    height: 1px;
    background: #777;
    transition: transform 0.25s ease;
  }

  .faq-toggle span:last-child {
    transform: rotate(90deg);
  }

  .faq-item[open] .faq-toggle span:last-child {
    transform: rotate(0);
  }

  .faq-answer {
    padding: 0 46px 28px 54px;
  }

  .faq-answer p {
    max-width: 760px;
    margin: 0;
    color: #6d6d68;
    font-size: 14px;
    line-height: 1.8;
  }

  /* RELATED */
  .related-section {
    padding: 90px 0;
  }

  .related-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
  }

  .related-header h2 {
    margin: 12px 0 0;
    font-size: 34px;
    letter-spacing: -0.045em;
    font-weight: 500;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #111;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }

  .text-link svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }

  .text-link:hover svg {
    transform: translateX(3px);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 42px;
  }

  .related-card {
    position: relative;
    min-height: 210px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: #f7f7f5;
    color: #111;
    text-decoration: none;
    transition:
      transform 0.25s ease,
      background 0.25s ease;
  }

  .related-card:hover {
    transform: translateY(-5px);
    background: white;
  }

  .related-card > span {
    color: #aaa;
    font-size: 9px;
    font-weight: 700;
  }

  .related-card h3 {
    margin: 45px 0 0;
    font-size: 16px;
    letter-spacing: -0.02em;
  }

  .related-card p {
    margin: 8px 0 0;
    color: #777;
    font-size: 11px;
    line-height: 1.65;
  }

  .related-card svg {
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: #aaa;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* FINAL CTA */
  .final-cta-section {
    padding: 30px 0 100px;
    background: #f7f7f5;
  }

  .final-cta {
    position: relative;
    min-height: 490px;
    overflow: hidden;
    padding: 75px;
    border-radius: 28px;
    background: #111;
    color: white;
  }

  .cta-grid {
    opacity: 0.2;
  }

  .cta-glow {
    position: absolute;
    right: -100px;
    top: -100px;
    width: 430px;
    height: 430px;
    border-radius: 50%;
    background: rgba(201,255,74,0.1);
    filter: blur(80px);
  }

  .cta-content {
    position: relative;
    z-index: 2;
    max-width: 750px;
  }

  .cta-content h2 {
    max-width: 760px;
    margin: 18px 0 0;
    font-size: clamp(43px, 5vw, 70px);
    line-height: 0.99;
    letter-spacing: -0.06em;
    font-weight: 500;
  }

  .cta-content h2 span {
    display: block;
    color: #666;
  }

  .cta-content > p {
    max-width: 620px;
    margin: 25px 0 0;
    color: #888;
    font-size: 15px;
    line-height: 1.8;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 35px;
  }

  .cta-primary,
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 50px;
    padding: 0 20px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.25s ease;
  }

  .cta-primary {
    background: var(--accent);
    color: #111;
  }

  .cta-secondary {
    border: 1px solid #383838;
    color: white;
  }

  .cta-primary:hover,
  .cta-secondary:hover {
    transform: translateY(-2px);
  }

  .cta-location {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 45px;
    color: #555;
    font-size: 10px;
  }

  .cta-location span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .cta-side {
    position: absolute;
    right: 70px;
    bottom: 60px;
    z-index: 2;
    width: 180px;
    height: 180px;
    border: 1px solid #2e2e2e;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 35px;
    transform: rotate(-8deg);
  }

  .cta-side-number {
    color: #555;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  .cta-side p {
    margin: 10px 0 0;
    color: #888;
    font-size: 13px;
    line-height: 1.45;
  }

  .cta-side strong {
    color: var(--accent);
    font-weight: 500;
  }

  /* RESPONSIVE */
  @media (max-width: 1100px) {
    .hero-layout {
      grid-template-columns: 1fr;
      gap: 60px;
      padding-top: 50px;
    }

    .hero-copy {
      max-width: 800px;
    }

    .hero-visual {
      max-width: 720px;
      width: 100%;
      margin: 0 auto;
    }

    .included-layout,
    .pricing-layout,
    .usecases-layout {
      gap: 60px;
    }

    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cta-side {
      right: 40px;
    }

    .process-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 800px) {
    .container {
      width: min(100% - 28px, 680px);
    }

    .hero {
      min-height: auto;
    }

    .hero-container {
      padding-top: 22px;
      padding-bottom: 65px;
    }

    .hero-layout {
      min-height: auto;
      padding-top: 55px;
    }

    .hero h1 {
      font-size: clamp(47px, 12vw, 70px);
    }

    .hero-description {
      font-size: 16px;
    }

    .hero-stats {
      margin-top: 45px;
    }

    .hero-visual {
      min-height: 480px;
    }

    .browser-window {
      transform: none;
    }

    .floating-card-one {
      left: -5px;
      bottom: 35px;
    }

    .floating-card-two {
      right: -5px;
      top: 35px;
    }

    .intro-section,
    .benefits-section,
    .pages-section,
    .capabilities-section,
    .usecases-section,
    .process-section,
    .faq-section {
      padding: 80px 0;
    }

    .intro-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .intro-text-grid,
    .split-heading,
    .pages-header,
    .included-layout,
    .pricing-layout,
    .usecases-layout {
      grid-template-columns: 1fr;
    }

    .intro-text-grid {
      gap: 25px;
    }

    .split-heading,
    .pages-header {
      gap: 25px;
    }

    .benefit-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .feature-list {
      grid-template-columns: 1fr;
    }

    .feature-item:nth-child(odd) {
      padding-right: 0;
      border-right: 0;
    }

    .feature-item:nth-child(even) {
      padding-left: 0;
    }

    .page-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .capability-grid {
      grid-template-columns: 1fr;
    }

    .capability-card {
      min-height: 350px;
    }

    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .pricing-layout {
      align-items: stretch;
    }

    .related-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .final-cta {
      padding: 55px 30px;
    }

    .cta-side {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .container {
      width: min(100% - 24px, 680px);
    }

    .breadcrumb {
      font-size: 10px;
    }

    .hero-layout {
      padding-top: 45px;
    }

    .hero-actions {
      flex-direction: column;
    }

    .button {
      width: 100%;
    }

    .hero-stats {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .hero-stats div,
    .hero-stats div + div {
      padding: 0;
      border: 0;
    }

    .hero-visual {
      min-height: 390px;
    }

    .visual-label-top {
      right: 0;
    }

    .browser-window {
      width: 100%;
      border-radius: 12px;
    }

    .browser-url,
    .preview-links,
    .preview-nav-button {
      display: none;
    }

    .browser-controls {
      width: auto;
    }

    .preview-nav {
      padding: 0 13px;
