---
import BaseLayout from "../../components/layout/BaseLayout.astro";

const siteUrl = "https://ynsweb.studio";
const pageUrl = "https://ynsweb.studio/services/business-website-development";

const benefits = [
  {
    title: "Built around your business goal",
    text: "The website structure is planned around what you actually need from it, whether that means enquiries, calls, WhatsApp conversations, bookings or stronger online credibility.",
  },
  {
    title: "Search-friendly foundation",
    text: "Semantic HTML, descriptive metadata, clean URLs, internal linking and a crawl-friendly structure give your website a stronger technical SEO foundation.",
  },
  {
    title: "Designed for mobile users",
    text: "Your website is designed for mobile, tablet and desktop instead of treating mobile as an afterthought.",
  },
  {
    title: "Clear customer journey",
    text: "Visitors should quickly understand what you offer, why they should trust you and what they should do next.",
  },
  {
    title: "Easy to expand",
    text: "The structure can grow with your business through new services, locations, case studies, landing pages, blog content and integrations.",
  },
  {
    title: "Custom to your brand",
    text: "The design, content hierarchy and functionality are shaped around your business instead of forcing your company into a generic template.",
  },
];

const features = [
  "Custom responsive website design",
  "5–10 core business pages",
  "Individual service sections or pages",
  "WhatsApp and enquiry integration",
  "Contact forms and lead capture",
  "Technical SEO foundation",
  "Clean URL and heading structure",
  "Google Analytics and Search Console setup",
  "Google Maps and social media integration",
  "Production deployment",
  "Mobile, tablet and desktop testing",
  "Post-launch support options",
];

const pages = [
  {
    number: "01",
    title: "Homepage",
    text: "Explain what your business does, who you help and why a customer should choose you.",
  },
  {
    number: "02",
    title: "About",
    text: "Build trust through your story, experience, team, positioning and business background.",
  },
  {
    number: "03",
    title: "Services",
    text: "Present your main services clearly and guide visitors toward the most relevant solution.",
  },
  {
    number: "04",
    title: "Service Pages",
    text: "Create dedicated pages when an individual service deserves its own search and conversion journey.",
  },
  {
    number: "05",
    title: "Work / Portfolio",
    text: "Show previous projects, case studies, testimonials or other evidence that helps customers make a decision.",
  },
  {
    number: "06",
    title: "Contact",
    text: "Give visitors simple ways to call, message, submit an enquiry, find your location or start a conversation.",
  },
];

const process = [
  {
    number: "01",
    title: "Understand",
    text: "We first understand your business, audience, services, competitors and the action you want visitors to take.",
  },
  {
    number: "02",
    title: "Plan",
    text: "We define the pages, content hierarchy, navigation, internal links and conversion paths before development.",
  },
  {
    number: "03",
    title: "Design",
    text: "We create a visual direction that fits your brand while keeping readability, mobile usability and conversion in mind.",
  },
  {
    number: "04",
    title: "Develop",
    text: "The approved design is converted into a responsive production-ready website with clean, semantic implementation.",
  },
  {
    number: "05",
    title: "Test & Optimize",
    text: "We check responsive layouts, links, forms, metadata, basic technical SEO, performance and important user journeys.",
  },
  {
    number: "06",
    title: "Launch",
    text: "The website is deployed to production and connected with the required analytics, search and communication tools.",
  },
];

const useCases = [
  "Local service businesses",
  "Consultants and professionals",
  "Agencies and creative studios",
  "Clinics and healthcare businesses",
  "Gyms and fitness studios",
  "Restaurants and cafés",
  "Hotels and homestays",
  "Real estate businesses",
  "Education and coaching businesses",
  "Startups and growing companies",
];

const faqs = [
  {
    question: "How much does a business website cost in Jaipur?",
    answer:
      "Business website development at YNS Web Studio starts from ₹20,000. The final cost depends on the number of pages, design requirements, content, integrations, functionality and project scope. A specific quote is provided after understanding the requirements.",
  },
  {
    question: "How long does it take to build a business website?",
    answer:
      "A standard business website generally takes around 7–14 working days when the required content, branding, feedback and approvals are available on time. Larger websites and projects with custom functionality may require more time.",
  },
  {
    question: "What is included in a professional business website?",
    answer:
      "A professional business website can include a custom responsive interface, core business pages, service information, contact forms, WhatsApp integration, technical SEO foundations, analytics setup, social links, Google Maps and production deployment. The exact scope depends on the project.",
  },
  {
    question: "Will my business website be mobile responsive?",
    answer:
      "Yes. Responsive development is part of the website build. The interface is designed and tested across mobile, tablet and desktop layouts so visitors can comfortably browse and contact your business from different devices.",
  },
  {
    question: "Is SEO included with business website development?",
    answer:
      "A technical SEO foundation is included. This can cover semantic HTML, page metadata, clean URLs, heading structure, responsive implementation, internal linking considerations, sitemap support and other technical foundations. Ongoing SEO campaigns and content marketing are separate services.",
  },
  {
    question: "Can you add WhatsApp and enquiry forms?",
    answer:
      "Yes. WhatsApp buttons, enquiry forms, click-to-call actions, email notifications, Google Maps, social links and other lead-generation integrations can be included according to the project requirements.",
  },
  {
    question: "Can I add new pages after the website launches?",
    answer:
      "Yes. A business website can be expanded with additional service pages, location pages, case studies, landing pages, blog content and custom features as your business grows.",
  },
  {
    question: "Do you build business websites only in Jaipur?",
    answer:
      "YNS Web Studio is based in Jaipur and works with businesses in Jaipur, Rajasthan and other locations across India. Projects can also be discussed remotely depending on the requirements.",
  },
];

const iconPaths = {
  arrow: `<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>`,
  check: `<path d="m5 12 4 4L19 6"></path>`,
  search: `<circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path>`,
  message: `<path d="M21 11.5a8.4 8.4 0 0 1-9 8.5 9.5 9.5 0 0 1-4-.9L3 21l1.9-4A8.4 8.4 0 0 1 3 11.5 8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5Z"></path>`,
  smartphone: `<rect x="7" y="2.5" width="10" height="19" rx="2"></rect><path d="M11 18.5h2"></path>`,
  zap: `<path d="m13 2-9 12h7l-1 8 9-12h-7l1-8Z"></path>`,
  layers: `<path d="m12 2 9 5-9 5-9-5 9-5Z"></path><path d="m3 12 9 5 9-5"></path><path d="m3 17 9 5 9-5"></path>`,
  code: `<path d="m8 9-3 3 3 3"></path><path d="m16 9 3 3-3 3"></path><path d="m14 5-4 14"></path>`,
  chart: `<path d="M4 19V5"></path><path d="M4 19h16"></path><path d="m7 15 3-4 3 2 5-7"></path>`,
  shield: `<path d="M12 3 20 6v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z"></path><path d="m9 12 2 2 4-4"></path>`,
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "YNS Web Studio",
      url: siteUrl,
      description:
        "Business website development company in Jaipur building responsive, SEO-ready websites for local businesses and growing companies.",
      areaServed: [
        {
          "@type": "City",
          name: "Jaipur",
        },
        {
          "@type": "State",
          name: "Rajasthan",
        },
        {
          "@type": "Country",
          name: "India",
        },
      ],
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: "Business Website Development",
      serviceType: "Business Website Development",
      provider: {
        "@id": `${siteUrl}/#organization`,
      },
      areaServed: [
        "Jaipur",
        "Rajasthan",
        "India",
      ],
      url: pageUrl,
      description:
        "Professional business website development in Jaipur focused on responsive design, technical SEO, clear messaging and lead generation.",
      offers: {
        "@type": "Offer",
        priceCurrency: "INR",
        price: "20000",
      },
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: "Business Website Development in Jaipur | YNS Web Studio",
      isPartOf: {
        "@id": `${siteUrl}/#website`,
      },
      about: {
        "@id": `${pageUrl}#service`,
      },
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: siteUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Services",
          item: `${siteUrl}/services`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Business Website Development",
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="Business Website Development in Jaipur | YNS Web Studio"
  description="Business website development in Jaipur for companies that need a professional, responsive and SEO-ready website designed to build trust and generate enquiries."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />

    <meta
      name="keywords"
      content="business website development Jaipur, business website developer Jaipur, business website design Jaipur, professional business website, website development company Jaipur, custom business website, responsive website development Jaipur"
    />

    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <meta
      property="og:title"
      content="Business Website Development in Jaipur | YNS Web Studio"
    />

    <meta
      property="og:description"
      content="Professional business websites designed for credibility, search visibility, mobile users and customer enquiries."
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />

    <meta name="twitter:card" content="summary_large_image" />

    <meta
      name="twitter:title"
      content="Business Website Development in Jaipur | YNS Web Studio"
    />

    <meta
      name="twitter:description"
      content="Professional, responsive and SEO-ready business websites built around your business goals."
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  </Fragment>

  <div class="business-page">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>

      <div class="container hero-container">

        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/services">Services</a>
          <span>/</span>
          <span aria-current="page">Business Website Development</span>
        </nav>

        <div class="hero-layout">

          <div class="hero-copy">

            <div class="eyebrow">
              <span class="eyebrow-dot"></span>
              Business Website Development in Jaipur
            </div>

            <h1>
              A professional website
              <em>built for your business.</em>
            </h1>

            <p class="hero-description">
              We design and develop responsive business websites for companies
              that want more than an online brochure. Your website should
              clearly explain what you offer, build trust, work smoothly on
              mobile and make it easy for potential customers to contact you.
            </p>

            <div class="hero-actions">
              <a
                href="https://wa.me/919352563337"
                target="_blank"
                rel="noopener noreferrer"
                class="button button-primary"
              >
                Discuss Your Website
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.arrow}></g>
                </svg>
              </a>

              <a href="#included" class="button button-secondary">
                See what's included
              </a>
            </div>

            <div class="hero-stats">
              <div>
                <strong>₹20K+</strong>
                <span>Starting investment</span>
              </div>

              <div>
                <strong>7–14</strong>
                <span>Typical working days</span>
              </div>

              <div>
                <strong>100%</strong>
                <span>Responsive experience</span>
              </div>
            </div>

          </div>

          <div class="hero-visual">

            <div class="visual-label visual-label-top">
              <span></span>
              BUSINESS WEBSITE
            </div>

            <div class="browser-window">

              <div class="browser-top">
                <div class="browser-controls">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <div class="browser-url">
                  <span class="lock">⌁</span>
                  yourbusiness.com
                </div>

                <div class="browser-menu">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>

              <div class="website-preview">

                <div class="preview-nav">
                  <div class="preview-brand">
                    <span class="brand-mark">Y</span>
                    <span>YOUR BRAND</span>
                  </div>

                  <div class="preview-links">
                    <span>Services</span>
                    <span>About</span>
                    <span>Work</span>
                    <span>Contact</span>
                  </div>

                  <div class="preview-nav-button">Let's Talk</div>
                </div>

                <div class="preview-hero">

                  <div class="preview-hero-copy">

                    <span class="mini-label">
                      YOUR BUSINESS. ONLINE.
                    </span>

                    <div class="preview-heading">
                      Build trust.
                      <br />
                      Get discovered.
                      <br />
                      <i>Grow.</i>
                    </div>

                    <div class="preview-lines">
                      <span></span>
                      <span></span>
                    </div>

                    <div class="preview-cta-row">
                      <span class="preview-button"></span>
                      <span class="preview-link"></span>
                    </div>

                  </div>

                  <div class="preview-visual-card">
                    <div class="visual-card-shape shape-one"></div>
                    <div class="visual-card-shape shape-two"></div>

                    <div class="visual-card-inner">
                      <span>01</span>
                      <strong>STRATEGY</strong>
                    </div>
                  </div>

                </div>

                <div class="preview-bottom">
                  <div>
                    <span>01</span>
                    <small>Clear positioning</small>
                  </div>

                  <div>
                    <span>02</span>
                    <small>Lead generation</small>
                  </div>

                  <div>
                    <span>03</span>
                    <small>SEO foundation</small>
                  </div>
                </div>

              </div>
            </div>

            <div class="floating-card floating-card-one">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.chart}></g>
                </svg>
              </span>

              <div>
                <strong>Conversion focused</strong>
                <small>Built to generate action</small>
              </div>
            </div>

            <div class="floating-card floating-card-two">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.shield}></g>
                </svg>
              </span>

              <div>
                <strong>SEO ready</strong>
                <small>Technical foundation</small>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>


    <!-- INTRO -->
    <section class="intro-section">

      <div class="container">

        <div class="intro-grid">

          <div class="section-number">01</div>

          <div class="intro-content">

            <p class="section-kicker">
              Business website development
            </p>

            <h2>
              Your website is part of
              <span>your customer journey.</span>
            </h2>

            <div class="intro-text-grid">

              <p>
                When someone hears about your business, one of the first
                things they may do is search for it online. Your website can
                influence whether that person trusts the business enough to
                call, message or request more information.
              </p>

              <p>
                A good business website therefore needs to do several things
                at once: explain your offer, establish credibility, answer
                common questions, work across devices and give visitors a
                clear next step.
              </p>

              <p>
                At YNS Web Studio, we approach website development around
                these business requirements instead of treating a website as
                simply a collection of attractive pages.
              </p>

              <p>
                The result is a website structure that connects your brand,
                content, services, search visibility and customer enquiries
                into one experience.
              </p>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- WHY BUSINESS WEBSITE -->
    <section class="benefits-section">

      <div class="container">

        <div class="split-heading">

          <div>

            <p class="section-kicker">
              Why businesses need a professional website
            </p>

            <h2>
              Build credibility.
              <br />
              <span>Create opportunities.</span>
            </h2>

          </div>

          <p>
            Your website should make it easier for a potential customer to
            understand your business and decide whether they should contact
            you.
          </p>

        </div>

        <div class="benefit-grid">

          {
            benefits.map((item, index) => (
              <article class="benefit-card">

                <div class="card-number">
                  0{index + 1}
                </div>

                <div class="card-icon">

                  <svg viewBox="0 0 24 24" aria-hidden="true">

                    <g
                      set:html={
                        [
                          iconPaths.message,
                          iconPaths.search,
                          iconPaths.smartphone,
                          iconPaths.layers,
                          iconPaths.shield,
                          iconPaths.code,
                        ][index]
                      }
                    ></g>

                  </svg>

                </div>

                <h3>{item.title}</h3>

                <p>{item.text}</p>

                <span class="card-arrow">

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.arrow}></g>
                  </svg>

                </span>

              </article>
            ))
          }

        </div>

      </div>

    </section>


    <!-- INCLUDED -->
    <section id="included" class="included-section">

      <div class="container">

        <div class="included-layout">

          <div class="included-intro">

            <div class="dark-kicker">
              <span></span>
              What's included
            </div>

            <h2>
              Everything you need for a
              <span>professional online presence.</span>
            </h2>

            <p>
              The exact scope depends on your business, but the website is
              planned around the pages, functionality and customer journey
              your project actually needs.
            </p>

            <a
              href="https://wa.me/919352563337"
              target="_blank"
              rel="noopener noreferrer"
              class="dark-button"
            >
              Get a project estimate

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.arrow}></g>
              </svg>

            </a>

          </div>

          <div class="feature-list">

            {
              features.map((feature, index) => (
                <div class="feature-item">

                  <span class="feature-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="feature-check">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <g set:html={iconPaths.check}></g>
                    </svg>

                  </span>

                  <span>{feature}</span>

                </div>
              ))
            }

          </div>

        </div>

      </div>

    </section>


    <!-- WEBSITE STRUCTURE -->
    <section class="pages-section">

      <div class="container">

        <div class="pages-header">

          <div>

            <p class="section-kicker">
              Website structure
            </p>

            <h2>
              Pages that answer questions
              <span>and move visitors forward.</span>
            </h2>

          </div>

          <p>
            Not every business needs the same number of pages. We choose the
            structure according to your services, audience, search strategy
            and conversion goals.
          </p>

        </div>

        <div class="page-grid">

          {
            pages.map((page) => (
              <article class="page-card">

                <div class="page-card-top">

                  <span>{page.number}</span>

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.layers}></g>
                  </svg>

                </div>

                <h3>{page.title}</h3>

                <p>{page.text}</p>

                <div class="page-line"></div>

              </article>
            ))
          }

        </div>

      </div>

    </section>


    <!-- SEO -->
    <section class="capabilities-section">

      <div class="container">

        <div class="capabilities-heading">

          <p class="section-kicker">
            SEO and website performance
          </p>

          <h2>
            Built with search visibility
            <span>in mind from the beginning.</span>
          </h2>

        </div>

        <div class="capability-grid">

          <article class="capability-card capability-featured">

            <div class="capability-number">01</div>

            <div class="capability-icon">

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.search}></g>
              </svg>

            </div>

            <h3>
              Technical SEO foundation
            </h3>

            <p>
              The website is structured with important technical foundations
              such as descriptive titles and metadata, semantic HTML, clean
              URLs, logical headings, crawlable content, internal linking and
              sitemap support.
            </p>

            <div class="capability-tags">
              <span>Metadata</span>
              <span>Structure</span>
              <span>Internal links</span>
            </div>

          </article>


          <article class="capability-card">

            <div class="capability-number">02</div>

            <div class="capability-icon">

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.message}></g>
              </svg>

            </div>

            <h3>
              Conversion-focused experience
            </h3>

            <p>
              Clear service information, enquiry forms, WhatsApp buttons,
              click-to-call actions and well-placed calls to action make it
              easier for interested visitors to take the next step.
            </p>

            <div class="capability-tags">
              <span>WhatsApp</span>
              <span>Forms</span>
              <span>CTA</span>
            </div>

          </article>


          <article class="capability-card">

            <div class="capability-number">03</div>

            <div class="capability-icon">

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.zap}></g>
              </svg>

            </div>

            <h3>
              Performance-conscious development
            </h3>

            <p>
              Responsive implementation, efficient assets and clean
              front-end architecture are considered throughout development
              so the website can provide a better experience across common
              devices.
            </p>

            <div class="capability-tags">
              <span>Responsive</span>
              <span>Performance</span>
              <span>Clean code</span>
            </div>

          </article>

        </div>

      </div>

    </section>


    <!-- LOCAL SEO -->
    <section class="usecases-section">

      <div class="container">

        <div class="usecases-layout">

          <div class="usecases-copy">

            <p class="section-kicker">
              Business website development in Jaipur
            </p>

            <h2>
              Built for local businesses
              <span>and growing companies.</span>
            </h2>

            <p>
              If your customers search for businesses in Jaipur, your website
              should clearly communicate your services, location, credibility
              and contact options.
            </p>

            <p>
              A well-structured website can also become the foundation for
              future service pages, location pages, blog content and local
              search visibility.
            </p>

            <div class="mini-stat">

              <strong>Local presence.</strong>

              <span>
                Clear information for customers who are ready to take action.
              </span>

            </div>

          </div>


          <div class="usecase-list">

            {
              useCases.map((item, index) => (
                <div class="usecase-item">

                  <span>
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <strong>{item}</strong>

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.arrow}></g>
                  </svg>

                </div>
              ))
            }

          </div>

        </div>

      </div>

    </section>


    <!-- PROCESS -->
    <section class="process-section">

