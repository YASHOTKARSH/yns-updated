---
import BaseLayout from "../../components/layout/BaseLayout.astro";

const siteUrl = "https://ynsweb.studio";
const pageUrl = `${siteUrl}/services/business-website-development`;

const benefits = [
  {
    title: "Built around enquiries",
    text: "Clear calls to action, enquiry flows and WhatsApp touchpoints help visitors understand what to do next.",
  },
  {
    title: "Search-friendly foundation",
    text: "Semantic structure, metadata, clean URLs, internal linking and performance-conscious development create a strong technical SEO base.",
  },
  {
    title: "Designed for mobile",
    text: "Your website is designed around real mobile browsing behaviour, not simply scaled down from desktop.",
  },
  {
    title: "Easy to grow",
    text: "The architecture leaves room for new pages, services, case studies, blogs, integrations and future features.",
  },
  {
    title: "Professional first impression",
    text: "A refined visual system helps your business look established, trustworthy and ready to work with serious customers.",
  },
  {
    title: "Made for your business",
    text: "No generic template-first approach. The structure, messaging and interface are shaped around your actual business goals.",
  },
];

const features = [
  "Custom responsive UI/UX",
  "5–10 core business pages",
  "WhatsApp and enquiry integration",
  "Technical SEO foundation",
  "Google Analytics and Search Console setup",
  "Fast, performance-conscious development",
  "Contact forms and lead capture",
  "Social media and Google Maps integration",
  "Production deployment",
  "Post-launch support options",
];

const pages = [
  {
    number: "01",
    title: "Home",
    text: "Position your business, communicate your value and guide visitors toward an enquiry.",
  },
  {
    number: "02",
    title: "About",
    text: "Build credibility with your story, expertise, team and business positioning.",
  },
  {
    number: "03",
    title: "Services",
    text: "Explain your offers clearly with dedicated sections and strong conversion paths.",
  },
  {
    number: "04",
    title: "Contact",
    text: "Make it simple for customers to call, message, submit an enquiry or find you.",
  },
  {
    number: "05",
    title: "Portfolio / Work",
    text: "Show proof through projects, case studies, testimonials and results.",
  },
  {
    number: "06",
    title: "Additional pages",
    text: "Add locations, industries, FAQs, blogs or service-specific pages as your business grows.",
  },
];

const process = [
  {
    number: "01",
    title: "Discovery",
    text: "We understand your business, audience, services, competitors and primary conversion goal.",
  },
  {
    number: "02",
    title: "Structure",
    text: "We map the pages, content hierarchy, calls to action and user journey before development.",
  },
  {
    number: "03",
    title: "Design",
    text: "We create a clean visual system that fits your brand and works across mobile, tablet and desktop.",
  },
  {
    number: "04",
    title: "Development",
    text: "The approved experience is developed with responsive, semantic and performance-conscious code.",
  },
  {
    number: "05",
    title: "SEO & QA",
    text: "We check metadata, responsive behaviour, links, forms, performance basics and technical details.",
  },
  {
    number: "06",
    title: "Launch",
    text: "Your website is deployed, connected to the required tools and prepared for ongoing growth.",
  },
];

const useCases = [
  "Local service businesses",
  "Consultants and professionals",
  "Agencies and studios",
  "Clinics and healthcare businesses",
  "Gyms and fitness studios",
  "Restaurants and cafés",
  "Hotels and homestays",
  "Real estate businesses",
  "Education and coaching businesses",
  "Startups and growing companies",
];

const faqs = [
  {
    question: "How much does a business website cost in Jaipur?",
    answer:
      "At YNS Web Studio, business website development typically starts from ₹20,000. The final cost depends on the number of pages, design complexity, content requirements, integrations and custom functionality. We provide a project-specific quote after understanding your requirements.",
  },
  {
    question: "How long does it take to build a business website?",
    answer:
      "A standard business website generally takes around 7–14 working days when the required content, branding and feedback are available on time. Larger websites or projects with custom functionality can take longer.",
  },
  {
    question: "What pages are included in a business website?",
    answer:
      "A typical website can include Home, About, Services, Contact and portfolio or case-study pages. Additional pages such as individual service pages, location pages, FAQs and a blog can be added based on your business and SEO strategy.",
  },
  {
    question: "Will my business website be mobile responsive?",
    answer:
      "Yes. Responsive development is a core part of the build. The website is designed and tested for mobile, tablet and desktop layouts so visitors can use it comfortably across common screen sizes.",
  },
  {
    question: "Is SEO included with business website development?",
    answer:
      "Yes, the website includes a technical SEO foundation such as semantic HTML, page metadata, clean URL structure, responsive implementation, internal linking considerations and sitemap support. Ongoing SEO and content marketing are separate services when required.",
  },
  {
    question: "Can you add WhatsApp and enquiry forms?",
    answer:
      "Yes. WhatsApp CTAs, enquiry forms, click-to-call actions, email notifications, Google Maps and other lead-generation integrations can be included based on the project requirements.",
  },
  {
    question: "Can I add more pages later?",
    answer:
      "Yes. We can expand the website with new service pages, locations, case studies, blog content, landing pages and custom features as your business grows.",
  },
  {
    question: "Do you provide website maintenance after launch?",
    answer:
      "Yes. Basic post-launch support can be included depending on the project. Ongoing maintenance, content updates, technical improvements and new feature development can also be arranged separately.",
  },
];

const iconPaths = {
  arrow: `<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>`,
  check: `<path d="m5 12 4 4L19 6"></path>`,
  globe: `<circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3a14 14 0 0 1 0 18"></path><path d="M12 3a14 14 0 0 0 0 18"></path>`,
  search: `<circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path>`,
  message: `<path d="M21 11.5a8.4 8.4 0 0 1-9 8.5 9.5 9.5 0 0 1-4-.9L3 21l1.9-4A8.4 8.4 0 0 1 3 11.5 8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5Z"></path>`,
  smartphone: `<rect x="7" y="2.5" width="10" height="19" rx="2"></rect><path d="M11 18.5h2"></path>`,
  zap: `<path d="m13 2-9 12h7l-1 8 9-12h-7l1-8Z"></path>`,
  layers: `<path d="m12 2 9 5-9 5-9-5 9-5Z"></path><path d="m3 12 9 5 9-5"></path><path d="m3 17 9 5 9-5"></path>`,
  code: `<path d="m8 9-3 3 3 3"></path><path d="m16 9 3 3-3 3"></path><path d="m14 5-4 14"></path>`,
  chart: `<path d="M4 19V5"></path><path d="M4 19h16"></path><path d="m7 15 3-4 3 2 5-7"></path>`,
  shield: `<path d="M12 3 20 6v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z"></path><path d="m9 12 2 2 4-4"></path>`,
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "YNS Web Studio",
      url: siteUrl,
      description:
        "Business website development company in Jaipur building responsive, SEO-ready websites for local businesses and growing companies.",
      areaServed: ["Jaipur", "Rajasthan", "India"],
      serviceType: "Business Website Development",
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: "Business Website Development",
      serviceType: "Business Website Development",
      provider: {
        "@id": `${siteUrl}/#organization`,
      },
      areaServed: ["Jaipur", "Rajasthan", "India"],
      url: pageUrl,
      description:
        "Custom responsive business website development in Jaipur with technical SEO, lead generation, WhatsApp integration and production deployment.",
      offers: {
        "@type": "Offer",
        priceCurrency: "INR",
        price: "20000",
      },
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: "Business Website Development in Jaipur | YNS Web Studio",
      isPartOf: {
        "@id": `${siteUrl}/#website`,
      },
      about: {
        "@id": `${pageUrl}#service`,
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: siteUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Services",
          item: `${siteUrl}/services`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Business Website Development",
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="Business Website Development in Jaipur | YNS Web Studio"
  description="YNS Web Studio builds fast, responsive and SEO-ready business websites in Jaipur. Get a custom website designed to build trust, generate enquiries and grow your business."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta
      name="keywords"
      content="business website development Jaipur, business website design Jaipur, website development company Jaipur, web design company Jaipur, custom business website, responsive website development, SEO website development Jaipur"
    />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <meta
      property="og:title"
      content="Business Website Development in Jaipur | YNS Web Studio"
    />
    <meta
      property="og:description"
      content="Custom business websites designed for credibility, search visibility and enquiries. Serving Jaipur and businesses across India."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Business Website Development in Jaipur | YNS Web Studio"
    />
    <meta
      name="twitter:description"
      content="Fast, responsive and SEO-ready business websites built for growth."
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="business-page">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>

      <div class="container hero-container">

        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/services">Services</a>
          <span>/</span>
          <span aria-current="page">Business Website Development</span>
        </nav>

        <div class="hero-layout">

          <div class="hero-copy">

            <div class="eyebrow">
              <span class="eyebrow-dot"></span>
              Business Website Development in Jaipur
            </div>

            <h1>
              A website that makes your business
              <em>look credible.</em>
            </h1>

            <p class="hero-description">
              We design and develop custom business websites for companies
              that need more than an online brochure. Your website should
              explain what you do, build trust, perform on mobile and make
              it easy for the right customer to contact you.
            </p>

            <div class="hero-actions">
              <a
                href="https://wa.me/919352563337"
                target="_blank"
                rel="noopener noreferrer"
                class="button button-primary"
              >
                Discuss Your Website
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.arrow}></g>
                </svg>
              </a>

              <a href="#included" class="button button-secondary">
                Explore what's included
              </a>
            </div>

            <div class="hero-stats">
              <div>
                <strong>₹20K+</strong>
                <span>Starting investment</span>
              </div>
              <div>
                <strong>7–14</strong>
                <span>Typical working days</span>
              </div>
              <div>
                <strong>100%</strong>
                <span>Responsive experience</span>
              </div>
            </div>

          </div>

          <!-- WEBSITE PREVIEW -->
          <div class="hero-visual">

            <div class="visual-label visual-label-top">
              <span></span>
              YOUR DIGITAL PRESENCE
            </div>

            <div class="browser-window">

              <div class="browser-top">
                <div class="browser-controls">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <div class="browser-url">
                  <span class="lock">⌁</span>
                  yourbusiness.com
                </div>

                <div class="browser-menu">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>

              <div class="website-preview">

                <div class="preview-nav">
                  <div class="preview-brand">
                    <span class="brand-mark">Y</span>
                    <span>YOUR BRAND</span>
                  </div>

                  <div class="preview-links">
                    <span>Services</span>
                    <span>About</span>
                    <span>Work</span>
                    <span>Contact</span>
                  </div>

                  <div class="preview-nav-button">Let's Talk</div>
                </div>

                <div class="preview-hero">
                  <div class="preview-hero-copy">
                    <span class="mini-label">YOUR BUSINESS. ONLINE.</span>

                    <div class="preview-heading">
                      Build trust.
                      <br />
                      Get discovered.
                      <br />
                      <i>Grow.</i>
                    </div>

                    <div class="preview-lines">
                      <span></span>
                      <span></span>
                    </div>

                    <div class="preview-cta-row">
                      <span class="preview-button"></span>
                      <span class="preview-link"></span>
                    </div>
                  </div>

                  <div class="preview-visual-card">
                    <div class="visual-card-shape shape-one"></div>
                    <div class="visual-card-shape shape-two"></div>
                    <div class="visual-card-inner">
                      <span>01</span>
                      <strong>STRATEGY</strong>
                    </div>
                  </div>
                </div>

                <div class="preview-bottom">
                  <div>
                    <span>01</span>
                    <small>Clear positioning</small>
                  </div>
                  <div>
                    <span>02</span>
                    <small>Lead generation</small>
                  </div>
                  <div>
                    <span>03</span>
                    <small>SEO foundation</small>
                  </div>
                </div>

              </div>
            </div>

            <div class="floating-card floating-card-one">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.chart}></g>
                </svg>
              </span>
              <div>
                <strong>Conversion focused</strong>
                <small>Built to generate action</small>
              </div>
            </div>

            <div class="floating-card floating-card-two">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.shield}></g>
                </svg>
              </span>
              <div>
                <strong>SEO ready</strong>
                <small>Technical foundation</small>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="intro-section">
      <div class="container">
        <div class="intro-grid">

          <div class="section-number">01</div>

          <div class="intro-content">
            <p class="section-kicker">Why your website matters</p>

            <h2>
              Your website is part of
              <span>your sales process.</span>
            </h2>

            <div class="intro-text-grid">
              <p>
                Before someone calls, messages or visits your business,
                they may first check your website. A weak website can create
                doubt. A clear, modern and useful website can answer
                questions, establish credibility and move a potential
                customer closer to an enquiry.
              </p>

              <p>
                That is why we do not treat business website development as
                a simple page-building exercise. We combine design,
                development, technical SEO and conversion-focused structure
                into one digital experience.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- BENEFITS -->
    <section class="benefits-section">
      <div class="container">

        <div class="section-heading split-heading">
          <div>
            <p class="section-kicker">The YNS approach</p>
            <h2>Built to work for<br /><span>your business.</span></h2>
          </div>

          <p>
            A professional website is not only about visual design. It has
            to communicate clearly, work smoothly and create a path toward
            action.
          </p>
        </div>

        <div class="benefit-grid">
          {
            benefits.map((item, index) => (
              <article class="benefit-card">
                <div class="card-number">0{index + 1}</div>

                <div class="card-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g
                      set:html={
                        [
                          iconPaths.message,
                          iconPaths.search,
                          iconPaths.smartphone,
                          iconPaths.layers,
                          iconPaths.shield,
                          iconPaths.code,
                        ][index]
                      }
                    ></g>
                  </svg>
                </div>

                <h3>{item.title}</h3>
                <p>{item.text}</p>

                <span class="card-arrow">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.arrow}></g>
                  </svg>
                </span>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- INCLUDED -->
    <section id="included" class="included-section">
      <div class="container">

        <div class="included-layout">

          <div class="included-intro">
            <div class="dark-kicker">
              <span></span>
              What's included
            </div>

            <h2>
              Everything you need for a
              <span>professional website.</span>
            </h2>

            <p>
              The exact scope is tailored to your business, but every
              project starts with a strong foundation rather than a
              collection of disconnected pages.
            </p>

            <a
              href="https://wa.me/919352563337"
              target="_blank"
              rel="noopener noreferrer"
              class="dark-button"
            >
              Get a project estimate
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.arrow}></g>
              </svg>
            </a>
          </div>

          <div class="feature-list">
            {
              features.map((feature, index) => (
                <div class="feature-item">
                  <span class="feature-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="feature-check">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <g set:html={iconPaths.check}></g>
                    </svg>
                  </span>

                  <span>{feature}</span>
                </div>
              ))
            }
          </div>

        </div>
      </div>
    </section>

    <!-- WEBSITE STRUCTURE -->
    <section class="pages-section">
      <div class="container">

        <div class="pages-header">
          <div>
            <p class="section-kicker">Website structure</p>
            <h2>
              Pages designed to answer questions
              <span>and move visitors forward.</span>
            </h2>
          </div>

          <p>
            Your website structure depends on your business. These are
            common building blocks that can be combined into a focused,
            conversion-friendly experience.
          </p>
        </div>

        <div class="page-grid">
          {
            pages.map((page) => (
              <article class="page-card">
                <div class="page-card-top">
                  <span>{page.number}</span>

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.layers}></g>
                  </svg>
                </div>

                <h3>{page.title}</h3>
                <p>{page.text}</p>

                <div class="page-line"></div>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- SEO / CONVERSION -->
    <section class="capabilities-section">
      <div class="container">

        <div class="capabilities-heading">
          <p class="section-kicker">More than design</p>
          <h2>
            The details behind a website
            <span>that performs.</span>
          </h2>
        </div>

        <div class="capability-grid">

          <article class="capability-card capability-featured">
            <div class="capability-number">01</div>

            <div class="capability-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.search}></g>
              </svg>
            </div>

            <h3>Technical SEO foundation</h3>

            <p>
              Clean page structure, descriptive metadata, crawlable
              content, responsive layouts, internal linking and sitemap
              support give search engines a clearer understanding of your
              website.
            </p>

            <div class="capability-tags">
              <span>Metadata</span>
              <span>Clean URLs</span>
              <span>Structure</span>
            </div>
          </article>

          <article class="capability-card">
            <div class="capability-number">02</div>

            <div class="capability-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.message}></g>
              </svg>
            </div>

            <h3>Conversion-focused UX</h3>

            <p>
              Strategic calls to action, enquiry forms, WhatsApp buttons,
              click-to-call actions and clear service information reduce
              friction between interest and contact.
            </p>

            <div class="capability-tags">
              <span>WhatsApp</span>
              <span>Forms</span>
              <span>CTA</span>
            </div>
          </article>

          <article class="capability-card">
            <div class="capability-number">03</div>

            <div class="capability-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.zap}></g>
              </svg>
            </div>

            <h3>Performance-conscious development</h3>

            <p>
              We keep responsive implementation, efficient assets and
              clean front-end architecture in mind so your website can
              provide a better experience across devices.
            </p>

            <div class="capability-tags">
              <span>Responsive</span>
              <span>Fast</span>
              <span>Clean code</span>
            </div>
          </article>

        </div>

      </div>
    </section>

    <!-- USE CASES -->
    <section class="usecases-section">
      <div class="container">

        <div class="usecases-layout">

          <div class="usecases-copy">
            <p class="section-kicker">Who it's for</p>

            <h2>
              Built for businesses that need a
              <span>stronger digital presence.</span>
            </h2>

            <p>
              From local businesses to growing companies, we build websites
              around the information your customers actually need before
              they decide to contact you.
            </p>

            <div class="mini-stat">
              <strong>One website.</strong>
              <span>Multiple ways to turn attention into enquiries.</span>
            </div>
          </div>

          <div class="usecase-list">
            {
              useCases.map((item, index) => (
                <div class="usecase-item">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{item}</strong>

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.arrow}></g>
                  </svg>
                </div>
              ))
            }
          </div>

        </div>

      </div>
    </section>

    <!-- PROCESS -->
    <section class="process-section">
      <div class="container">

        <div class="process-header">
          <p class="section-kicker">Our process</p>

          <h2>
            From business requirement
            <span>to launched website.</span>
          </h2>

          <p>
            A clear process keeps the project focused, reduces unnecessary
            revisions and ensures the final website supports the business
            goal.
          </p>
        </div>

        <div class="process-grid">
          {
            process.map((step, index) => (
              <article class="process-card">
                <div class="process-top">
                  <span>{step.number}</span>

                  {index < process.length - 1 && (
                    <div class="process-connector"></div>
                  )}
                </div>

                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- PRICING -->
    <section class="pricing-section">
      <div class="container">

        <div class="pricing-layout">

          <div class="pricing-copy">
            <p class="dark-kicker">
              <span></span>
              Starting investment
            </p>

            <h2>
              Business websites from
