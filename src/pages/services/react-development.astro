---
import BaseLayout from "../../components/layout/BaseLayout.astro";

const siteUrl = "https://ynsweb.studio";
const pageUrl = `${siteUrl}/services/react-development`;

const features = [
  {
    title: "Modern React Interfaces",
    text: "Build interactive, component-driven interfaces that are fast, maintainable and designed around your users.",
  },
  {
    title: "Reusable Components",
    text: "Create structured UI systems that reduce duplication and make future features easier to develop and maintain.",
  },
  {
    title: "API Integration",
    text: "Connect React applications with REST APIs, databases, authentication systems and third-party services.",
  },
  {
    title: "Interactive Dashboards",
    text: "Build data-rich dashboards, admin panels and internal tools with practical navigation and responsive layouts.",
  },
  {
    title: "Responsive Experiences",
    text: "Deliver consistent interfaces across mobile, tablet and desktop with layouts designed for real-world usage.",
  },
  {
    title: "Performance-Focused Development",
    text: "Use sensible component architecture, optimized assets and efficient rendering patterns to keep applications responsive.",
  },
];

const useCases = [
  "Business Web Applications",
  "SaaS Products",
  "Admin Dashboards",
  "Customer Portals",
  "Startup MVPs",
  "Interactive Websites",
  "Internal Tools",
  "Booking Platforms",
  "Data Dashboards",
  "Custom UI Systems",
];

const process = [
  {
    number: "01",
    title: "Requirements",
    text: "Understand the product, target users, features, existing systems and business goals.",
  },
  {
    number: "02",
    title: "Architecture",
    text: "Plan the component structure, application flow, API requirements and technical approach.",
  },
  {
    number: "03",
    title: "UI Development",
    text: "Build responsive React components with a clean and reusable interface structure.",
  },
  {
    number: "04",
    title: "Integration",
    text: "Connect APIs, authentication, databases and required third-party services.",
  },
  {
    number: "05",
    title: "Testing & Optimization",
    text: "Test key interactions, responsive behaviour, performance and production workflows.",
  },
  {
    number: "06",
    title: "Launch",
    text: "Deploy the application and provide the foundation for future improvements and scaling.",
  },
];

const stack = [
  "React",
  "JavaScript",
  "TypeScript",
  "Vite",
  "Next.js",
  "Tailwind CSS",
  "Node.js",
  "Express",
  "REST APIs",
  "MongoDB",
  "PostgreSQL",
  "Git",
];

const faqs = [
  {
    question: "How much does React development cost?",
    answer:
      "React development at YNS Web Studio starts from ₹50,000. The final cost depends on the number of screens, functionality, API integrations, authentication, backend requirements and overall project scope.",
  },
  {
    question: "What can you build with React?",
    answer:
      "We can build business applications, SaaS interfaces, dashboards, customer portals, interactive websites, startup MVPs, internal tools and other custom web experiences.",
  },
  {
    question: "Can you integrate an existing API with React?",
    answer:
      "Yes. React applications can be connected with REST APIs, authentication services, databases and third-party platforms based on your existing architecture.",
  },
  {
    question: "Can you convert my existing website to React?",
    answer:
      "Yes. Existing websites can be migrated to React when there is a clear technical or product benefit. We first review the current website and recommend the appropriate migration approach.",
  },
  {
    question: "Do you use Next.js with React?",
    answer:
      "Yes. React is the core UI library, while Next.js can be used when the project benefits from routing, server-side capabilities, SEO requirements, full-stack features or a larger application architecture.",
  },
  {
    question: "Can you build a React admin dashboard?",
    answer:
      "Yes. We can build responsive admin dashboards with authentication, role-based interfaces, tables, filters, charts, forms, API integrations and management workflows.",
  },
  {
    question: "How long does a React project take?",
    answer:
      "Project timelines vary by scope. A focused React application can take a few weeks, while larger products with backend systems, integrations and multiple user roles may require several development milestones.",
  },
  {
    question: "Do you provide support after launch?",
    answer:
      "Yes. Post-launch bug fixes, maintenance, performance improvements, integrations and new feature development can be handled as ongoing work.",
  },
];

const relatedServices = [
  { title: "Next.js Development", href: "/services/nextjs-development" },
  { title: "Custom Web Development", href: "/services/custom-web-development" },
  { title: "Business Website Development", href: "/services/business-website-development" },
  { title: "E-Commerce Website Development", href: "/services/ecommerce-development" },
];

const iconPaths = {
  arrow: `<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>`,
  check: `<path d="m5 12 4 4L19 6"></path>`,
  layers: `<path d="m12 2 9 5-9 5-9-5 9-5Z"></path><path d="m3 12 9 5 9-5"></path><path d="m3 17 9 5 9-5"></path>`,
  shield: `<path d="M12 3 20 6v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z"></path><path d="m9 12 2 2 4-4"></path>`,
  chart: `<path d="M4 19V5"></path><path d="M4 19h16"></path><path d="m7 15 3-4 3 2 5-7"></path>`,
  search: `<circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path>`,
  code: `<path d="m8 9-3 3 3 3"></path><path d="m16 9 3 3-3 3"></path><path d="m14 5-4 14"></path>`,
  zap: `<path d="m13 2-9 12h7l-1 8 9-12h-7l1-8Z"></path>`,
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "YNS Web Studio",
      url: siteUrl,
      description:
        "React development company in Jaipur building interactive component-driven business applications, SaaS products, and dashboards.",
      areaServed: ["Jaipur", "Rajasthan", "India"],
      serviceType: "React Development Services",
    },
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: "React Development Services",
      serviceType: "React Development",
      provider: {
        "@id": `${siteUrl}/#organization`,
      },
      areaServed: ["Jaipur", "Rajasthan", "India"],
      url: pageUrl,
      description:
        "React development services for business applications, SaaS products, dashboards, portals, startup MVPs and interactive web experiences by YNS Web Studio.",
      offers: {
        "@type": "Offer",
        priceCurrency: "INR",
        price: "50000",
      },
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: "React Development Company Jaipur | YNS Web Studio",
      isPartOf: {
        "@id": `${siteUrl}/#website`,
      },
      about: {
        "@id": `${pageUrl}#service`,
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: siteUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Services",
          item: `${siteUrl}/services`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "React Development",
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="React Development Company Jaipur | YNS Web Studio"
  description="YNS Web Studio provides React development services in Jaipur for business applications, SaaS products, dashboards, portals, startup MVPs and interactive web experiences."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta
      name="keywords"
      content="React development Jaipur, React development company Jaipur, frontend developer Jaipur, React.js agency Jaipur, custom web app development Jaipur"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="React Development Company Jaipur | YNS Web Studio" />
    <meta
      property="og:description"
      content="React development services for business applications, SaaS products, dashboards, portals, startup MVPs and interactive web experiences."
    />
    <meta property="og:url" content={pageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="React Development Company Jaipur | YNS Web Studio" />
    <meta
      property="og:description"
      content="React development services for business applications, SaaS products, dashboards, portals, startup MVPs and interactive web experiences."
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="business-page">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>

      <div class="container hero-container">

        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/services">Services</a>
          <span>/</span>
          <span aria-current="page">React Development</span>
        </nav>

        <div class="hero-layout">

          <div class="hero-copy">

            <div class="eyebrow">
              <span class="eyebrow-dot"></span>
              React Development Services in Jaipur
            </div>

            <h1>
              React Applications Built for
              <em>Modern Digital Products.</em>
            </h1>

            <p class="hero-description">
              Build fast, interactive and maintainable web applications with React — from business dashboards and SaaS products to customer portals and startup MVPs.
            </p>

            <div class="hero-actions">
              <a
                href="https://wa.me/919352563337"
                target="_blank"
                rel="noopener noreferrer"
                class="button button-primary"
              >
                Start a React Project
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.arrow}></g>
                </svg>
              </a>

              <a href="#capabilities" class="button button-secondary">
                Explore capabilities
              </a>
            </div>

            <div class="hero-stats">
              <div>
                <strong>₹50K+</strong>
                <span>Starting investment</span>
              </div>
              <div>
                <strong>2–6</strong>
                <span>Typical weeks</span>
              </div>
              <div>
                <strong>100%</strong>
                <span>Component-driven</span>
              </div>
            </div>

          </div>

          <!-- WEBSITE PREVIEW -->
          <div class="hero-visual">

            <div class="visual-label visual-label-top">
              <span></span>
              COMPONENT-DRIVEN UI
            </div>

            <div class="browser-window">

              <div class="browser-top">
                <div class="browser-controls">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <div class="browser-url">
                  <span class="lock">⌁</span>
                  app.reactproduct.io
                </div>

                <div class="browser-menu">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>

              <div class="website-preview">

                <div class="preview-nav">
                  <div class="preview-brand">
                    <span class="brand-mark">Y</span>
                    <span>REACT UI</span>
                  </div>

                  <div class="preview-links">
                    <span>Components</span>
                    <span>State</span>
                    <span>Hooks</span>
                  </div>

                  <div class="preview-nav-button">v18.3</div>
                </div>

                <div class="preview-hero">
                  <div class="preview-hero-copy">
                    <span class="mini-label">VIRTUAL DOM</span>

                    <div class="preview-heading">
                      Interactive.
                      <br />
                      Modular.
                      <br />
                      <i>Scalable.</i>
                    </div>

                    <div class="preview-lines">
                      <span></span>
                      <span></span>
                    </div>

                    <div class="preview-cta-row">
                      <span class="preview-button"></span>
                      <span class="preview-link"></span>
                    </div>
                  </div>

                  <div class="preview-visual-card">
                    <div class="visual-card-shape shape-one"></div>
                    <div class="visual-card-shape shape-two"></div>
                    <div class="visual-card-inner">
                      <span>JSX</span>
                      <strong>OPTIMIZED</strong>
                    </div>
                  </div>
                </div>

                <div class="preview-bottom">
                  <div>
                    <span>01</span>
                    <small>State Management</small>
                  </div>
                  <div>
                    <span>02</span>
                    <small>REST API Client</small>
                  </div>
                  <div>
                    <span>03</span>
                    <small>Tailwind CSS</small>
                  </div>
                </div>

              </div>
            </div>

            <div class="floating-card floating-card-one">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.code}></g>
                </svg>
              </span>
              <div>
                <strong>Component Architecture</strong>
                <small>Reusable & maintainable</small>
              </div>
            </div>

            <div class="floating-card floating-card-two">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.zap}></g>
                </svg>
              </span>
              <div>
                <strong>High Performance</strong>
                <small>Optimized rendering</small>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="intro-section">
      <div class="container">
        <div class="intro-grid">

          <div class="section-number">01</div>

          <div class="intro-content">
            <p class="section-kicker">Why React</p>

            <h2>
              Build interfaces that can grow
              <span>with your product.</span>
            </h2>

            <div class="intro-text-grid">
              <p>
                React makes it possible to break complex interfaces into reusable components and build interactive experiences without turning the codebase into a collection of duplicated screens.
              </p>

              <p>
                We use React where a project benefits from a dynamic interface, reusable UI architecture and application-style interactions — while choosing the surrounding tools based on the actual requirements.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- CAPABILITIES -->
    <section id="capabilities" class="benefits-section">
      <div class="container">

        <div class="section-heading split-heading">
          <div>
            <p class="section-kicker">Capabilities</p>
            <h2>Practical React development<br /><span>for real products.</span></h2>
          </div>

          <p>
            Component-driven architecture built for high performance, ease of maintenance and long-term scalability.
          </p>
        </div>

        <div class="benefit-grid">
          {
            features.map((item, index) => (
              <article class="benefit-card">
                <div class="card-number">0{index + 1}</div>

                <div class="card-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g
                      set:html={
                        [
                          iconPaths.code,
                          iconPaths.layers,
                          iconPaths.search,
                          iconPaths.chart,
                          iconPaths.zap,
                          iconPaths.shield,
                        ][index]
                      }
                    ></g>
                  </svg>
                </div>

                <h3>{item.title}</h3>
                <p>{item.text}</p>

                <span class="card-arrow">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.arrow}></g>
                  </svg>
                </span>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- USE CASES -->
    <section class="usecases-section">
      <div class="container">

        <div class="usecases-layout">

          <div class="usecases-copy">
            <p class="section-kicker">What we build</p>

            <h2>
              From focused interfaces
              <span>to complete React products.</span>
            </h2>

            <p>
              The architecture is selected around the product. A simple interface stays simple, while a larger application can be structured for APIs, authentication, data and future features.
            </p>

            <div class="mini-stat">
              <strong>Modular UI.</strong>
              <span>Built for fast rendering and maintainable codebases.</span>
            </div>
          </div>

          <div class="usecase-list">
            {
              useCases.map((item, index) => (
                <div class="usecase-item">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{item}</strong>

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g set:html={iconPaths.arrow}></g>
                  </svg>
                </div>
              ))
            }
          </div>

        </div>

      </div>
    </section>

    <!-- TECHNOLOGY -->
    <section class="included-section">
      <div class="container">

        <div class="included-layout">

          <div class="included-intro">
            <div class="dark-kicker">
              <span></span>
              React + modern stack
            </div>

            <h2>
              Use the right tools
              <span>around React.</span>
            </h2>

            <p>
              React handles the interface layer. Depending on the project, we can combine it with Next.js, Vite, Tailwind CSS, Node.js, Express, databases and APIs to create the complete application.
            </p>

            <a
              href="https://wa.me/919352563337"
              target="_blank"
              rel="noopener noreferrer"
              class="dark-button"
            >
              Discuss technical stack
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.arrow}></g>
              </svg>
            </a>
          </div>

          <div class="feature-list">
            {
              stack.map((tech, index) => (
                <div class="feature-item">
                  <span class="feature-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="feature-check">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <g set:html={iconPaths.check}></g>
                    </svg>
                  </span>

                  <span>{tech}</span>
                </div>
              ))
            }
          </div>

        </div>
      </div>
    </section>

    <!-- PRODUCT QUALITY -->
    <section class="pages-section">
      <div class="container">

        <div class="pages-header">
          <div>
            <p class="section-kicker">Product quality</p>
            <h2>
              Clean components. Clear structure.
              <span>Better iteration.</span>
            </h2>
          </div>

          <p>
            Engineering standards that ensure your React application remains high-performing, clean and easy to scale.
          </p>
        </div>

        <div class="page-grid">
          {[
            { number: "01", title: "Reusable components", text: "Reusable components make it easier to maintain consistent interfaces as the product grows." },
            { number: "02", title: "Responsive design", text: "Responsive design ensures application screens remain practical across different devices." },
            { number: "03", title: "API-ready architecture", text: "API-ready architecture keeps frontend and backend responsibilities organized." },
            { number: "04", title: "Performance considerations", text: "Performance considerations are included throughout development rather than treated as an afterthought." },
            { number: "05", title: "State management", text: "Predictable data flow and robust state handling across application workflows." },
            { number: "06", title: "Testing & deployment", text: "Thorough testing of user interactions and seamless production deployment." },
          ].map((item) => (
            <article class="page-card">
              <div class="page-card-top">
                <span>{item.number}</span>

                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.arrow}></g>
                </svg>
              </div>

              <h3>{item.title}</h3>
              <p>{item.text}</p>

              <div class="page-line"></div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- PROCESS -->
    <section class="process-section">
      <div class="container">

        <div class="process-header">
          <p class="section-kicker">Our process</p>

          <h2>
            A structured React
            <span>development workflow.</span>
          </h2>

          <p>
            Clear development milestones keep your product on schedule and aligned with technical standards.
          </p>
        </div>

        <div class="process-grid">
          {
            process.map((step, index) => (
              <article class="process-card">
                <div class="process-top">
                  <span>{step.number}</span>

                  {index < process.length - 1 && (
                    <div class="process-connector"></div>
                  )}
                </div>

                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- PRICING -->
    <section class="pricing-section">
      <div class="container">

        <div class="pricing-layout">

          <div class="pricing-copy">
            <p class="dark-kicker">
              <span></span>
              Starting investment
            </p>

            <h2>
              React development from
              <strong>₹50,000+</strong>
            </h2>

            <p>
              Project pricing depends on the number of screens, application complexity, backend requirements, integrations, authentication and custom functionality. Larger products are scoped through milestones.
            </p>

            <div class="pricing-note">
              <span class="pricing-note-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.shield}></g>
                </svg>
              </span>

              <div>
                <strong>Transparent scoping</strong>
                <span>
                  Receive a detailed project scope before any development begins.
                </span>
              </div>
            </div>
          </div>

          <div class="pricing-panel">

            <div class="pricing-option featured-price">
              <div>
                <span class="pricing-label">React Development</span>
                <strong>₹50,000+</strong>
                <p>Component-driven UI, state management & API integration.</p>
              </div>

              <span class="pricing-badge">Starting</span>
            </div>

            <div class="pricing-option">
              <div>
                <span class="pricing-label">Full-Stack React Product</span>
                <strong>Custom quote</strong>
                <p>Backend API, database architecture & authentication.</p>
              </div>
            </div>

            <div class="pricing-option">
              <div>
                <span class="pricing-label">Ongoing support</span>
                <strong>Custom</strong>
                <p>Maintenance, updates and feature enhancements.</p>
              </div>
            </div>

            <a
              href="https://wa.me/919352563337"
              target="_blank"
              rel="noopener noreferrer"
              class="pricing-button"
            >
              Get a Project Estimate
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.arrow}></g>
              </svg>
            </a>

          </div>

        </div>

      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="faq-section">
      <div class="container faq-container">

        <div class="faq-heading">
          <p class="section-kicker">FAQ</p>

          <h2>
            React development
            <span>questions.</span>
          </h2>

          <p>
            Everything you should know before starting your React project.
          </p>
        </div>

        <div class="faq-list">
          {
            faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>
                  <span class="faq-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="faq-question">{faq.question}</span>

                  <span class="faq-toggle">
                    <span></span>
                    <span></span>
                  </span>
                </summary>

                <div class="faq-answer">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))
          }
        </div>

      </div>
    </section>

    <!-- RELATED SERVICES -->
    <section class="related-section">
      <div class="container">

        <div class="related-header">
          <div>
            <p class="section-kicker">Explore more</p>
            <h2>Looking for something else?</h2>
          </div>

          <a href="/services" class="text-link">
            View all services
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <g set:html={iconPaths.arrow}></g>
            </svg>
          </a>
        </div>

        <div class="related-grid">

          {
            relatedServices.map((service, index) => (
              <a href={service.href} class="related-card">
                <span>0{index + 1}</span>
                <h3>{service.title}</h3>
