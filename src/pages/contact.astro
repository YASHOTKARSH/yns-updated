---
import BaseLayout from "../components/layout/BaseLayout.astro";
---

<BaseLayout
  title="Contact YNS Web Studio Jaipur | Get Free Website Audit"
  description="Get in touch with YNS Web Studio in Jaipur to discuss your website project, request a free website audit, and start generating more business enquiries."
>

  <!-- Header Section -->
  <section class="relative bg-gradient-to-b from-slate-50 via-white to-slate-50 py-24 md:py-32 overflow-hidden border-b border-slate-100 text-center">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-96 h-96 bg-emerald-100/50 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-6 relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-xs font-semibold text-slate-700 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Direct Collaboration • Free Consultation
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
        Let’s Talk About <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-600">Your Website</span>
      </h1>

      <p class="mt-6 text-lg md:text-xl text-slate-600 max-w-2xl mx-auto font-normal leading-relaxed">
        Tell us about your local business in Jaipur and we’ll guide you on the best web structure to turn casual visitors into predictable, high-value enquiries.
      </p>
    </div>
  </section>

  <!-- Contact Options Section -->
  <section class="py-24 bg-gradient-to-b from-white via-slate-50/50 to-white border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

      <!-- WhatsApp Card (5 Cols) -->
      <div class="lg:col-span-5 bg-white p-8 md:p-10 rounded-2xl border border-slate-200/85 shadow-sm hover:shadow-xl hover:border-emerald-200 transition-all duration-300 text-left flex flex-col justify-between h-full">
        <div>
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-lg mb-6">
            💬
          </div>
          <h2 class="text-2xl font-bold text-slate-900">
            Quickest Response: WhatsApp
          </h2>
          <p class="mt-4 text-slate-600 text-base leading-relaxed">
            Skip the inbox wait. Get instant replies, direct developer consultation, and a free website audit directly on WhatsApp.
          </p>
          <div class="mt-6 pt-6 border-t border-slate-100 space-y-2 text-sm text-slate-700 font-medium">
            <p>✓ Average response time: Under 15 mins</p>
            <p>✓ Direct chat with developer Yashotkarsh</p>
            <p>✓ No long forms or waiting</p>
          </div>
        </div>

        <div class="mt-10">
          <a
            href="https://wa.me/919352563337"
            target="_blank"
            class="w-full inline-flex items-center justify-center rounded-xl bg-emerald-600 text-white px-6 py-4 font-bold hover:bg-emerald-700 transition shadow-lg shadow-emerald-600/20"
          >
            Message on WhatsApp Now
          </a>
        </div>
      </div>

      <!-- Contact Form (7 Cols) -->
      <div class="lg:col-span-7 bg-white p-8 md:p-10 rounded-2xl border border-slate-200/85 shadow-sm text-left">
        <h2 class="text-2xl font-bold text-slate-900 mb-2">
          Send a Detailed Message
        </h2>
        <p class="text-sm text-slate-500 mb-8">
          Fill out the form below and we will get back to you within 24 hours.
        </p>

        <form id="contactForm" class="space-y-6">

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Your Name</label>
            <input
              name="name"
              type="text"
              required
              class="w-full border border-slate-300 rounded-xl px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition bg-slate-50/50 text-slate-900 text-sm"
              placeholder="e.g. Rahul Sharma"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Email Address</label>
            <input
              name="email"
              type="email"
              required
              class="w-full border border-slate-300 rounded-xl px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition bg-slate-50/50 text-slate-900 text-sm"
              placeholder="rahul@yourbusiness.com"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Project Details / Message</label>
            <textarea
              name="message"
              rows="4"
              required
              class="w-full border border-slate-300 rounded-xl px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition bg-slate-50/50 text-slate-900 text-sm"
              placeholder="Tell us about your business, current website (if any), and goals..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-slate-900 text-white rounded-xl py-4 font-semibold hover:bg-slate-800 transition shadow-lg shadow-slate-900/10 text-base"
          >
            Send Message Securely
          </button>

        </form>
      </div>

    </div>
  </section>

  <!-- Script for Google Apps Script Web App Submission -->
  <script>
    const form = document.getElementById("contactForm");

    form.addEventListener("submit", function (e) {
      e.preventDefault();

      const formData = new FormData(form);

      fetch("https://script.google.com/macros/s/AKfycby_qhyLXL475azJiQNjoOzgtY1X2oVv4xAIf8eMcxC0b9U5CSBCP6v9oAD6on3r3_0k/exec", {
        method: "POST",
        body: formData
      })
      .then(() => {
        alert("Message sent successfully! We will get back to you shortly.");
        form.reset();
      })
      .catch((error) => {
        console.error(error);
        alert("Submission failed. Please try messaging us directly on WhatsApp.");
      });
    });
  </script>

</BaseLayout>