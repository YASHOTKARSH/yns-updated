---
import BaseLayout from "../components/layout/BaseLayout.astro";
---

<BaseLayout
  title="Contact YNS Web Studio Jaipur | Get Free Website Audit"
  description="Get in touch with YNS Web Studio in Jaipur to discuss your website project, request a free website audit, and start generating more business enquiries."
>

  <!-- =========================
       HERO SECTION
  ========================== -->
  <section
    class="relative bg-gradient-to-b from-slate-50 via-white to-slate-50 py-24 md:py-32 overflow-hidden border-b border-slate-100 text-center"
  >
    <div
      class="absolute top-1/4 left-1/2 -translate-x-1/2 w-96 h-96 bg-emerald-100/50 rounded-full blur-3xl pointer-events-none"
    ></div>

    <div class="max-w-4xl mx-auto px-6 relative z-10">

      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-xs font-semibold text-slate-700 mb-6 shadow-sm"
      >
        <span
          class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"
        ></span>

        Direct Collaboration • Free Consultation
      </div>

      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.15]"
      >
        Let’s Talk About
        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-600"
        >
          Your Website
        </span>
      </h1>

      <p
        class="mt-6 text-lg md:text-xl text-slate-600 max-w-2xl mx-auto font-normal leading-relaxed"
      >
        Tell us about your local business in Jaipur and we’ll guide you on
        the best web structure to turn casual visitors into predictable,
        high-value enquiries.
      </p>

    </div>
  </section>


  <!-- =========================
       CONTACT SECTION
  ========================== -->
  <section
    class="py-24 bg-gradient-to-b from-white via-slate-50/50 to-white border-b border-slate-100"
  >

    <div
      class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-stretch"
    >

      <!-- =========================
           WHATSAPP CARD
      ========================== -->
      <div
        class="lg:col-span-5 bg-white p-8 md:p-10 rounded-2xl border border-slate-200/85 shadow-sm hover:shadow-xl hover:border-emerald-200 transition-all duration-300 text-left flex flex-col justify-between"
      >

        <div>

          <div
            class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-lg mb-6"
          >
            💬
          </div>

          <h2 class="text-2xl font-bold text-slate-900">
            Quickest Response: WhatsApp
          </h2>

          <p
            class="mt-4 text-slate-600 text-base leading-relaxed"
          >
            Skip the inbox wait. Get instant replies, direct developer
            consultation, and a free website audit directly on WhatsApp.
          </p>

          <div
            class="mt-6 pt-6 border-t border-slate-100 space-y-2 text-sm text-slate-700 font-medium"
          >
            <p>✓ Average response time: Under 15 mins</p>
            <p>✓ Direct chat with developer Yashotkarsh</p>
            <p>✓ No long forms or waiting</p>
          </div>

        </div>


        <div class="mt-10">

          <a
            href="https://wa.me/919352563337"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center rounded-xl bg-emerald-600 text-white px-6 py-4 font-bold hover:bg-emerald-700 transition shadow-lg shadow-emerald-600/20"
          >
            Message on WhatsApp Now
          </a>

        </div>

      </div>


      <!-- =========================
           CONTACT FORM CARD
      ========================== -->
      <div
        class="lg:col-span-7 bg-white p-8 md:p-10 rounded-2xl border border-slate-200/85 shadow-sm text-left"
      >

        <!-- FORM HEADER -->
        <div id="formHeader">

          <h2 class="text-2xl font-bold text-slate-900 mb-2">
            Send a Detailed Message
          </h2>

          <p class="text-sm text-slate-500 mb-8">
            Fill out the form below and we will get back to you within
            24 hours.
          </p>

        </div>


        <!-- =========================
             FORM
        ========================== -->
        <form
          id="contactForm"
          class="space-y-6"
        >

          <!-- NAME -->
          <div>

            <label
              for="name"
              class="block text-sm font-semibold text-slate-700 mb-2"
            >
              Your Name
            </label>

            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              class="w-full border border-slate-300 rounded-xl px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition bg-slate-50/50 text-slate-900 text-sm"
              placeholder="e.g. Rahul Sharma"
            />

          </div>


          <!-- EMAIL -->
          <div>

            <label
              for="email"
              class="block text-sm font-semibold text-slate-700 mb-2"
            >
              Email Address
            </label>

            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="w-full border border-slate-300 rounded-xl px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition bg-slate-50/50 text-slate-900 text-sm"
              placeholder="rahul@yourbusiness.com"
            />

          </div>


          <!-- MESSAGE -->
          <div>

            <label
              for="message"
              class="block text-sm font-semibold text-slate-700 mb-2"
            >
              Project Details / Message
            </label>

            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full border border-slate-300 rounded-xl px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition bg-slate-50/50 text-slate-900 text-sm resize-none"
              placeholder="Tell us about your business, current website (if any), and goals..."
            ></textarea>

          </div>


          <!-- =========================
               ERROR / STATUS MESSAGE
          ========================== -->
          <div
            id="formStatus"
            class="hidden rounded-xl px-4 py-3 text-sm font-medium"
            role="status"
            aria-live="polite"
          ></div>


          <!-- =========================
               SUBMIT BUTTON
          ========================== -->
          <button
            id="submitButton"
            type="submit"
            class="w-full bg-slate-900 text-white rounded-xl py-4 font-semibold hover:bg-slate-800 transition shadow-lg shadow-slate-900/10 text-base disabled:opacity-60 disabled:cursor-not-allowed flex items-center justify-center gap-2"
          >

            <span id="buttonText">
              Send Message Securely
            </span>

            <!-- Loader -->
            <svg
              id="buttonLoader"
              class="hidden animate-spin w-5 h-5"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <circle
                cx="12"
                cy="12"
                r="9"
                stroke="currentColor"
                stroke-width="3"
                stroke-opacity="0.25"
              ></circle>

              <path
                d="M21 12a9 9 0 0 1-9 9"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
              ></path>
            </svg>

          </button>

        </form>


        <!-- =========================
             SUCCESS STATE
        ========================== -->
        <div
          id="successState"
          class="hidden text-center py-10"
          role="status"
          aria-live="polite"
        >

          <!-- Success Icon -->
          <div
            class="mx-auto w-16 h-16 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center mb-5"
          >

            <svg
              class="w-8 h-8 text-emerald-600"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M5 12.5L9.5 17L19 7"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>

          </div>


          <h3 class="text-2xl font-bold text-slate-900">
            Message Received
          </h3>


          <p
            class="mt-3 text-slate-600 max-w-md mx-auto leading-relaxed"
          >
            Thanks for reaching out. We've received your enquiry and
            will get back to you within 24 hours.
          </p>


          <a
            href="https://wa.me/919352563337"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center justify-center rounded-xl bg-emerald-600 text-white px-6 py-3 font-semibold hover:bg-emerald-700 transition"
          >
            Need a Faster Reply? WhatsApp Us
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- =========================
       GOOGLE APPS SCRIPT
  ========================== -->
  <script>

    const form = document.getElementById("contactForm");
    const formHeader = document.getElementById("formHeader");
    const formStatus = document.getElementById("formStatus");
    const successState = document.getElementById("successState");

    const submitButton = document.getElementById("submitButton");
    const buttonText = document.getElementById("buttonText");
    const buttonLoader = document.getElementById("buttonLoader");


    /*
      IMPORTANT:
      This is your deployed Google Apps Script Web App URL.
    */

    const GOOGLE_SCRIPT_URL =
      "https://script.google.com/macros/s/AKfycbyNdkVoqre7ILRMYkGRUXAmgNkmOrs1Dn0Tz20YcHs7AYMsMur11ewR3yv5C9727eKq/exec";


    /*
      Show status message
    */

    function showStatus(message, type) {

      formStatus.textContent = message;

      formStatus.className =
        "rounded-xl px-4 py-3 text-sm font-medium";


      if (type === "error") {

        formStatus.classList.add(
          "bg-red-50",
          "border",
          "border-red-100",
          "text-red-700"
        );

      }


      if (type === "success") {

        formStatus.classList.add(
          "bg-emerald-50",
          "border",
          "border-emerald-100",
          "text-emerald-700"
        );

      }


      formStatus.classList.remove("hidden");

    }


    /*
      Form submission
    */

    if (form) {

      form.addEventListener("submit", async (e) => {

        e.preventDefault();


        /*
          Hide previous error
        */

        formStatus.classList.add("hidden");


        /*
          Loading state
        */

        submitButton.disabled = true;

        buttonText.textContent = "Sending...";

        buttonLoader.classList.remove("hidden");


        /*
          Collect form data
        */

        const formData = new FormData(form);


        try {

          /*
            Send data to Google Apps Script.

            no-cors is required here because Google Apps Script
            does not expose a normal browser CORS response.
          */

          await fetch(
            GOOGLE_SCRIPT_URL,
            {
              method: "POST",
              body: formData,
              mode: "no-cors"
            }
          );


          /*
            Show success UI
          */

          form.classList.add("hidden");

          formHeader.classList.add("hidden");

          successState.classList.remove("hidden");


          /*
            Reset form
          */

          form.reset();


        } catch (error) {

          console.error(
            "Contact form submission error:",
            error
          );


          /*
            Show professional inline error
          */

          showStatus(
            "We couldn't send your message. Please try again or contact us directly on WhatsApp.",
            "error"
          );


          /*
            Restore button
          */

          submitButton.disabled = false;

          buttonText.textContent =
            "Send Message Securely";

          buttonLoader.classList.add("hidden");

        }

      });

    }

  </script>

</BaseLayout>
