---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import BlogPost from "../../components/blog/BlogPost.astro";
import { blogs } from "../../data/blogs.js";

export function getStaticPaths() {
  return blogs.map((blog) => ({
    params: {
      slug: blog.slug,
    },
    props: {
      blog,
    },
  }));
}

const { blog } = Astro.props;

if (!blog) {
  throw new Error("Blog post not found");
}

const siteUrl = "https://ynsweb.studio";
const canonicalUrl = `${siteUrl}/blog/${blog.slug}`;

const title = `${blog.title} | YNS Web Studio`;

const description =
  blog.description ||
  "Practical React, Next.js and modern web development insights from YNS Web Studio.";

const publishedDate = blog.publishedAt;
const updatedDate = blog.updatedAt || blog.publishedAt;

const relatedBlogs = blogs
  .filter((item) => item.slug !== blog.slug)
  .filter((item) => {
    const currentKeywords = [
      blog.primaryKeyword,
      ...(blog.keywords || []),
    ].map((keyword) => keyword?.toLowerCase());

    return (
      item.category === blog.category ||
      item.keywords?.some((keyword) =>
        currentKeywords.includes(keyword.toLowerCase())
      )
    );
  })
  .slice(0, 3);

const relatedServices = blog.relatedServices || [];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${canonicalUrl}#article`,
  headline: blog.title,
  description,
  url: canonicalUrl,
  datePublished: publishedDate,
  dateModified: updatedDate,
  author: {
    "@type": "Person",
    name: blog.author || "Yashotkarsh Apoorva",
    url: `${siteUrl}/founder`,
  },
  publisher: {
    "@type": "Organization",
    name: "YNS Web Studio",
    url: siteUrl,
    logo: {
      "@type": "ImageObject",
      url: `${siteUrl}/og-image.jpg`,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  articleSection: blog.category,
  keywords: blog.keywords || [],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${canonicalUrl}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: `${siteUrl}/blog`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: blog.title,
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout
  _title={title}
  _description={description}
>
  <!-- =========================================================
       SEO
  ========================================================== -->

  <link rel="canonical" href={canonicalUrl} />

  <meta
    name="robots"
    content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  />

  {
    blog.keywords?.length > 0 && (
      <meta
        name="keywords"
        content={blog.keywords.join(", ")}
      />
    )
  }

  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="YNS Web Studio" />

  <meta property="article:published_time" content={publishedDate} />
  <meta property="article:modified_time" content={updatedDate} />
  <meta property="article:section" content={blog.category} />

  <meta
    property="og:image"
    content={`${siteUrl}/og-image.jpg`}
  />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta
    name="twitter:image"
    content={`${siteUrl}/og-image.jpg`}
  />

  <!-- =========================================================
       STRUCTURED DATA
  ========================================================== -->

  <script
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema)}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <!-- =========================================================
       BLOG HEADER
  ========================================================== -->

  <main>

    <section class="article-hero">
      <div class="container">

        <nav
          class="breadcrumbs"
          aria-label="Breadcrumb"
        >
          <a href="/">Home</a>

          <span>/</span>

          <a href="/blog">Blog</a>

          <span>/</span>

          <span>{blog.title}</span>
        </nav>

        <div class="article-meta">

          {
            blog.category && (
              <span class="category">
                {blog.category}
              </span>
            )
          }

          {
            blog.readingTime && (
              <span>{blog.readingTime}</span>
            )
          }

          {
            publishedDate && (
              <time datetime={publishedDate}>
                {new Date(publishedDate).toLocaleDateString(
                  "en-IN",
                  {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                  }
                )}
              </time>
            )
          }

        </div>

        <h1>{blog.title}</h1>

        <p class="article-description">
          {description}
        </p>

        <div class="author-row">

          <div class="author-avatar">
            YA
          </div>

          <div>
            <span class="author-label">
              Written by
            </span>

            <a href="/founder">
              {blog.author || "Yashotkarsh Apoorva"}
            </a>
          </div>

        </div>

      </div>
    </section>

    <!-- =======================================================
         ARTICLE CONTENT
    ======================================================== -->

    <section class="article-section">
      <div class="article-layout">

        <article class="article-main">

          <BlogPost blog={blog} />

        </article>

        <!-- ===================================================
             SIDEBAR
        ==================================================== -->

        <aside class="article-sidebar">

          <!-- Primary conversion card -->

          <div class="sidebar-card primary-card">

            <span class="sidebar-eyebrow">
              Need a website?
            </span>

            <h2>
              Let's build the right solution for your business.
            </h2>

            <p>
              Tell YNS Web Studio what you're trying to build and
              we'll help you choose the right technology and
              approach.
            </p>

            <a
              href="/contact"
              class="sidebar-button"
            >
              Discuss Your Project

              <svg
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M4 10h12M11 5l5 5-5 5"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>

          </div>

          <!-- Relevant services -->

          {
            relatedServices.length > 0 && (
              <div class="sidebar-card">

                <span class="sidebar-eyebrow">
                  Relevant services
                </span>

                <h3>
                  Explore related services
                </h3>

                <div class="sidebar-links">

                  {relatedServices.map((service) => (
                    <a href={service.href}>
                      <span>{service.title}</span>

                      <svg
                        viewBox="0 0 20 20"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M4 10h12M11 5l5 5-5 5"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  ))}

                </div>

              </div>
            )
          }

          <!-- All services -->

          <div class="sidebar-card">

            <span class="sidebar-eyebrow">
              YNS Web Studio
            </span>

            <h3>
              Other web development services
            </h3>

            <div class="sidebar-links">

              <a href="/services/business-website-development">
                <span>Business Websites</span>

                <svg viewBox="0 0 20 20" fill="none">
                  <path
                    d="M4 10h12M11 5l5 5-5 5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>

              <a href="/services/ecommerce-development">
                <span>E-Commerce Websites</span>

                <svg viewBox="0 0 20 20" fill="none">
                  <path
                    d="M4 10h12M11 5l5 5-5 5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>

              <a href="/services/custom-web-development">
                <span>Custom Web Development</span>

                <svg viewBox="0 0 20 20" fill="none">
                  <path
                    d="M4 10h12M11 5l5 5-5 5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>

              <a href="/services/landing-page-development">
                <span>Landing Pages</span>

                <svg viewBox="0 0 20 20" fill="none">
                  <path
                    d="M4 10h12M11 5l5 5-5 5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>

              <a href="/services/booking-appointment-websites">
                <span>Booking Websites</span>

                <svg viewBox="0 0 20 20" fill="none">
                  <path
                    d="M4 10h12M11 5l5 5-5 5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>

              <a href="/services/corporate-website-development">
                <span>Corporate Websites</span>

                <svg viewBox="0 0 20 20" fill="none">
                  <path
                    d="M4 10h12M11 5l5 5-5 5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>

              <a href="/services/real-estate-website-development">
                <span>Real Estate Websites</span>

                <svg viewBox="0 0 20" fill="none">
                  <path
                    d="M4 10h12M11 5l5 5-5 5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>

              <a href="/services/restaurant-website-development">
                <span>Restaurant & Hotel Websites</span>

                <svg viewBox="0 0 20 20" fill="none">
                  <path
                    d="M4 10h12M11 5l5 5-5 5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>

            </div>

            <a
              href="/services"
              class="view-all"
            >
              View all services
            </a>

          </div>

        </aside>

      </div>
    </section>

    <!-- =======================================================
         RELATED BLOGS
    ======================================================== -->

    {
      relatedBlogs.length > 0 && (
        <section class="related-section">

          <div class="container">

            <div class="related-heading">

              <div>
                <span class="eyebrow">
                  Continue reading
                </span>

                <h2>
                  More React & Next.js insights
                </h2>
              </div>

              <a href="/blog">
                View all articles
              </a>

            </div>

            <div class="related-grid">

              {relatedBlogs.map((item) => (
                <a
                  href={`/blog/${item.slug}`}
                  class="related-card"
                >

                  <div class="related-card-top">

                    <span>
                      {item.category}
                    </span>

                    {
                      item.readingTime && (
                        <span>
                          {item.readingTime}
                        </span>
                      )
                    }

                  </div>

                  <h3>
                    {item.title}
                  </h3>

                  <p>
                    {item.description}
                  </p>

                  <span class="read-link">
                    Read article

                    <svg
                      viewBox="0 0 20 20"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M4 10h12M11 5l5 5-5 5"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>

                </a>
              ))}

            </div>

          </div>

        </section>
      )
    }

    <!-- =======================================================
         FINAL CONTACT CTA
    ======================================================== -->

    <section class="article-final-cta">

      <div class="container">

        <div class="final-box">

          <div class="final-copy">

            <span class="eyebrow">
              Ready to build?
            </span>

            <h2>
              Turn your website idea
              <br />
              into something real.
            </h2>

            <p>
              Whether you're starting from scratch, redesigning an
              existing website or building a React or Next.js
              application, let's discuss what you need.
            </p>

          </div>

          <div class="final-actions">

            <a
              href="/contact"
              class="final-primary"
            >
              Start a Project

              <svg
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M4 10h12M11 5l5 5-5 5"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>

            <a
              href="https://wa.me/919352563337?text=Hi%20YNS%20Web%20Studio%2C%20I%20want%20to%20discuss%20a%20website%20project."
              target="_blank"
              rel="noopener noreferrer"
              class="final-secondary"
            >
              WhatsApp YNS Web Studio
            </a>

          </div>

        </div>

      </div>

    </section>

  </main>
</BaseLayout>

<style>
  .container {
    width: min(1180px, calc(100% - 2rem));
    margin-inline: auto;
  }

  /* =========================================================
     ARTICLE HERO
  ========================================================== */

  .article-hero {
    padding: 5rem 0 4rem;
    border-bottom: 1px solid #e2e8f0;
    background: #fff;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2.2rem;
    color: #94a3b8;
    font-size: 0.78rem;
  }

  .breadcrumbs a {
    color: #64748b;
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: #0f172a;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.1rem;
    color: #64748b;
    font-size: 0.78rem;
  }

  .category {
    padding: 0.4rem 0.65rem;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    color: #0f172a;
    background: #f8fafc;
    font-weight: 700;
  }

  .article-hero h1 {
    max-width: 920px;
    margin: 0;
    color: #0f172a;
    font-size: clamp(2.2rem, 5.5vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.055em;
    font-weight: 750;
  }

  .article-description {
    max-width: 760px;
    margin: 1.5rem 0 0;
    color: #64748b;
    font-size: clamp(1rem, 1.8vw, 1.18rem);
    line-height: 1.8;
  }

  .author-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .author-avatar {
    width: 2.7rem;
    height: 2.7rem;
    display: grid;
    place-items: center;
    border: 1px solid #cbd5e1;
    border-radius: 50%;
    color: #0f172a;
    background: #f8fafc;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .author-label {
    display: block;
    margin-bottom: 0.15rem;
    color: #94a3b8;
    font-size: 0.7rem;
  }

  .author-row a {
    color: #0f172a;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }

  /* =========================================================
     ARTICLE LAYOUT
  ========================================================== */

  .article-section {
    padding: 4rem 0;
  }

  .article-layout {
    width: min(1180px, calc(100% - 2rem));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 760px) 300px;
    justify-content: center;
    gap: 4rem;
    align-items: start;
  }

  .article-main {
    min-width: 0;
  }

  /* =========================================================
     SIDEBAR
  ========================================================== */

  .article-sidebar {
    position: sticky;
    top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sidebar-card {
    padding: 1.25rem;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    background: #fff;
  }

  .primary-card {
    color: #fff;
    background: #0f172a;
    border-color: #0f172a;
  }

  .sidebar-eyebrow {
    display: block;
    margin-bottom: 0.55rem;
    color: #94a3b8;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .sidebar-card h2,
  .sidebar-card h3 {
    margin: 0 0 0.7rem;
    color: #0f172a;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  .primary-card h2 {
    color: #fff;
    font-size: 1.2rem;
  }

  .sidebar-card h3 {
    font-size: 1rem;
  }

  .sidebar-card p {
    margin: 0 0 1rem;
    color: #64748b;
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .primary-card p {
    color: #94a3b8;
  }

  .sidebar-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 2.7rem;
    padding: 0.7rem 0.8rem;
    border-radius: 0.7rem;
    color: #0f172a;
    background: #fff;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .sidebar-button svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .sidebar-links {
    display: flex;
    flex-direction: column;
  }

  .sidebar-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid #e2e8f0;
    color: #475569;
    text-decoration: none;
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .sidebar-links a:last-child {
    border-bottom: 0;
  }

  .sidebar-links a:hover {
    color: #0f172a;
  }

  .sidebar-links svg {
    flex: 0 0 auto;
    width: 0.85rem;
    height: 0.85rem;
  }

  .view-all {
    display: inline-flex;
    margin-top: 0.8rem;
    color: #0f172a;
    font-size: 0.76rem;
    font-weight: 800;
    text-decoration: none;
  }

  /* =========================================================
     RELATED ARTICLES
  ========================================================== */

  .related-section {
    padding: 4.5rem 0;
    border-top: 1px solid #e2e8f0;
    background: #f8fafc;
  }

  .related-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    color: #64748b;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .related-heading h2 {
    margin: 0.6rem 0 0;
    color: #0f172a;
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
  }

  .related-heading > a {
    color: #0f172a;
    font-size: 0.8rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    min-height: 280px;
    padding: 1.3rem;
    border: 1px solid #e2e8f0;
    border-radius: 1.1rem;
    background: #fff;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .related-card:hover {
    transform: translateY(-3px);
    border-color: #cbd5e1;
    box-shadow: 0 15px 35px rgba(15, 23, 42, 0.07);
  }

  .related-card-top {
    display: flex;
    justify-content: space-between;
    gap: 0.7rem;
    margin-bottom: 1.4rem;
    color: #94a3b8;
    font-size: 0.68rem;
    font-weight: 700;
  }

  .related-card h3 {
    margin: 0 0 0.75rem;
    color: #0f172a;
    font-size: 1.15rem;
    line-height: 1.35;
    letter-spacing: -0.025em;
  }

  .related-card p {
    margin: 0;
    color: #64748b;
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 1.5rem;
    color: #0f172a;
    font-size: 0.76rem;
    font-weight: 800;
  }

  .read-link svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  /* =========================================================
     FINAL CTA
  ========================================================== */

  .article-final-cta {
    padding: 1rem 0 5rem;
    background: #f8fafc;
  }

  .final-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    padding: 2.5rem;
    border-radius: 1.5rem;
    background: #0f172a;
  }

  .final-copy {
    max-width: 700px;
  }

  .final-copy .eyebrow {
    color: #94a3b8;
  }

  .final-copy h2 {
    margin: 0.75rem 0;
    color: #fff;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.15;
    letter-spacing: -0.045em;
  }

  .final-copy p {
    max-width: 620px;
    margin: 0;
    color: #94a3b8;
    font-size: 0.94rem;
    line-height: 1.75;
  }

  .final-actions {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 0 0 auto;
    width: 230px;
  }

  .final-primary,
  .final-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.9rem;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 800;
    transition: transform 180ms ease;
  }

  .final-primary {
    color: #0f172a;
    background: #fff;
  }

