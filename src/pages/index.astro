<BaseLayout
  title="Web Development Company in Jaipur | Website Development Services | YNS Web Studio"
  description="YNS Web Studio is a web development company in Jaipur building fast, responsive and SEO-ready business websites, landing pages, e-commerce stores, Next.js and React applications, booking websites and custom web solutions."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta
      name="keywords"
      content="web development company Jaipur, website development company Jaipur, web developer Jaipur, website designer Jaipur, business website development Jaipur, ecommerce website development Jaipur, Next.js development Jaipur, React development Jaipur, custom web development Jaipur"
    />

    <meta property="og:title" content="Web Development Company in Jaipur | YNS Web Studio" />
    <meta
      property="og:description"
      content="Explore website development, e-commerce, landing page, Next.js, React, custom web application, booking, corporate, real estate and hospitality website services by YNS Web Studio."
    />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="YNS Web Studio" />

    <meta name="twitter:title" content="Web Development Company in Jaipur | YNS Web Studio" />
    <meta
      property="og:description"
      content="Professional website and web development services for businesses, startups and brands."
    />

    <script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ProfessionalService",
        "@id": `${siteUrl}/#organization`,
        name: "YNS Web Studio",
        url: siteUrl,
        description:
          "Web development studio in Jaipur building fast, responsive and SEO-ready websites and web applications.",
        areaServed: {
          "@type": "City",
          name: "Jaipur",
        },
        serviceType: services.map((service) => service.title),
      },
      {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        url: siteUrl,
        name: "YNS Web Studio",
        publisher: {
          "@id": `${siteUrl}/#organization`,
        },
      },
      {
        "@type": "WebPage",
        "@id": `${pageUrl}#webpage`,
        url: pageUrl,
        name: "Web Development Company in Jaipur | YNS Web Studio",
        description:
          "Professional web development services offered by YNS Web Studio in Jaipur.",
        isPartOf: {
          "@id": `${siteUrl}/#website`,
        },
        about: {
          "@id": `${siteUrl}/#organization`,
        },
      },
      {
        "@type": "ItemList",
        name: "YNS Web Studio Web Development Services",
        itemListElement: itemListSchema,
      },
      {
        "@type": "FAQPage",
        mainEntity: faqSchema,
      },
      ...serviceSchema,
    ],
  })}
/>
  </Fragment>

  <div class="business-page">

