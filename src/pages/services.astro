---
import BaseLayout from "../components/layout/BaseLayout.astro";
---

<BaseLayout
  title="Professional Website Design Services in Jaipur | YNS Web Studio"
  description="Affordable, conversion-focused website design, speed optimization, and local SEO services in Jaipur. Built for local gyms, clinics, and businesses to generate real enquiries."
>

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-slate-50 via-white to-slate-50 py-24 md:py-32 overflow-hidden border-b border-slate-100 text-center">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-96 h-96 bg-emerald-100/50 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-6 relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-xs font-semibold text-slate-700 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Specialized Web Solutions • Jaipur Local Experts
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
        Website Design Services Built For <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-600">Local Business Growth</span>
      </h1>

      <p class="mt-6 text-lg md:text-xl text-slate-600 max-w-2xl mx-auto font-normal leading-relaxed">
        We don't build generic templates. We engineer high-performance, lightning-fast web systems tailored specifically for gyms, clinics, and service providers in Jaipur to turn casual visitors into loyal clients.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="https://wa.me/919352563337"
          target="_blank"
          class="inline-flex items-center justify-center rounded-xl bg-slate-900 text-white px-7 py-4 font-semibold hover:bg-slate-800 transition shadow-xl shadow-slate-900/10 group"
        >
          Get Free Website Audit on WhatsApp
          <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Main Services Grid -->
  <section class="py-24 bg-gradient-to-b from-white via-slate-50/50 to-white border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-12">

      <!-- Service 1 -->
      <div class="group bg-white p-8 md:p-10 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-emerald-200 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-lg mb-6 group-hover:scale-110 transition-transform">
            🚀
          </div>
          <h2 class="text-2xl font-bold text-slate-900 group-hover:text-emerald-600 transition-colors">
            Conversion-Focused Business Websites
          </h2>
          <p class="mt-4 text-slate-600 text-base leading-relaxed">
            Custom websites built around crystal-clear value messaging, structured UI/UX layouts, and frictionless WhatsApp enquiry flows for local service enterprises.
          </p>
          <ul class="mt-8 space-y-3 text-sm font-medium text-slate-700 pt-6 border-t border-slate-100">
            <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Up to 4–7 custom tailored pages</li>
            <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Instant WhatsApp chat & direct call buttons</li>
            <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Mobile-first responsive layout across all devices</li>
            <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Google Maps local listing integration</li>
          </ul>
        </div>
        <div class="mt-10 pt-6 border-t border-slate-100 flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400 uppercase">Starting at ₹8,999</span>
          <a href="https://wa.me/919352563337" target="_blank" class="text-sm font-bold text-emerald-600 hover:underline">Inquire on WhatsApp →</a>
        </div>
      </div>

      <!-- Service 2 -->
      <div class="group bg-white p-8 md:p-10 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-blue-200 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-lg mb-6 group-hover:scale-110 transition-transform">
            ⚡
          </div>
          <h2 class="text-2xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
            Website Redesign & Speed Optimization
          </h2>
          <p class="mt-4 text-slate-600 text-base leading-relaxed">
            Got an outdated, sluggish website that brings zero leads? We transform it into a lightning-fast performance machine equipped with modern speed and SEO standards.
          </p>
          <ul class="mt-8 space-y-3 text-sm font-medium text-slate-700 pt-6 border-t border-slate-100">
            <li class="flex items-center gap-2"><span class="text-blue-600 font-bold">✓</span> Complete UI/UX clarity & trust upgrade</li>
            <li class="flex items-center gap-2"><span class="text-blue-600 font-bold">✓</span> 99+ Lighthouse mobile speed score</li>
            <li class="flex items-center gap-2"><span class="text-blue-600 font-bold">✓</span> Local SEO metadata structure overhaul</li>
            <li class="flex items-center gap-2"><span class="text-blue-600 font-bold">✓</span> Zero downtime migration guarantee</li>
          </ul>
        </div>
        <div class="mt-10 pt-6 border-t border-slate-100 flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400 uppercase">Free Performance Audit</span>
          <a href="https://wa.me/919352563337" target="_blank" class="text-sm font-bold text-blue-600 hover:underline">Get Audit →</a>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA Section -->
  <section class="relative bg-zinc-950 text-white py-24 md:py-32 overflow-hidden border-t border-zinc-800 text-center">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-3xl mx-auto px-6 relative z-10">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        Not Sure Which Service Your Business <span class="text-emerald-400">Needs?</span>
      </h2>
      <p class="mt-6 text-lg text-zinc-400 max-w-xl mx-auto leading-relaxed">
        Send me a quick message on WhatsApp with your current website link or business idea. I'll personally review it for free.
      </p>
      <div class="mt-10">
        <a
          href="https://wa.me/919352563337"
          target="_blank"
          class="inline-flex items-center justify-center rounded-xl bg-emerald-500 text-zinc-950 px-8 py-4 font-bold hover:bg-emerald-400 transition shadow-xl shadow-emerald-500/20"
        >
          Chat with Yashotkarsh on WhatsApp
        </a>
      </div>
    </div>
  </section>

</BaseLayout>