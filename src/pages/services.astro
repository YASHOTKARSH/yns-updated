---
import BaseLayout from "../components/layout/BaseLayout.astro";

const siteUrl = "https://ynsweb.studio";
const pageUrl = "https://ynsweb.studio/services";

const services = [
  {
    number: "01",
    title: "Business Website Development",
    shortTitle: "Business Websites",
    description:
      "Professional, responsive and SEO-ready websites designed to turn visitors into enquiries and customers.",
    price: "₹20,000+",
    timeline: "7–14 days",
    href: "/services/business-website-development",
    icon: "briefcase",
  },
  {
    number: "02",
    title: "Landing Page Development",
    shortTitle: "Landing Pages",
    description:
      "High-converting landing pages built for campaigns, paid ads, lead generation, product launches and offers.",
    price: "₹12,000+",
    timeline: "3–5 days",
    href: "/services/landing-page-development",
    icon: "target",
  },
  {
    number: "03",
    title: "E-Commerce Website Development",
    shortTitle: "E-Commerce",
    description:
      "Scalable online stores with product discovery, cart, checkout, payments and conversion-focused customer journeys.",
    price: "₹60,000+",
    timeline: "3–5 weeks",
    href: "/services/ecommerce-development",
    icon: "shopping",
  },
  {
    number: "04",
    title: "Next.js Development",
    shortTitle: "Next.js",
    description:
      "Fast, scalable and SEO-friendly websites and web applications built with modern Next.js architecture.",
    price: "₹50,000+",
    timeline: "2–6 weeks",
    href: "/services/nextjs-development",
    icon: "code",
  },
  {
    number: "05",
    title: "React Development",
    shortTitle: "React",
    description:
      "Modern React interfaces and web applications focused on reusable components, performance and maintainability.",
    price: "₹40,000+",
    timeline: "2–6 weeks",
    href: "/services/react-development",
    icon: "react",
  },
  {
    number: "06",
    title: "Custom Web Development",
    shortTitle: "Custom Web Apps",
    description:
      "Custom web platforms and applications built around your business workflows, integrations and unique requirements.",
    price: "₹1,00,000+",
    timeline: "4–10 weeks",
    href: "/services/custom-web-development",
    icon: "layers",
  },
  {
    number: "07",
    title: "Booking & Appointment Websites",
    shortTitle: "Booking Systems",
    description:
      "Online booking and appointment experiences that help customers discover services, choose slots and submit enquiries.",
    price: "₹45,000+",
    timeline: "2–4 weeks",
    href: "/services/booking-appointment-websites",
    icon: "calendar",
  },
  {
    number: "08",
    title: "Corporate Website Development",
    shortTitle: "Corporate Websites",
    description:
      "Professional corporate websites designed to communicate your company, services, expertise and credibility.",
    price: "₹50,000+",
    timeline: "2–4 weeks",
    href: "/services/corporate-website-development",
    icon: "building",
  },
  {
    number: "09",
    title: "Real Estate Website Development",
    shortTitle: "Real Estate",
    description:
      "Property-focused websites with listings, search, filters, property details and enquiry-focused user journeys.",
    price: "₹50,000+",
    timeline: "2–4 weeks",
    href: "/services/real-estate-website-development",
    icon: "home",
  },
  {
    number: "10",
    title: "Restaurant, Café & Hotel Websites",
    shortTitle: "Hospitality Websites",
    description:
      "Premium hospitality websites for restaurants, cafés, hotels, homestays and hospitality brands.",
    price: "₹25,000+",
    timeline: "7–21 days",
    href: "/services/restaurant-website-development",
    icon: "utensils",
  },
];

const faqs = [
  {
    question: "How much does website development cost in Jaipur?",
    answer:
      "Website development cost depends on the type, number of pages, functionality and integrations required. At YNS Web Studio, business websites start from around ₹20,000, landing pages from ₹12,000, e-commerce websites from ₹60,000 and custom web applications from around ₹1,00,000.",
  },
  {
    question: "How long does it take to build a website?",
    answer:
      "A standard business website can usually be completed in 7–14 days. Landing pages may take 3–5 days, while e-commerce websites and custom web applications can take several weeks depending on their scope.",
  },
  {
    question: "Do you provide SEO-friendly websites?",
    answer:
      "Yes. Websites are structured with search-friendly page architecture, semantic HTML, metadata, responsive layouts, performance considerations, clean URLs and other technical foundations that support SEO.",
  },
  {
    question: "Can you redesign my existing website?",
    answer:
      "Yes. Existing websites can be redesigned to improve visual quality, mobile responsiveness, performance, SEO structure, user experience and conversion opportunities.",
  },
  {
    question: "Do you build websites for Jaipur businesses?",
    answer:
      "Yes. YNS Web Studio works with businesses in Jaipur and can build websites for local businesses, startups, restaurants, cafés, hotels, real estate companies, professional services, e-commerce brands and other industries.",
  },
  {
    question: "Can you integrate WhatsApp, payments or booking systems?",
    answer:
      "Yes. Depending on the project, integrations can include WhatsApp enquiry flows, payment gateways, booking systems, appointment scheduling, forms, analytics, CMS platforms, APIs and third-party services.",
  },
];

const serviceSchema = services.map((service) => ({
  "@type": "Service",
  name: service.title,
  description: service.description,
  url: `${siteUrl}${service.href}`,
  provider: {
    "@type": "ProfessionalService",
    name: "YNS Web Studio",
    url: siteUrl,
  },
  areaServed: {
    "@type": "City",
    name: "Jaipur",
  },
}));

const itemListSchema = services.map((service, index) => ({
  "@type": "ListItem",
  position: index + 1,
  name: service.title,
  url: `${siteUrl}${service.href}`,
}));

const faqSchema = faqs.map((faq) => ({
  "@type": "Question",
  name: faq.question,
  acceptedAnswer: {
    "@type": "Answer",
    text: faq.answer,
  },
}));

const iconPaths = {
  arrow: `<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>`,
  briefcase: `<rect width="18" height="14" x="3" y="7" rx="2"></rect><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M3 12h18"></path>`,
  target: `<circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="4"></circle><circle cx="12" cy="12" r="1"></circle>`,
  shopping: `<path d="M6 8h12l1 12H5L6 8Z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path>`,
  code: `<path d="m8 9-4 3 4 3"></path><path d="m16 9 4 3-4 3"></path><path d="m14 5-4 14"></path>`,
  react: `<ellipse cx="12" cy="12" rx="9" ry="3.5"></ellipse><ellipse cx="12" cy="12" rx="9" ry="3.5" transform="rotate(60 12 12)"></ellipse><ellipse cx="12" cy="12" rx="9" ry="3.5" transform="rotate(120 12 12)"></ellipse><circle cx="12" cy="12" r="1.3"></circle>`,
  layers: `<path d="m12 3 9 5-9 5-9-5 9-5Z"></path><path d="m3 12 9 5 9-5"></path><path d="m3 16 9 5 9-5"></path>`,
  calendar: `<rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path>`,
  building: `<path d="M4 21V5l8-3 8 3v16"></path><path d="M9 21v-4h6v4"></path><path d="M8 8h1M15 8h1M8 12h1M15 12h1"></path>`,
  home: `<path d="m3 11 9-8 9 8"></path><path d="M5 10v10h14V10"></path><path d="M9 20v-6h6v6"></path>`,
  utensils: `<path d="M7 3v8M4 3v5a3 3 0 0 0 6 0V3"></path><path d="M7 11v10"></path><path d="M17 3v18"></path><path d="M20 3v5a3 3 0 0 1-3 3"></path>`,
  shield: `<path d="M12 3 20 6v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z"></path><path d="m9 12 2 2 4-4"></path>`,
};
---

<BaseLayout
  title="Web Development Company in Jaipur | Website Development Services | YNS Web Studio"
  description="YNS Web Studio is a web development company in Jaipur building fast, responsive and SEO-ready business websites, landing pages, e-commerce stores, Next.js and React applications, booking websites and custom web solutions."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <meta property="og:title" content="Web Development Services in Jaipur | YNS Web Studio" />
    <meta
      property="og:description"
      content="Explore website development, e-commerce, landing page, Next.js, React, custom web application, booking, corporate, real estate and hospitality website services by YNS Web Studio."
    />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="YNS Web Studio" />

    <meta name="twitter:title" content="Web Development Services in Jaipur | YNS Web Studio" />
    <meta
      name="twitter:description"
      content="Professional website and web development services for businesses, startups and brands."
    />

    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "ProfessionalService",
            "@id": `${siteUrl}/#organization`,
            name: "YNS Web Studio",
            url: siteUrl,
            description:
              "Web development studio in Jaipur building fast, responsive and SEO-ready websites and web applications.",
            areaServed: {
              "@type": "City",
              name: "Jaipur",
            },
            serviceType: services.map((service) => service.title),
          },
          {
            "@type": "WebPage",
            "@id": `${pageUrl}#webpage`,
            url: pageUrl,
            name: "Web Development Services in Jaipur",
            description:
              "Professional web development services offered by YNS Web Studio in Jaipur.",
            isPartOf: {
              "@type": "WebSite",
              name: "YNS Web Studio",
              url: siteUrl,
            },
          },
          {
            "@type": "ItemList",
            name: "YNS Web Studio Web Development Services",
            itemListElement: itemListSchema,
          },
          {
            "@type": "FAQPage",
            mainEntity: faqSchema,
          },
          ...serviceSchema,
        ],
      })}
    </script>
  </Fragment>

  <div class="business-page">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>

      <div class="container hero-container">

        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <span aria-current="page">Services</span>
        </nav>

        <div class="hero-layout" style="min-height: auto; padding: 40px 0 80px;">

          <div class="hero-copy" style="max-width: 800px;">

            <div class="eyebrow">
              <span class="eyebrow-dot"></span>
              Web Development Services in Jaipur
            </div>

            <h1>
              Websites built for
              <em>business, growth and conversion.</em>
            </h1>

            <p class="hero-description">
              YNS Web Studio builds high-performance websites and web applications for businesses, startups and brands. From a focused landing page to a complete custom web platform, we combine design, development, SEO and conversion strategy into one digital experience.
            </p>

            <div class="hero-actions">
              <a
                href="https://wa.me/919352563337"
                target="_blank"
                rel="noopener noreferrer"
                class="button button-primary"
              >
                Start Your Project
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.arrow}></g>
                </svg>
              </a>

              <a href="#services" class="button button-secondary">
                Explore services
              </a>
            </div>

            <div class="hero-stats">
              <div>
                <strong>10+</strong>
                <span>Specialized services</span>
              </div>
              <div>
                <strong>SEO</strong>
                <span>Search-ready structure</span>
              </div>
              <div>
                <strong>100%</strong>
                <span>Custom solutions</span>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="intro-section">
      <div class="container">
        <div class="intro-grid">

          <div class="section-number">01</div>

          <div class="intro-content">
            <p class="section-kicker">Our approach</p>

            <h2>
              More than a website.
              <span>A digital growth asset.</span>
            </h2>

            <div class="intro-text-grid">
              <p>
                Your website is often the first serious interaction a customer has with your business. We therefore approach development beyond simply making pages look good.
              </p>

              <p>
                Every project is planned around clarity, speed, responsive experience, search visibility, trust and the next action you want visitors to take. Whether you need a local business website, an online store, a high-converting landing page or a custom web application, our goal is to build something that supports your actual business.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="benefits-section">
      <div class="container">

        <div class="section-heading split-heading">
          <div>
            <p class="section-kicker">Complete catalogue</p>
            <h2>Choose the right development<br /><span>solution for your business.</span></h2>
          </div>

          <p>
            Explore our complete range of website and web development services. Each service is designed around a different business requirement.
          </p>
        </div>

        <div class="benefit-grid">
          {
            services.map((service) => (
              <article class="benefit-card">
                <div class="card-number">{service.number}</div>

                <div class="card-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g
                      set:html={
                        service.icon === "briefcase" ? iconPaths.briefcase :
                        service.icon === "target" ? iconPaths.target :
                        service.icon === "shopping" ? iconPaths.shopping :
                        service.icon === "code" ? iconPaths.code :
                        service.icon === "react" ? iconPaths.react :
                        service.icon === "layers" ? iconPaths.layers :
                        service.icon === "calendar" ? iconPaths.calendar :
                        service.icon === "building" ? iconPaths.building :
                        service.icon === "home" ? iconPaths.home :
                        iconPaths.utensils
                      }
                    ></g>
                  </svg>
                </div>

                <h3>{service.title}</h3>
                <p>{service.description}</p>

                <div style="margin-top: 24px; display: flex; gap: 20px; font-size: 11px; color: #777;">
                  <div><strong>Starting:</strong> {service.price}</div>
                  <div><strong>Timeline:</strong> {service.timeline}</div>
                </div>

                <a href={service.href} class="card-arrow" style="display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: #111; color: var(--accent);">
                  <svg viewBox="0 0 24 24" aria-hidden="true" style="width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2;">
                    <g set:html={iconPaths.arrow}></g>
                  </svg>
                </a>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- SEO CONTENT -->
    <section class="included-section">
      <div class="container">

        <div class="included-layout">

          <div class="included-intro">
            <div class="dark-kicker">
              <span></span>
              Why YNS Web Studio
            </div>

            <h2>
              Development focused on
              <span>real business outcomes.</span>
            </h2>

            <p>
              If you are looking for a web development company in Jaipur, YNS Web Studio provides complete website and web application development services for businesses, startups and brands.
            </p>

            <a
              href="https://wa.me/919352563337"
              target="_blank"
              rel="noopener noreferrer"
              class="dark-button"
            >
              Start a Conversation
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <g set:html={iconPaths.arrow}></g>
              </svg>
            </a>
          </div>

          <div class="feature-list" style="display: flex; flex-direction: column;">
            <div style="padding: 20px 0; border-bottom: 1px solid #303030; color: #aaa; font-size: 14px; line-height: 1.8;">
              Our approach combines website design, development, SEO, performance and conversion rather than treating each part as a separate task.
            </div>
            <div style="padding: 20px 0; border-bottom: 1px solid #303030; color: #aaa; font-size: 14px; line-height: 1.8;">
              We build everything from business websites and landing pages to e-commerce stores, React and Next.js applications, booking systems, real estate websites and custom web platforms.
            </div>
            <div style="padding: 20px 0; color: #aaa; font-size: 14px; line-height: 1.8;">
              Every project is planned with responsive design, clean architecture, search-friendly structure and clear conversion paths in mind.
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="process-section">
      <div class="container">

        <div class="process-header">
          <p class="section-kicker">Process</p>

          <h2>
            A straightforward process
            <span>from idea to launch.</span>
          </h2>

          <p>
            Every project starts with understanding the business problem, then moves through strategy, design, development, testing and launch.
          </p>
        </div>

        <div class="process-grid" style="grid-template-columns: repeat(3, 1fr);">
          {[
            ["01", "Discovery", "Understand your business, audience, goals, requirements and competition."],
            ["02", "Planning", "Define page structure, features, user journeys, content requirements and technical direction."],
            ["03", "Design", "Create a clear visual system and responsive experience aligned with your brand."],
            ["04", "Development", "Build the website or application using an appropriate modern technology stack."],
            ["05", "Testing", "Check responsiveness, functionality, forms, links, performance and key user flows."],
            ["06", "Launch", "Deploy the project, configure essential technical settings and prepare it for growth."]
          ].map(([number, title, text], index) => (
            <article class="process-card">
              <div class="process-top">
                <span>{number}</span>

                {index < 5 && (
                  <div class="process-connector"></div>
                )}
              </div>

              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="faq-section">
      <div class="container faq-container">

        <div class="faq-heading">
          <p class="section-kicker">FAQ</p>

          <h2>
            Frequently asked
            <span>questions.</span>
          </h2>

          <p>
            Everything you should know before starting your web development project with YNS Web Studio.
          </p>
        </div>

        <div class="faq-list">
          {
            faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>
                  <span class="faq-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="faq-question">{faq.question}</span>

                  <span class="faq-toggle">
                    <span></span>
                    <span></span>
                  </span>
                </summary>

                <div class="faq-answer">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))
          }
        </div>

      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="final-cta-section">
      <div class="container">

        <div class="final-cta">

          <div class="cta-grid"></div>
          <div class="cta-glow"></div>

          <div class="cta-content">
            <div class="dark-kicker">
              <span></span>
              Start your project
            </div>

            <h2>
              Have a website idea?
              <span>Let's turn it into something useful.</span>
            </h2>

            <p>
              Tell us what you are building, what problem you want to solve and what your business needs. We will help you choose the right development approach.
            </p>

            <div class="cta-actions">
              <a
                href="https://wa.me/919352563337"
                target="_blank"
                rel="noopener noreferrer"
                class="cta-primary"
              >
                Start Your Project
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <g set:html={iconPaths.arrow}></g>
                </svg>
              </a>

              <a href="mailto:hello@ynsweb.studio" class="cta-secondary">
                Email Us
              </a>
            </div>

            <div class="cta-location">
              <span></span>
              Jaipur, Rajasthan · Serving businesses across India
            </div>
          </div>

          <div class="cta-side">
            <div class="cta-side-number">YNS</div>
            <p>Strategy.<br />Design.<br /><strong>Growth.</strong></p>
          </div>

        </div>

      </div>
    </section>

  </div>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    background: #f7f7f5;
  }

  .business-page {
    --ink: #111111;
    --muted: #696969;
    --soft: #f1f1ee;
    --line: #deded9;
    --dark: #101010;
    --white: #ffffff;
    --accent: #c9ff4a;
    color: var(--ink);
    overflow: hidden;
  }

  .container {
    width: min(1240px, calc(100% - 40px));
    margin: 0 auto;
  }

  /* HERO */
  .hero {
    position: relative;
    isolation: isolate;
    min-height: auto;
    overflow: hidden;
    background:
      radial-gradient(circle at 80% 18%, rgba(201, 255, 74, 0.12), transparent 28%),
      #101010;
    color: white;
  }

  .hero-grid,
  .cta-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.28;
    background-image:
      linear-gradient(rgba(255,255,255,0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.055) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
  }

  .hero-glow {
    position: absolute;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.12;
    pointer-events: none;
  }

  .hero-glow-one {
    right: -180px;
    top: 120px;
    background: #c9ff4a;
  }

  .hero-glow-two {
    left: -250px;
    bottom: -280px;
    background: #ffffff;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    padding-top: 32px;
    padding-bottom: 70px;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: #777;
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .breadcrumb a {
    color: #888;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: white;
  }

  .breadcrumb span:last-child {
    color: #d4d4d4;
  }

  .hero-copy {
    max-width: 690px;
    padding-top: 20px;
  }

  .eyebrow,
  .dark-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #a5a5a5;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .eyebrow-dot,
  .dark-kicker span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 16px rgba(201,255,74,0.65);
  }

  .hero h1 {
    max-width: 840px;
    margin: 28px 0 0;
    font-size: clamp(44px, 5.5vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.06em;
    font-weight: 500;
  }

  .hero h1 em {
    display: block;
    color: #777;
    font-style: normal;
  }

  .hero-description {
    max-width: 680px;
    margin-top: 28px;
    color: #a7a7a7;
    font-size: 17px;
    line-height: 1.8;
  }

