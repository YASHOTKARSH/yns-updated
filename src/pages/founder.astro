  <main class="overflow-hidden bg-[#050505] text-white">

    <!-- HERO -->
    <section class="relative border-b border-white/10">
      <div
        class="absolute inset-0"
        style="
          background:
            radial-gradient(circle at 15% 20%, rgba(255,255,255,.09), transparent 30%),
            radial-gradient(circle at 85% 35%, rgba(120,120,120,.08), transparent 30%);
        "
      ></div>

      <div class="relative mx-auto max-w-7xl px-6 py-24 sm:px-8 lg:px-12 lg:py-32">
