                  text: "Yashotkarsh works on business websites, landing pages, e-commerce websites, React and Next.js applications, custom web development, SEO-ready website structures and conversion-focused digital experiences."
                }
              },
              {
                "@type": "Question",
                name: "What is YNS Web Studio?",
                acceptedAnswer: {
