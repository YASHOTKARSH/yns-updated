                Start a Project
              </a>
            </div>

            <div class="mt-10 flex flex-wrap gap-x-7 gap-y-3 text-xs text-white/35">
              <span>Jaipur, Rajasthan</span>
              <span>Full Stack Development</span>
              <span>Web + Content + Conversion</span>
            </div>
          </div>
<div class="lg:pl-8">
  <div
    class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.035]"
