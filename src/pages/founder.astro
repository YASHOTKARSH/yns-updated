        <p class="mt-1 text-[11px] text-white/35">
          Development
        </p>
      </div>

      <div class="border-l border-white/10 p-5">
        <p class="text-lg font-semibold text-white">SEO</p>
        <p class="mt-1 text-[11px] text-white/35">
          Visibility
        </p>
      </div>

      <div class="border-l border-white/10 p-5">
