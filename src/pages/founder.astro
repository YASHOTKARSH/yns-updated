        <div>
          <p class="text-xs uppercase tracking-[0.2em] text-white/60">
            YNS Web Studio
          </p>

          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white">
            Yashotkarsh Apoorva
          </h2>

          <p class="mt-2 text-sm text-white/60">
            Founder & Full Stack Developer
          </p>
        </div>
      </div>
    </div>

    <!-- Expertise -->
    <div class="grid grid-cols-3 border-t border-white/10">
      <div class="p-5">
