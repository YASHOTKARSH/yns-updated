---
import BaseLayout from "../components/layout/BaseLayout.astro";
---

<BaseLayout
  title="Our Work & Case Studies | YNS Web Studio Jaipur"
  description="Explore high-converting websites built for local businesses, gyms, and clinics in Jaipur. See how we structure web projects for real enquiry growth."
>

  <!-- Header Section -->
  <section class="relative bg-gradient-to-b from-slate-50 via-white to-slate-50 py-24 md:py-32 overflow-hidden border-b border-slate-100 text-center">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-96 h-96 bg-blue-100/50 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-6 relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-xs font-semibold text-slate-700 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Proven Execution • Real Business Impact
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
        Our Work & <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">Client Case Studies</span>
      </h1>

      <p class="mt-6 text-lg md:text-xl text-slate-600 max-w-2xl mx-auto font-normal leading-relaxed">
        Explore structured, lightning-fast websites built for local service businesses designed to eliminate friction, build elite trust, and drive consistent WhatsApp enquiries.
      </p>
    </div>
  </section>

  <!-- Featured Case Study Section -->
  <section class="py-24 bg-gradient-to-b from-white via-slate-50/50 to-white border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

      <!-- Screenshot Preview (6 Cols) -->
      <div class="lg:col-span-6">
        <div class="rounded-2xl bg-gradient-to-b from-slate-200 to-slate-100 p-2 shadow-xl border border-slate-200">
          <div class="bg-white rounded-xl p-4 shadow-inner flex items-center justify-center overflow-hidden">
            <img src="/clientDemo.png" alt="Local Service Business Website Demo" class="rounded-lg w-full h-auto object-cover max-h-[380px]" />
          </div>
        </div>
      </div>

      <!-- Details (6 Cols) -->
      <div class="lg:col-span-6 space-y-6 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-600 text-xs font-bold uppercase tracking-wider">
          Featured Local Client Build
        </div>

        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">
          Local Service Business Web Platform
        </h2>

        <p class="text-slate-600 text-base leading-relaxed">
          This project focused intensely on removing user confusion, sharpening value propositions, and engineering a direct conversion path using instant WhatsApp integrations and clean pricing tiers.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
          <div class="flex items-center gap-2 text-sm font-medium text-slate-700">
            <span class="text-emerald-600 font-bold">✓</span> Crystal-clear hero value proposition
          </div>
          <div class="flex items-center gap-2 text-sm font-medium text-slate-700">
            <span class="text-emerald-600 font-bold">✓</span> Strategic WhatsApp CTA placement
          </div>
          <div class="flex items-center gap-2 text-sm font-medium text-slate-700">
            <span class="text-emerald-600 font-bold">✓</span> Mobile-first responsive UI architecture
          </div>
          <div class="flex items-center gap-2 text-sm font-medium text-slate-700">
            <span class="text-emerald-600 font-bold">✓</span> 99+ Speed performance score
          </div>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-sm text-slate-700 font-medium">
          💡 <span class="font-bold text-slate-900">The Result:</span> A high-performance web asset engineered to convert casual smartphone traffic into active local customer enquiries.
        </div>
      </div>

    </div>
  </section>

  <!-- Process Section -->
  <section class="py-24 bg-white text-center">
    <div class="max-w-6xl mx-auto px-6">
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 border border-indigo-100 text-xs font-semibold text-indigo-600 mb-4 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-600 animate-pulse"></span>
        Execution Blueprint
      </div>

      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
        How We Approach Every Project
      </h2>
      <p class="mt-3 text-slate-600 text-base max-w-xl mx-auto">
        A transparent 3-step execution plan designed for zero stress and maximum ROI.
      </p>

      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8 text-left">

        <div class="bg-slate-50/80 p-8 rounded-2xl border border-slate-200/60 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-base mb-6">01</div>
          <h3 class="text-xl font-bold text-slate-900">Understand Your Business</h3>
          <p class="mt-3 text-slate-600 text-sm leading-relaxed">
            We analyze your target audience, study your local competitors in Jaipur, and map out the exact primary action you want users to take.
          </p>
        </div>

        <div class="bg-slate-50/80 p-8 rounded-2xl border border-slate-200/60 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-base mb-6">02</div>
          <h3 class="text-xl font-bold text-slate-900">Structure for Conversion</h3>
          <p class="mt-3 text-slate-600 text-sm leading-relaxed">
            Design clear reading sections, persuasive value copy, and prominent WhatsApp chat options to ensure zero visitor friction.
          </p>
        </div>

        <div class="bg-slate-50/80 p-8 rounded-2xl border border-slate-200/60 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-base mb-6">03</div>
          <h3 class="text-xl font-bold text-slate-900">Optimize & Launch</h3>
          <p class="mt-3 text-slate-600 text-sm leading-relaxed">
            Deploy using lightning-fast mobile-first code architectures, ensuring robust speed optimization and search engine indexing readiness.
          </p>
        </div>

      </div>

    </div>
  </section>

</BaseLayout>