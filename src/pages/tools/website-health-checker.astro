---
import BaseLayout from "../../components/layout/BaseLayout.astro";

const title = "Free Website SEO Checker & Error Detector | YNS Web Studio";
const description =
  "Check your website for SEO, technical, accessibility, security and common website errors with the free YNS Website Health Checker.";

const checks = [
  ["SEO Issues", "Title tags, meta descriptions, headings, canonical tags, robots directives and structured data."],
  ["Technical Errors", "HTTP status, viewport, sitemap, robots.txt, HTTPS and common technical signals."],
  ["Broken Links", "Detect broken links found during the audit, including limited internal-link checks."],
  ["Image Problems", "Missing alt text, broken image sources and basic image optimization signals."],
  ["Accessibility", "Language attributes, form labels, accessible buttons and basic usability signals."],
  ["Security Signals", "HTTPS, mixed-content signals and other basic security configuration checks."],
];

const faqs = [
  {
    question: "What is a website health checker?",
    answer:
      "A website health checker analyzes important parts of a website and identifies common SEO, technical, accessibility, performance and security issues.",
  },
  {
    question: "Is this website audit free?",
    answer:
      "Yes. The YNS Website Health Checker is designed to provide a free initial website health report without requiring signup.",
  },
  {
    question: "What does the checker look for?",
    answer:
      "The checker analyzes important website signals such as title tags, meta descriptions, headings, canonical URLs, robots directives, links, images, accessibility attributes, HTTPS and other technical elements.",
  },
  {
    question: "Can YNS Web Studio fix the problems found?",
    answer:
      "Yes. YNS Web Studio can help with technical fixes, SEO improvements, redesigns, performance improvements and custom web development.",
  },
];
---

<BaseLayout _title={title} _description={description}>
  <main class="bg-white text-slate-950">
    <section class="relative overflow-hidden border-b border-slate-200">
      <div
        class="absolute inset-0 -z-10"
        style="background: radial-gradient(circle at 50% 0%, rgba(15,23,42,0.08), transparent 45%);"
      ></div>

      <div class="mx-auto max-w-7xl px-6 pb-20 pt-20 sm:px-8 lg:px-12 lg:pb-28 lg:pt-28">
        <div class="mx-auto max-w-4xl text-center">
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-600 shadow-sm">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
            Free Website Health Check
          </div>

          <h1 class="text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
            Find what's wrong with your website.
          </h1>

          <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl">
            Check your website for SEO, technical, accessibility, security and common website errors — and get actionable recommendations.
          </p>

          <form id="audit-form" class="mx-auto mt-10 max-w-3xl" novalidate>
            <div class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-3 shadow-xl shadow-slate-900/5 sm:flex-row">
              <label for="website-url" class="sr-only">Website URL</label>
              <input
                id="website-url"
                name="url"
                type="url"
                inputmode="url"
                autocomplete="url"
                placeholder="https://yourwebsite.com"
                required
                class="min-w-0 flex-1 rounded-xl border border-slate-200 bg-slate-50 px-5 py-4 text-base text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900/10"
              />

              <button
                id="audit-submit"
                type="submit"
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-950 px-7 py-4 text-sm font-semibold text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-60"
              >
                <span id="button-text">Analyze My Website</span>
                <svg id="button-spinner" class="hidden h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity=".25" />
                  <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                </svg>
              </button>
            </div>

            <p id="form-message" class="mt-3 hidden text-left text-sm" role="status" aria-live="polite"></p>
            <p class="mt-4 text-sm text-slate-500">Free · No signup required · First-page audit</p>
          </form>
        </div>
      </div>
    </section>

    <section id="audit-report" class="hidden border-b border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-7xl px-6 py-16 sm:px-8 lg:px-12 lg:py-20">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Audit report</p>
            <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Website health overview</h2>
            <p id="report-url" class="mt-2 break-all text-sm text-slate-500"></p>
          </div>
          <button id="new-audit" type="button" class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-900 transition hover:border-slate-500">
            Run Another Audit
          </button>
        </div>

        <div class="mt-10 grid gap-5 lg:grid-cols-[1.1fr_2fr]">
          <article class="rounded-3xl border border-slate-200 bg-white p-7 shadow-sm">
            <p class="text-sm font-medium text-slate-500">Overall score</p>
            <div class="mt-4 flex items-end gap-2">
              <span id="overall-score" class="text-6xl font-bold tracking-tight">—</span>
              <span class="mb-2 text-slate-500">/ 100</span>
            </div>
            <p id="score-label" class="mt-2 text-sm font-semibold text-slate-700"></p>
            <div class="mt-6 h-3 overflow-hidden rounded-full bg-slate-100">
              <div id="overall-bar" class="h-full w-0 rounded-full bg-slate-950 transition-all duration-700"></div>
            </div>

            <div class="mt-8 grid grid-cols-2 gap-3">
              <div class="rounded-xl bg-red-50 p-4"><p class="text-xs text-red-600">Critical</p><p id="critical-count" class="mt-1 text-2xl font-semibold text-red-800">0</p></div>
              <div class="rounded-xl bg-amber-50 p-4"><p class="text-xs text-amber-600">Warnings</p><p id="warning-count" class="mt-1 text-2xl font-semibold text-amber-800">0</p></div>
              <div class="rounded-xl bg-slate-50 p-4"><p class="text-xs text-slate-500">Suggestions</p><p id="suggestion-count" class="mt-1 text-2xl font-semibold text-slate-800">0</p></div>
              <div class="rounded-xl bg-emerald-50 p-4"><p class="text-xs text-emerald-600">Passed</p><p id="passed-count" class="mt-1 text-2xl font-semibold text-emerald-800">0</p></div>
            </div>
          </article>

          <article class="rounded-3xl border border-slate-200 bg-white p-7 shadow-sm">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p class="text-sm font-medium text-slate-500">Category scores</p>
                <h3 class="mt-1 text-xl font-semibold">Where your site stands</h3>
              </div>
            </div>
            <div id="category-scores" class="mt-7 grid gap-5 sm:grid-cols-2"></div>
          </article>
        </div>

        <div class="mt-8 grid gap-8 lg:grid-cols-[1.6fr_0.8fr]">
          <article class="rounded-3xl border border-slate-200 bg-white p-7 shadow-sm">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p class="text-sm font-medium text-slate-500">Prioritized findings</p>
                <h3 class="mt-1 text-2xl font-semibold">What should you fix?</h3>
              </div>
              <span id="issue-total" class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">0 issues</span>
            </div>
            <div id="issues-list" class="mt-6 space-y-4"></div>
          </article>

          <aside class="rounded-3xl bg-slate-950 p-7 text-white">
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-400">Need help?</p>
            <h3 class="mt-3 text-2xl font-semibold">Found problems you don't know how to fix?</h3>
            <p class="mt-4 text-sm leading-7 text-slate-300">
              YNS Web Studio can help fix technical issues, improve SEO, redesign outdated websites and build faster websites.
            </p>
            <div class="mt-7 space-y-3">
              <a href="/contact" class="flex items-center justify-center rounded-xl bg-white px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-slate-100">
                Get Help Fixing My Website
              </a>
              <a href="https://wa.me/919352563337" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center rounded-xl border border-slate-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-900">
                Talk to a Developer
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="border-b border-slate-200">
      <div class="mx-auto max-w-7xl px-6 py-20 sm:px-8 lg:px-12 lg:py-24">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">What we check</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">One scan. Multiple website health signals.</h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">The checker looks at the parts of your website that commonly cause SEO, technical and usability problems.</p>
        </div>

        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {checks.map(([heading, text], index) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-7 transition hover:-translate-y-1 hover:border-slate-300 hover:shadow-lg">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-950 text-sm font-semibold text-white">{String(index + 1).padStart(2, "0")}</div>
              <h3 class="mt-6 text-xl font-semibold">{heading}</h3>
              <p class="mt-3 leading-7 text-slate-600">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-slate-50">
      <div class="mx-auto max-w-7xl px-6 py-20 sm:px-8 lg:px-12 lg:py-24">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">How it works</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Check your website in three simple steps.</h2>
        </div>
        <div class="mt-14 grid gap-6 md:grid-cols-3">
          <article class="rounded-2xl border border-slate-200 bg-white p-8"><span class="text-sm font-semibold text-slate-400">01</span><h3 class="mt-5 text-xl font-semibold">Enter your URL</h3><p class="mt-3 leading-7 text-slate-600">Enter the public URL of the website or page you want to check.</p></article>
          <article class="rounded-2xl border border-slate-200 bg-white p-8"><span class="text-sm font-semibold text-slate-400">02</span><h3 class="mt-5 text-xl font-semibold">Run the audit</h3><p class="mt-3 leading-7 text-slate-600">Our server-side audit engine analyzes important website health signals.</p></article>
          <article class="rounded-2xl border border-slate-200 bg-white p-8"><span class="text-sm font-semibold text-slate-400">03</span><h3 class="mt-5 text-xl font-semibold">Fix what matters</h3><p class="mt-3 leading-7 text-slate-600">Review prioritized findings and decide what needs to be fixed first.</p></article>
        </div>
      </div>
    </section>

    <section class="bg-slate-950 text-white">
      <div class="mx-auto max-w-5xl px-6 py-20 text-center sm:px-8 lg:py-24">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-400">Need help fixing your website?</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">Turn the audit into actual improvements.</h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-300">YNS Web Studio can help with technical SEO, performance, redesigns, React and Next.js development and custom web development.</p>
        <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/contact" class="inline-flex items-center justify-center rounded-xl bg-white px-7 py-4 text-sm font-semibold text-slate-950 transition hover:bg-slate-100">Get Help Fixing My Website</a>
          <a href="https://wa.me/919352563337" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-xl border border-slate-700 px-7 py-4 text-sm font-semibold text-white transition hover:border-slate-500 hover:bg-slate-900">Talk to a Developer</a>
        </div>
      </div>
    </section>

    <section>
      <div class="mx-auto max-w-4xl px-6 py-20 sm:px-8 lg:py-24">
        <div class="text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">FAQ</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Frequently asked questions</h2>
        </div>
        <div class="mt-12 divide-y divide-slate-200 border-y border-slate-200">
          {faqs.map((faq) => (
            <details class="group py-6">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-left text-lg font-semibold text-slate-950">
                <span>{faq.question}</span>
                <svg class="h-5 w-5 shrink-0 text-slate-500 transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
              </summary>
              <p class="mt-4 max-w-3xl leading-7 text-slate-600">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-4xl px-6 py-16 text-center sm:px-8">
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Start with a free website health check.</h2>
        <p class="mt-4 text-slate-600">Find the problems. Understand what matters. Fix what needs fixing.</p>
        <a href="#audit-form" class="mt-7 inline-flex items-center justify-center rounded-xl bg-slate-950 px-7 py-4 text-sm font-semibold text-white transition hover:bg-slate-800">Analyze My Website</a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const form = document.querySelector("#audit-form");
  const input = document.querySelector("#website-url");
  const button = document.querySelector("#audit-submit");
  const buttonText = document.querySelector("#button-text");
  const spinner = document.querySelector("#button-spinner");
  const message = document.querySelector("#form-message");
  const report = document.querySelector("#audit-report");
  const reportUrl = document.querySelector("#report-url");
  const overallScore = document.querySelector("#overall-score");
  const scoreLabel = document.querySelector("#score-label");
  const overallBar = document.querySelector("#overall-bar");
  const categoryScores = document.querySelector("#category-scores");
  const issuesList = document.querySelector("#issues-list");
  const issueTotal = document.querySelector("#issue-total");
  const criticalCount = document.querySelector("#critical-count");
  const warningCount = document.querySelector("#warning-count");
  const suggestionCount = document.querySelector("#suggestion-count");
  const passedCount = document.querySelector("#passed-count");
  const newAudit = document.querySelector("#new-audit");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const rawUrl = input?.value?.trim();
    if (!rawUrl) {
      showMessage("Please enter your website URL.", "error");
      input?.focus();
      return;
    }

    let url;
    try {
      url = new URL(/^https?:\/\//i.test(rawUrl) ? rawUrl : `https://${rawUrl}`);
    } catch {
      showMessage("Please enter a valid website URL.", "error");
      input?.focus();
      return;
    }

    if (!["http:", "https:"].includes(url.protocol)) {
      showMessage("Please enter a valid HTTP or HTTPS website URL.", "error");
      return;
    }

    setLoading(true);
    showMessage("", "");

    try {
      const response = await fetch("/.netlify/functions/audit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ url: url.href }),
      });

      let data;
      try {
        data = await response.json();
      } catch {
        throw new Error("The audit server returned an invalid response.");
      }

      if (!response.ok || !data?.success || !data?.report) {
        throw new Error(data?.error || "Unable to analyze this website.");
      }

      renderReport(data.report);
      report?.classList.remove("hidden");
      report?.scrollIntoView({ behavior: "smooth", block: "start" });
    } catch (error) {
      console.error("Audit failed:", error);
      showMessage(error?.message || "Something went wrong while analyzing the website.", "error");
    } finally {
      setLoading(false);
    }
  });

  newAudit?.addEventListener("click", () => {
    report?.classList.add("hidden");
    input?.focus();
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  function renderReport(data) {
    const score = Number(data.score ?? 0);
    const categories = data.categories || {};
    const summary = data.summary || {};
    const issues = Array.isArray(data.issues) ? data.issues : [];

    if (reportUrl) reportUrl.textContent = data.url || "";
    if (overallScore) overallScore.textContent = String(score);
    if (scoreLabel) scoreLabel.textContent = getScoreLabel(score);
    if (overallBar) overallBar.style.width = `${Math.max(0, Math.min(100, score))}%`;

    if (criticalCount) criticalCount.textContent = String(summary.critical ?? 0);
    if (warningCount) warningCount.textContent = String(summary.warnings ?? 0);
    if (suggestionCount) suggestionCount.textContent = String(summary.suggestions ?? 0);
    if (passedCount) passedCount.textContent = String(summary.passed ?? 0);
    if (issueTotal) issueTotal.textContent = `${issues.length} ${issues.length === 1 ? "issue" : "issues"}`;

    const labels = {
      seo: "SEO",
      technical: "Technical",
      accessibility: "Accessibility",
      performance: "Performance",
      security: "Security",
    };

    if (categoryScores) {
      categoryScores.innerHTML = Object.entries(labels).map(([key, label]) => {
        const value = Number(categories[key] ?? 0);
        return `
          <div>
            <div class="mb-2 flex items-center justify-between gap-4 text-sm">
              <span class="font-medium text-slate-700">${escapeHtml(label)}</span>
              <span class="font-semibold text-slate-950">${value}/100</span>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-slate-100">
              <div class="h-full rounded-full bg-slate-950 transition-all duration-700" style="width:${Math.max(0, Math.min(100, value))}%"></div>
            </div>
          </div>`;
      }).join("");
    }

    if (issuesList) {
      if (!issues.length) {
        issuesList.innerHTML = `
          <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-6">
            <p class="font-semibold text-emerald-900">No detected issues in the current checks.</p>
            <p class="mt-2 text-sm leading-6 text-emerald-800">That is a good starting point. Keep monitoring the website as content and code change.</p>
          </div>`;
        return;
      }

      issuesList.innerHTML = issues.map((issue) => {
        const severity = String(issue.severity || "suggestion").toLowerCase();
        const style = severityStyles(severity);
        return `
          <article class="rounded-2xl border ${style.border} ${style.bg} p-5">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded-full px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide ${style.badge}">${escapeHtml(severity)}</span>
                  <span class="text-xs font-medium uppercase tracking-wide text-slate-500">${escapeHtml(issue.category || "General")}</span>
                </div>
                <h4 class="mt-3 text-base font-semibold text-slate-950">${escapeHtml(issue.title || issue.message || "Website issue")}</h4>
                ${issue.description ? `<p class="mt-2 text-sm leading-6 text-slate-700">${escapeHtml(issue.description)}</p>` : ""}
                ${issue.recommendation ? `<p class="mt-3 text-sm font-medium leading-6 text-slate-900"><span class="font-semibold">Recommendation:</span> ${escapeHtml(issue.recommendation)}</p>` : ""}
              </div>
            </div>
          </article>`;
      }).join("");
    }
  }

  function severityStyles(severity) {
    if (severity === "critical") return { border: "border-red-200", bg: "bg-red-50", badge: "bg-red-100 text-red-700" };
    if (severity === "warning") return { border: "border-amber-200", bg: "bg-amber-50", badge: "bg-amber-100 text-amber-700" };
    return { border: "border-slate-200", bg: "bg-slate-50", badge: "bg-slate-200 text-slate-700" };
  }

  function getScoreLabel(score) {
    if (score >= 90) return "Excellent website health";
    if (score >= 75) return "Good website health";
    if (score >= 60) return "Needs improvement";
    if (score >= 40) return "Several issues need attention";
    return "Significant issues detected";
  }

  function escapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function setLoading(loading) {
    if (!button || !buttonText || !spinner) return;
    button.disabled = loading;
    buttonText.textContent = loading ? "Analyzing..." : "Analyze My Website";
    spinner.classList.toggle("hidden", !loading);
  }

  function showMessage(text, type) {
    if (!message) return;
    message.textContent = text;
    message.classList.toggle("hidden", !text);
    message.classList.remove("text-red-600", "text-emerald-700", "text-slate-600");
    if (type === "error") message.classList.add("text-red-600");
    else if (type === "success") message.classList.add("text-emerald-700");
    else message.classList.add("text-slate-600");
  }
</script>
