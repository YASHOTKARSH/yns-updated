---
/* Footer.astro */
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-[#deded9] bg-[#f7f7f5] text-[#111111]">
  <div
    class="mx-auto grid max-w-[1240px] grid-cols-1 gap-12 px-6 py-16 md:grid-cols-12"
  >
    <!-- Brand / About -->
    <div class="space-y-5 md:col-span-5">
      <a
        href="/"
        class="group flex items-center gap-2.5 text-lg font-bold tracking-tight text-[#111111]"
      >
        <span
          class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#111] text-sm font-extrabold text-white shadow-sm transition-transform group-hover:scale-105"
        >
          Y
        </span>

        <span>
          YNS Web <span class="text-[#777]">Studio</span>
        </span>
      </a>

      <p class="max-w-sm text-sm leading-relaxed text-[#696969]">
        We build lightning-fast, conversion-focused websites for local
        businesses, gyms, clinics, and enterprises in Jaipur &amp; across India
        who want predictable enquiries and real growth.
      </p>

      <div
        class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.08em] text-[#111]"
      >
        <span
          class="h-2 w-2 rounded-full bg-[#c9ff4a] shadow-[0_0_12px_rgba(201,255,74,0.8)]"
        ></span>

        Based in Jaipur, Rajasthan • Serving Globally
      </div>
    </div>

    <!-- Quick Navigation -->
    <div class="md:col-span-3">
      <h4
        class="text-xs font-bold uppercase tracking-[0.16em] text-[#777]"
      >
        Quick Links
      </h4>

      <ul
        class="mt-4 space-y-2.5 text-xs font-bold uppercase tracking-[0.12em] text-[#696969]"
      >
      <!-- founder -->
       <li>
          <a
            href="/founder"
            class="transition-colors hover:text-[#111]"
          >
            Know the Founder
          </a>
        <li>
          <a
            href="/services"
            class="transition-colors hover:text-[#111]"
          >
            Services
          </a>
        </li>

        <li>
          <a
            href="/results"
            class="transition-colors hover:text-[#111]"
          >
            Results
          </a>
        </li>

        <li>
          <a
            href="/pricing"
            class="transition-colors hover:text-[#111]"
          >
            Pricing
          </a>
        </li>

        <li>
          <a
            href="/about"
            class="transition-colors hover:text-[#111]"
          >
            About
          </a>
        </li>

        <li>
          <a
            href="/contact"
            class="transition-colors hover:text-[#111]"
          >
            Contact
          </a>
        </li>
      </ul>
    </div>

    <!-- Contact Info -->
    <div class="space-y-4 md:col-span-4">
      <h4
        class="text-xs font-bold uppercase tracking-[0.16em] text-[#777]"
      >
        Get In Touch
      </h4>

      <p class="text-sm leading-relaxed text-[#696969]">
        Have questions or want a free website audit? Reach out directly via
        WhatsApp or email.
      </p>

      <div class="space-y-3 pt-2">
        <a
          href="https://wa.me/919352563337"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 text-xs font-bold uppercase tracking-[0.06em] text-[#111] transition-colors hover:text-black"
        >
          <span
            class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#111] text-xs text-white"
            aria-hidden="true"
          >
            💬
          </span>

          WhatsApp: +91 93525 63337
        </a>

        <a
          href="mailto:hello@ynsweb.studio"
          class="flex items-center gap-2.5 text-xs font-bold uppercase tracking-[0.06em] text-[#555] transition-colors hover:text-[#111]"
        >
          <span
            class="flex h-7 w-7 items-center justify-center rounded-lg border border-[#deded9] bg-white text-xs text-[#111]"
            aria-hidden="true"
          >
            ✉️
          </span>

          Email: hello@ynsweb.studio
        </a>
      </div>
    </div>
  </div>

  <!-- Copyright Bar -->
  <div
    class="border-t border-[#deded9] bg-white/60 py-6 text-center text-xs text-[#777]"
  >
    <div
      class="mx-auto flex max-w-[1240px] flex-col items-center justify-between gap-4 px-6 sm:flex-row"
    >
      <p>
        © {currentYear} YNS Web Studio. All rights reserved.
      </p>

      <p class="text-[#888]">
        Crafted with Astro &amp; Tailwind CSS
      </p>
    </div>
  </div>
</footer>