---
// Header.astro
---

<header class="sticky top-0 z-50 w-full border-b border-slate-100 bg-white/90 backdrop-blur-md transition-all">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

    <!-- Logo & Studio Name -->
    <a href="/" class="flex items-center gap-2 text-xl font-extrabold tracking-tight text-slate-900 group">
      <span class="w-8 h-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center font-bold text-sm shadow-sm group-hover:scale-105 transition-transform">Y</span>
      <span>YNS Web <span class="text-emerald-600">Studio</span></span>
    </a>

    <!-- Desktop Navigation (Original Routes) -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600">
      <a href="/services" class="hover:text-slate-900 transition-colors">Services</a>
      <a href="/results" class="hover:text-slate-900 transition-colors">Results</a>
      <a href="/pricing" class="hover:text-slate-900 transition-colors">Pricing</a>
      <a href="/about" class="hover:text-slate-900 transition-colors">About</a>
    </nav>

    <!-- Right Actions / WhatsApp CTA -->
    <div class="flex items-center gap-4">
      <a
        href="https://wa.me/919352563337"
        target="_blank"
        class="hidden sm:inline-flex items-center justify-center rounded-xl bg-slate-900 text-white px-5 py-2.5 text-sm font-semibold hover:bg-slate-800 transition shadow-sm group"
      >
        Get Free Audit
        <svg class="w-4 h-4 ml-1.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>

      <!-- Mobile Menu Trigger -->
      <button aria-label="Toggle Menu" class="md:hidden p-2 rounded-lg text-slate-700 hover:bg-slate-100">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/></svg>
      </button>
    </div>

  </div>
</header>