---
/* Header.astro */
---

<header
  class="sticky top-0 z-50 w-full border-b border-[#deded9] bg-[#f7f7f5]/90 backdrop-blur-md transition-all"
>
  <div
    class="mx-auto flex max-w-[1240px] items-center justify-between px-6 py-4"
  >
    <!-- Logo & Studio Name -->
    <a
      href="/"
      class="group flex items-center gap-2.5 text-lg font-bold tracking-tight text-[#111111]"
    >

      <span>
        YNS Web <span class="text-[#777]">Studio</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav
      class="hidden items-center gap-8 text-xs font-bold uppercase tracking-[0.14em] text-[#696969] md:flex"
    >
      <a
        href="/services"
        class="transition-colors hover:text-[#111]"
      >
        Services
      </a>

      <a
        href="/results"
        class="transition-colors hover:text-[#111]"
      >
        Results
      </a>

      <a
        href="/pricing"
        class="transition-colors hover:text-[#111]"
      >
        Pricing
      </a>

      <a
        href="/about"
        class="transition-colors hover:text-[#111]"
      >
        About
      </a>
    </nav>

    <!-- Right Actions / WhatsApp CTA -->
    <div class="flex items-center gap-4">
      <a
        href="https://wa.me/919352563337"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center justify-center gap-2 rounded-full bg-[#111] px-5 py-2.5 text-xs font-bold uppercase tracking-[0.08em] text-white shadow-sm transition-transform hover:-translate-y-0.5 hover:bg-black sm:inline-flex"
      >
        Get Free Audit

        <svg
          class="h-3.5 w-3.5 fill-none stroke-current stroke-[2]"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5 12h14M13 6l6 6-6 6"
          />
        </svg>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="menu-toggle"
        type="button"
        aria-label="Toggle Menu"
        aria-expanded="false"
        class="flex h-10 w-10 items-center justify-center rounded-xl border border-[#deded9] bg-white text-[#111] transition-colors hover:bg-slate-50 md:hidden"
      >
        <svg
          id="menu-icon"
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16m-7 6h7"
          />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation Drawer -->
  <div
    id="mobile-menu"
    class="absolute left-0 top-full hidden w-full border-b border-[#deded9] bg-[#f7f7f5] px-6 py-6 shadow-xl md:hidden"
  >
    <nav
      class="flex flex-col gap-4 text-sm font-bold uppercase tracking-[0.12em] text-[#444]"
    >
      <a
        href="/services"
        class="rounded-lg p-2 transition-colors hover:bg-white hover:text-[#111]"
      >
        Services
      </a>

      <a
        href="/results"
        class="rounded-lg p-2 transition-colors hover:bg-white hover:text-[#111]"
      >
        Results
      </a>

      <a
        href="/pricing"
        class="rounded-lg p-2 transition-colors hover:bg-white hover:text-[#111]"
      >
        Pricing
      </a>

      <a
        href="/about"
        class="rounded-lg p-2 transition-colors hover:bg-white hover:text-[#111]"
      >
        About
      </a>

      <div class="border-t border-[#deded9] pt-4">
        <a
          href="https://wa.me/919352563337"
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#111] py-3 text-xs font-bold uppercase tracking-[0.08em] text-white"
        >
          Get Free Audit

          <svg
            class="h-3.5 w-3.5 fill-none stroke-current stroke-[2]"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 12h14M13 6l6 6-6 6"
            />
          </svg>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener("click", () => {
      const isHidden = mobileMenu.classList.toggle("hidden");

      toggleBtn.setAttribute(
        "aria-expanded",
        String(!isHidden)
      );
    });

    // Close mobile menu after clicking a navigation link
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
        toggleBtn.setAttribute("aria-expanded", "false");
      });
    });

    // Close menu when resizing to desktop
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768) {
        mobileMenu.classList.add("hidden");
        toggleBtn.setAttribute("aria-expanded", "false");
      }
    });
  }
</script>