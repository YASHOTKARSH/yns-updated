        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-10 w-10 items-center justify-center rounded-xl border border-[#deded9] bg-white text-[#111] transition-colors hover:bg-slate-50 md:hidden"
      >
        <svg
