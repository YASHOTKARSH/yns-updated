<script>
  const toggleBtn = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  const servicesDropdownToggle = document.getElementById(
    "services-dropdown-toggle"
  );

  const servicesDropdown = document.getElementById(
    "services-dropdown"
  );

  const servicesChevron = document.getElementById(
    "services-chevron"
  );

  const servicesDropdownWrapper = document.getElementById(
    "services-dropdown-wrapper"
  );

  const mobileServicesToggle = document.getElementById(
    "mobile-services-toggle"
  );

  const mobileServicesMenu = document.getElementById(
    "mobile-services-menu"
  );

  const mobileServicesChevron = document.getElementById(
    "mobile-services-chevron"
  );

  const closeDesktopServices = () => {
    if (!servicesDropdown || !servicesDropdownToggle) return;

    servicesDropdown.classList.add(
      "invisible",
      "opacity-0",
      "translate-y-2"
    );

    servicesDropdown.classList.remove(
      "visible",
      "translate-y-0"
    );

    servicesDropdownToggle.setAttribute(
      "aria-expanded",
      "false"
    );

    servicesDropdown?.setAttribute(
      "aria-hidden",
      "true"
    );

    servicesChevron?.classList.remove(
      "rotate-180"
    );
  };

  const openDesktopServices = () => {
    if (!servicesDropdown || !servicesDropdownToggle) return;

    servicesDropdown.classList.remove(
      "invisible",
      "opacity-0",
      "translate-y-2"
    );

    servicesDropdown.classList.add(
      "visible",
      "translate-y-0"
    );

    servicesDropdownToggle.setAttribute(
      "aria-expanded",
      "true"
    );

    servicesDropdown.setAttribute(
      "aria-hidden",
      "false"
    );

    servicesChevron?.classList.add(
      "rotate-180"
    );
  };

  const closeMobileMenu = () => {
    mobileMenu?.classList.add("hidden");

    toggleBtn?.setAttribute(
      "aria-expanded",
      "false"
    );

    mobileServicesMenu?.classList.add("hidden");

    mobileServicesToggle?.setAttribute(
      "aria-expanded",
      "false"
    );

    mobileServicesChevron?.classList.remove(
      "rotate-180"
    );
  };

  // Desktop services dropdown
  servicesDropdownToggle?.addEventListener(
    "click",
    (event) => {
      event.stopPropagation();

      const isOpen =
        servicesDropdownToggle.getAttribute(
          "aria-expanded"
        ) === "true";

      if (isOpen) {
        closeDesktopServices();
      } else {
        openDesktopServices();
      }
    }
  );

  // Prevent dropdown click from closing itself
  servicesDropdownWrapper?.addEventListener(
    "click",
    (event) => {
      event.stopPropagation();
    }
  );

  // Close dropdown when clicking outside
  document.addEventListener("click", () => {
    closeDesktopServices();
  });

  // Close dropdown with Escape
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeDesktopServices();
      closeMobileMenu();
    }
  });

  // Mobile main menu
  toggleBtn?.addEventListener("click", () => {
    const isHidden =
      mobileMenu?.classList.toggle("hidden");

    toggleBtn.setAttribute(
      "aria-expanded",
      String(!isHidden)
    );

    closeDesktopServices();
  });

  // Mobile services accordion
  mobileServicesToggle?.addEventListener(
    "click",
    () => {
      const isHidden =
        mobileServicesMenu?.classList.toggle(
          "hidden"
        );

      mobileServicesToggle.setAttribute(
        "aria-expanded",
        String(!isHidden)
      );

      mobileServicesChevron?.classList.toggle(
        "rotate-180"
      );
    }
  );

  // Close mobile menu after navigation
  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      closeMobileMenu();
    });
  });

  // Close everything when switching to desktop
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768) {
      closeMobileMenu();
    }

    if (window.innerWidth < 768) {
      closeDesktopServices();
    }
  });
</script>

<style>
  .service-dropdown-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 46px;
    padding: 0.7rem 0.75rem;
    border-radius: 0.7rem;
    color: #444;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .service-dropdown-link:hover {
    background: #fff;
    color: #111;
  }

  .service-dropdown-link svg {
    width: 0.85rem;
    height: 0.85rem;
    flex: 0 0 auto;
    opacity: 0;
    transform: translateX(-3px);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .service-dropdown-link:hover svg {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 767px) {
    #mobile-services-menu {
      max-height: 55vh;
      overflow-y: auto;
    }
  }
</style>