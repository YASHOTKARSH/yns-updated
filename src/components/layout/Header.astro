      <span>
        YNS Web <span class="text-[#777]">Studio</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav
      aria-label="Main navigation"
      class="hidden items-center gap-7 text-xs font-bold uppercase tracking-[0.14em] text-[#696969] md:flex"
    >
      <!-- Services Dropdown -->
      <div class="relative" id="services-dropdown-wrapper">
        <button
          id="services-dropdown-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="services-dropdown"
          class="group inline-flex items-center gap-1.5 transition-colors hover:text-[#111]"
        >
          Services

