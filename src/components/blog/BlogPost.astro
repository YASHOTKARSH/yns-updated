---
const { blog } = Astro.props;

const whatsappUrl =
  "https://wa.me/919352563337?text=Hi%20YNS%20Web%20Studio%2C%20I%20want%20to%20discuss%20a%20website%20for%20my%20business.";

const services = blog?.relatedServices ?? [];

const getText = (section) => section?.content ?? section?.text ?? "";

const getHeading = (section) =>
  section?.title ?? section?.text ?? section?.heading ?? "";

const getItems = (section) => section?.items ?? [];

const getIntroParagraphs = (section) => {
  if (Array.isArray(section?.paragraphs)) return section.paragraphs;
  if (section?.content) return [section.content];
  if (section?.text) return [section.text];
  return [];
};

/*
 * Data-driven inline internal links.
 * Example in blogs.js:
 * {
 *   type: "paragraph",
 *   text: "Run the YNS Website Health Checker...",
 *   links: [
 *     {
 *       text: "YNS Website Health Checker",
 *       href: "/tools/website-health-checker/"
 *     }
 *   ]
 * }
 */
const getLinkedParts = (text, links = []) => {
  if (!text) return [];
  if (!Array.isArray(links) || links.length === 0) {
    return [{ type: "text", value: text }];
  }

  const matches = links
    .filter((link) => link?.text && link?.href)
    .map((link) => ({
      ...link,
      index: text.indexOf(link.text),
    }))
    .filter((link) => link.index >= 0)
    .sort((a, b) => a.index - b.index);

  if (!matches.length) {
    return [{ type: "text", value: text }];
  }

  const parts = [];
  let cursor = 0;

  for (const link of matches) {
    if (link.index < cursor) continue;

    if (link.index > cursor) {
      parts.push({
        type: "text",
        value: text.slice(cursor, link.index),
      });
    }

    parts.push({
      type: "link",
      value: link.text,
      href: link.href,
    });

    cursor = link.index + link.text.length;
  }

  if (cursor < text.length) {
    parts.push({
      type: "text",
      value: text.slice(cursor),
    });
  }

  return parts;
};

const serviceIcon = (serviceTitle) => {
  if (serviceTitle?.toLowerCase().includes("next")) {
    return `
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 4h16v16H4z" stroke="currentColor" stroke-width="1.7"/>
        <path d="M8 16V8l8 8V8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    `;
  }

  if (serviceTitle?.toLowerCase().includes("react")) {
    return `
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <ellipse cx="12" cy="12" rx="9" ry="3.8" stroke="currentColor" stroke-width="1.5"/>
        <ellipse cx="12" cy="12" rx="9" ry="3.8" transform="rotate(60 12 12)" stroke="currentColor" stroke-width="1.5"/>
        <ellipse cx="12" cy="12" rx="9" ry="3.8" transform="rotate(120 12 12)" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
      </svg>
    `;
  }

  return `
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M5 5h14v14H5z" stroke="currentColor" stroke-width="1.7"/>
      <path d="m8 15 3-6 2.5 4 1.5-2 2 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  `;
};
---

<article class="blog-article">
  {
    blog?.image && (
      <figure class="blog-featured-image">
        <img
          src={blog.image}
          alt={blog.imageAlt || blog.title}
          width="1600"
          height="900"
          loading="eager"
          decoding="async"
        />
      </figure>
    )
  }

  {
    blog?.sections?.map((section, index) => (
      <>
        {section.type === "intro" && (
          <div class="article-intro">
            {getIntroParagraphs(section).map((paragraph) => (
              <p>
                {getLinkedParts(paragraph, section.links).map((part) =>
                  part.type === "link" ? (
                    <a href={part.href} class="inline-link">
                      {part.value}
                    </a>
                  ) : (
                    part.value
                  ),
                )}
              </p>
            ))}
          </div>
        )}

        {section.type === "heading" && (
          <>
            <h2>{getHeading(section)}</h2>

            {index === 3 && (
              <aside class="context-cta">
                <div class="context-cta-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path
                      d="M12 3v18M3 12h18"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                    />
                  </svg>
                </div>
                <div class="context-cta-content">
                  <span class="context-cta-label">Planning a new website?</span>
                  <h3>Not sure which technology is right for your project?</h3>
                  <p>
                    Tell us what you're building and we'll help you choose the
                    right approach based on your goals, SEO needs, performance
                    requirements and budget.
                  </p>
                  <div class="context-cta-actions">
                    <a href="/contact/" class="cta-link primary">
                      Discuss Your Project
                    </a>
                    <a
                      href={whatsappUrl}
                      class="cta-link secondary"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      WhatsApp Us
                    </a>
                  </div>
                </div>
              </aside>
            )}
          </>
        )}

        {section.type === "paragraph" && (
          <p>
            {getLinkedParts(getText(section), section.links).map((part) =>
              part.type === "link" ? (
                <a href={part.href} class="inline-link">
                  {part.value}
                </a>
              ) : (
                part.value
              ),
            )}
          </p>
        )}

        {section.type === "list" && (
          <ul>
            {getItems(section).map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}

        {section.type === "table" && (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  {section.headers?.map((header) => (
                    <th>{header}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {section.rows?.map((row) => (
                  <tr>
                    {row.map((cell) => (
                      <td>{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {section.type === "cta" && (
          <section class="data-cta">
            {section.eyebrow && (
              <span class="data-cta-eyebrow">{section.eyebrow}</span>
            )}
            {section.title && <h3>{section.title}</h3>}
            {section.description && <p>{section.description}</p>}
            {section.buttonText && section.buttonHref && (
              <a href={section.buttonHref} class="data-cta-button">
                {section.buttonText}
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path
                    d="M4 10h12M11 5l5 5-5 5"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            )}
          </section>
        )}

        {section.type === "paragraph" && index === 6 && (
          <aside class="mid-cta">
            <div class="mid-cta-top">
              <span class="eyebrow">Build the right website</span>
              <span class="mid-cta-badge">React + Next.js Development</span>
            </div>
            <h3>
              Have a project in mind?
              <br />
              Let's turn the idea into a real website.
            </h3>
            <p>
              Whether you need a business website, landing page, custom React
              interface or complete Next.js application, YNS Web Studio can
              help.
            </p>
            <div class="mid-cta-actions">
              <a href="/services/nextjs-development/" class="mid-cta-button">
                Explore Next.js Development
              </a>
              <a
                href="/services/react-development/"
                class="mid-cta-button outline"
              >
                Explore React Development
              </a>
            </div>
          </aside>
        )}
      </>
    ))
  }

  {
    services.length > 0 && (
      <section class="related-services">
        <div class="section-heading">
          <span class="eyebrow">Relevant services</span>
          <h2>Want to build something similar?</h2>
          <p>
            If you're researching website development, these services may be a
            useful starting point.
          </p>
        </div>

        <div class="service-grid">
          {services.map((service) => (
            <a href={service.href} class="service-card">
              <div class="service-icon" set:html={serviceIcon(service.title)} />
              <div class="service-content">
                <h3>{service.title}</h3>
                <span>Explore service →</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="pre-final-cta">
    <div class="pre-final-content">
      <span class="eyebrow">Your project starts with a conversation</span>
      <h2>Still deciding what technology your website needs?</h2>
      <p>
        Share your idea, existing website or business requirements and we'll
        help you understand the best direction.
      </p>
      <div class="pre-final-actions">
        <a href="/contact/" class="large-button primary">Start a Project</a>
        <a
          href={whatsappUrl}
          class="large-button secondary"
          target="_blank"
          rel="noopener noreferrer">Talk on WhatsApp</a
        >
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="final-cta-inner">
      <div class="final-cta-copy">
        <span class="eyebrow">YNS Web Studio</span>
        <h2>Have a website idea?<br />Let's build it properly.</h2>
        <p>
          We build modern websites focused on performance, usability, SEO and
          business results.
        </p>
      </div>
      <div class="final-cta-actions">
        <a href="/contact/" class="final-button">Tell Us About Your Project →</a
        >
        <a
          href={whatsappUrl}
          class="final-whatsapp"
          target="_blank"
          rel="noopener noreferrer">WhatsApp YNS Web Studio</a
        >
      </div>
    </div>
  </section>
</article>

