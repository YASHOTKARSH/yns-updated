---
const { blog } = Astro.props;

const whatsappUrl =
  "https://wa.me/919352563337?text=Hi%20YNS%20Web%20Studio%2C%20I%20want%20to%20discuss%20a%20React%20or%20Next.js%20website%20for%20my%20business.";

const services = blog.relatedServices ?? [];

const serviceIcon = (serviceTitle) => {
  if (serviceTitle?.toLowerCase().includes("next")) {
    return `
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 4h16v16H4z" stroke="currentColor" stroke-width="1.7"/>
        <path d="M8 16V8l8 8V8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    `;
  }

  return `
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M5 5h14v14H5z" stroke="currentColor" stroke-width="1.7"/>
      <path d="m8 15 3-6 2.5 4 1.5-2 2 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  `;
};

const getText = (section) => section.content ?? section.text ?? "";

const getHeading = (section) =>
  section.title ?? section.text ?? section.heading ?? "";

const getItems = (section) => section.items ?? [];

const getIntroParagraphs = (section) => {
  if (Array.isArray(section.paragraphs)) return section.paragraphs;
  if (section.content) return [section.content];
  if (section.text) return [section.text];
  return [];
};
---

<article class="blog-article">

  <!-- =========================================================
       BLOG HERO IMAGE
  ========================================================== -->

  {blog.image && (
    <figure class="blog-featured-image">
      <img
        src={blog.image}
        alt={blog.imageAlt || blog.title}
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
      />
    </figure>
  )}

  <!-- =========================================================
       ARTICLE CONTENT
  ========================================================== -->

  {
    blog.sections?.map((section, index) => (
      <>
        {section.type === "intro" && (
          <div class="article-intro">
            {getIntroParagraphs(section).map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )}

        {section.type === "heading" && (
          <>
            <h2>{getHeading(section)}</h2>

            {index === 3 && (
              <aside class="context-cta">
                <div class="context-cta-icon">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M12 3v18M3 12h18"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                    />
                  </svg>
                </div>

                <div class="context-cta-content">
                  <span class="context-cta-label">
                    Planning a new website?
                  </span>

                  <h3>
                    Not sure whether React or Next.js is right for your
                    project?
                  </h3>

                  <p>
                    Tell us what you're building and we'll help you choose
                    the right approach based on your business goals, SEO
                    needs, performance requirements and budget.
                  </p>

                  <div class="context-cta-actions">
                    <a href="/contact" class="cta-link primary">
                      Discuss Your Project

                      <svg
                        viewBox="0 0 20 20"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M4 10h12M11 5l5 5-5 5"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>

                    <a
                      href={whatsappUrl}
                      class="cta-link secondary"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      WhatsApp Us
                    </a>
                  </div>
                </div>
              </aside>
            )}
          </>
        )}

        {section.type === "paragraph" && (
          <p>{getText(section)}</p>
        )}

        {section.type === "list" && (
          <ul>
            {getItems(section).map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}

        {section.type === "table" && (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  {section.headers?.map((header) => (
                    <th>{header}</th>
                  ))}
                </tr>
              </thead>

              <tbody>
                {section.rows?.map((row) => (
                  <tr>
                    {row.map((cell) => (
                      <td>{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        <!-- MID ARTICLE CTA -->

        {section.type === "paragraph" && index === 6 && (
          <aside class="mid-cta">
            <div class="mid-cta-top">
              <span class="eyebrow">Build the right website</span>

              <span class="mid-cta-badge">
                React + Next.js Development
              </span>
            </div>

            <h3>
              Have a project in mind?
              <br />
              Let's turn the idea into a real website.
            </h3>

            <p>
              Whether you need a business website, high-performance
              landing page, custom React interface or a complete Next.js
              application, YNS Web Studio can help you plan and build it.
            </p>

            <div class="mid-cta-actions">
              <a
                href="/services/nextjs-development"
                class="mid-cta-button"
              >
                Explore Next.js Development

                <svg
                  viewBox="0 0 20 20"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M4 10h12M11 5l5 5-5 5"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>

              <a
                href="/services/react-development"
                class="mid-cta-button outline"
              >
                Explore React Development
              </a>
            </div>
          </aside>
        )}
      </>
    ))
  }

  <!-- =========================================================
       RELATED SERVICES
  ========================================================== -->

  {
    services.length > 0 && (
      <section class="related-services">
        <div class="section-heading">
          <span class="eyebrow">Relevant services</span>

          <h2>Want to build something similar?</h2>

          <p>
            If you're researching React or Next.js because you are
            planning a website or web application, these services may
            be a good starting point.
          </p>
        </div>

        <div class="service-grid">
          {services.map((service) => (
            <a href={service.href} class="service-card">
              <div
                class="service-icon"
                set:html={serviceIcon(service.title)}
              />

              <div class="service-content">
                <h3>{service.title}</h3>

                <span>
                  Explore service

                  <svg
                    viewBox="0 0 20 20"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M4 10h12M11 5l5 5-5 5"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- =========================================================
       PRE FINAL CTA
  ========================================================== -->

  <section class="pre-final-cta">
    <div class="pre-final-content">
      <span class="eyebrow">Your project starts with a conversation</span>

      <h2>
        Still deciding what technology
        <br />
        your website needs?
      </h2>

      <p>
        You don't need to have everything figured out before contacting us.
        Share your idea, existing website or business requirements and we'll
        help you understand the best direction.
      </p>

      <div class="pre-final-actions">
        <a href="/contact" class="large-button primary">
          Start a Project

          <svg
            viewBox="0 0 20 20"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4 10h12M11 5l5 5-5 5"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>

        <a
          href={whatsappUrl}
          class="large-button secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          Talk on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================
       FINAL CTA
  ========================================================== -->

  <section class="final-cta">
    <div class="final-cta-inner">
      <div class="final-cta-copy">
        <span class="eyebrow">YNS Web Studio</span>

        <h2>
          Have a website idea?
          <br />
          Let's build it properly.
        </h2>

        <p>
          We build modern React and Next.js websites focused on performance,
          usability, SEO and business results.
        </p>
      </div>

      <div class="final-cta-actions">
        <a href="/contact" class="final-button">
          Tell Us About Your Project

          <svg
            viewBox="0 0 20 20"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4 10h12M11 5l5 5-5 5"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>

        <a
          href={whatsappUrl}
          class="final-whatsapp"
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp YNS Web Studio
        </a>
      </div>
    </div>
  </section>

</article>

<style>
  .blog-article {
    color: #334155;
    font-size: 1.0625rem;
    line-height: 1.9;
  }

  /* =========================================================
     FEATURED IMAGE
  ========================================================== */

  .blog-featured-image {
    position: relative;
    width: 100%;
    margin: 0 0 3rem;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    border-radius: 1.25rem;
    background: #f8fafc;
  }

  .blog-featured-image::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.25);
  }

  .blog-featured-image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .blog-article p {
    margin: 0 0 1.45rem;
  }

  .article-intro {
    margin-bottom: 3rem;
    color: #475569;
    font-size: 1.13rem;
    line-height: 1.9;
  }

  .article-intro p:last-child {
    margin-bottom: 0;
  }

  .blog-article h2 {
    margin: 3.3rem 0 1.15rem;
    color: #0f172a;
    font-size: clamp(1.55rem, 2.8vw, 2.1rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.035em;
  }

  .blog-article ul {
    margin: 0 0 2rem;
    padding-left: 1.45rem;
  }

  .blog-article li {
    margin: 0.6rem 0;
    padding-left: 0.3rem;
  }

  /* =========================================================
     TABLE
  ========================================================== */

  .table-wrap {
    width: 100%;
    margin: 1.6rem 0 2.4rem;
    overflow-x: auto;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    background: #fff;
  }

  table {
    width: 100%;
    min-width: 680px;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 1rem 1.1rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid #e2e8f0;
  }

  th {
    color: #0f172a;
    background: #f8fafc;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  td {
    color: #475569;
    font-size: 0.95rem;
  }

  tr:last-child td {
    border-bottom: 0;
  }

  /* =========================================================
     SHARED
  ========================================================== */

  .eyebrow {
    display: inline-block;
    color: #64748b;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* =========================================================
     CONTEXT CTA
  ========================================================== */

  .context-cta {
    display: flex;
    gap: 1.1rem;
    margin: 2.6rem 0 3.1rem;
    padding: 1.35rem;
    border: 1px solid #e2e8f0;
    border-radius: 1.2rem;
    background: #f8fafc;
  }

  .context-cta-icon {
    flex: 0 0 auto;
    display: grid;
    width: 2.8rem;
    height: 2.8rem;
    place-items: center;
    border: 1px solid #e2e8f0;
    border-radius: 0.8rem;
    background: #fff;
    color: #0f172a;
  }

  .context-cta-icon svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .context-cta-content {
    min-width: 0;
  }

  .context-cta-label {
    display: block;
    margin-bottom: 0.35rem;
    color: #64748b;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .context-cta h3 {
    margin: 0 0 0.55rem;
    color: #0f172a;
    font-size: 1.2rem;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .context-cta p {
    max-width: 760px;
    margin-bottom: 1rem;
    color: #64748b;
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .context-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.7rem;
    padding: 0.65rem 1rem;
    border-radius: 0.7rem;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
    transition: 0.2s ease;
  }

  .cta-link svg,
  .large-button svg,
  .final-button svg,
  .mid-cta-button svg {
    width: 1rem;
    height: 1rem;
  }

  .cta-link.primary {
    background: #0f172a;
    color: #fff;
  }

  .cta-link.primary:hover {
    background: #1e293b;
  }

  .cta-link.secondary {
    border: 1px solid #cbd5e1;
    background: #fff;
    color: #0f172a;
  }

  .cta-link.secondary:hover {
    border-color: #94a3b8;
  }

  /* =========================================================
     MID CTA
  ========================================================== */

  .mid-cta {
    margin: 3rem 0;
    padding: clamp(1.4rem, 4vw, 2rem);
    border: 1px solid #dbe2ea;
    border-radius: 1.25rem;
    background:
      linear-gradient(
        135deg,
        #f8fafc 0%,
        #ffffff 60%,
        #f1f5f9 100%
      );
  }

  .mid-cta-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .mid-cta-badge {
    padding: 0.45rem 0.7rem;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    background: #fff;
    color: #475569;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .mid-cta h3 {
    margin: 1rem 0 0.7rem;
    color: #0f172a;
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .mid-cta p {
    max-width: 700px;
    color: #64748b;
    line-height: 1.75;
  }

  .mid-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.2rem;
  }

  .mid-cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.8rem 1rem;
    border-radius: 0.75rem;
    background: #0f172a;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: 0.2s ease;
  }

  .mid-cta-button:hover {
    background: #1e293b;
  }

  .mid-cta-button.outline {
    border: 1px solid #cbd5e1;
    background: #fff;
    color: #0f172a;
  }

  .mid-cta-button.outline:hover {
    border-color: #94a3b8;
  }

  /* =========================================================
     RELATED SERVICES
  ========================================================== */

  .related-services {
    margin-top: 5rem;
    padding-top: 3.5rem;
    border-top: 1px solid #e2e8f0;
  }

  .section-heading {
    max-width: 720px;
  }

  .section-heading h2 {
    margin-top: 0.7rem;
    margin-bottom: 0.75rem;
  }

  .section-heading p {
    color: #64748b;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 1.5rem;
  }

  .service-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.95rem;
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .service-card:hover {
    transform: translateY(-2px);
    border-color: #cbd5e1;
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.06);
  }

  .service-icon {
    display: grid;
    flex: 0 0 auto;
    width: 2.6rem;
    height: 2.6rem;
    place-items: center;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    background: #f8fafc;
    color: #0f172a;
  }

  .service-icon svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .service-content {
    min-width: 0;
  }

  .service-content h3 {
    margin: 0;
    color: #0f172a;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .service-content span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.2rem;
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .service-content svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  /* =========================================================
     PRE FINAL CTA
  ========================================================== */

  .pre-final-cta {
    margin-top: 5rem;
    padding: 4rem 0;
    border-top: 1px solid #e2e8f0;
  }

  .pre-final-content {
    max-width: 760px;
  }

  .pre-final-content h2 {
    margin: 0.8rem 0 1rem;
    color: #0f172a;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .pre-final-content p {
    max-width: 680px;
    color: #64748b;
  }

  .pre-final-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }

  .large-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.15rem;
    border-radius: 0.75rem;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }

  .large-button.primary {
    background: #0f172a;
    color: #fff;
  }

  .large-button.secondary {
    border: 1px solid #cbd5e1;
    color: #0f172a;
  }

  /* =========================================================
     FINAL CTA
  ========================================================== */

  .final-cta {
    margin-top: 1rem;
    border-radius: 1.4rem;
    background: #0f172a;
    color: #fff;
  }

  .final-cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.5rem, 5vw, 3rem);
  }

  .final-cta-copy {
    max-width: 650px;
  }

  .final-cta-copy .eyebrow {
    color: #94a3b8;
  }

  .final-cta-copy h2 {
    margin: 0.8rem 0 1rem;
    color: #fff;
    font-size: clamp(2rem, 5vw, 3.3rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .final-cta-copy p {
    margin: 0;
    color: #cbd5e1;
  }

  .final-cta-actions {
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    gap: 0.7rem;
    min-width: 220px;
  }

  .final-button,
  .final-whatsapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1rem;
    border-radius: 0.75rem;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }

  .final-button {
    background: #fff;
    color: #0f172a;
  }

  .final-whatsapp {
    border: 1px solid rgba(255,255,255,0.2);
    color: #fff;
  }

  @media (max-width: 768px) {
    .blog-featured-image {
      margin-bottom: 2.2rem;
      border-radius: 1rem;
    }

    .context-cta {
      flex-direction: column;
    }

    .service-grid {
      grid-template-columns: 1fr;
    }

    .final-cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .final-cta-actions {
      width: 100%;
    }

    .final-button,
    .final-whatsapp {
      width: 100%;
    }
  }

  @media (max-width: 520px) {
    .mid-cta-actions,
    .pre-final-actions {
      flex-direction: column;
    }

    .mid-cta-button,
    .large-button {
      width: 100%;
    }
  }
</style>