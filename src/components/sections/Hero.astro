---
// Hero.astro
---

<section class="relative bg-gradient-to-b from-slate-50 via-white to-slate-50 py-24 md:py-32 overflow-hidden border-b border-slate-100">
  <!-- Subtle eye-soothing ambient blurs -->
  <div class="absolute top-1/4 left-10 w-72 h-72 bg-blue-100/60 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 right-10 w-80 h-80 bg-emerald-100/50 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">

    <!-- Left Content (7 Cols) -->
    <div class="lg:col-span-7 text-left">
      <!-- Trust & Location Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-xs font-semibold text-slate-700 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Top-Rated Web Design Company in Jaipur • Local Business Experts
      </div>

      <!-- SEO-Optimized Main Headline targeting high-value searches -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.12] text-slate-900">
        Affordable <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-600 to-emerald-600">Web Development in Jaipur</span> That Generates Real Leads
      </h1>

      <!-- Supporting Subheadline with Niche Targeting (Gyms, Clinics, Local Brands) -->
      <p class="mt-6 text-lg md:text-xl text-slate-600 font-normal leading-relaxed">
        We help gyms, clinics, retailers, and local service businesses across Rajasthan and India turn website visitors into loyal clients with lightning-fast, mobile-first, high-converting websites.
      </p>

      <!-- Action Buttons -->
      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <a
          href="https://wa.me/919352563337"
          target="_blank"
          class="inline-flex items-center justify-center rounded-xl bg-slate-900 text-white px-7 py-4 font-semibold hover:bg-slate-800 transition shadow-xl shadow-slate-900/10 group"
        >
          Get Free Website Audit on WhatsApp
          <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>

        <a
          href="/services"
          class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-7 py-4 font-semibold text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition shadow-sm"
        >
          View Our Portfolio & Services
        </a>
      </div>

      <!-- Risk Reversal Guarantee & Local Proof -->
      <p class="mt-5 text-xs text-slate-500 flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        No hidden fees. Transparent pricing starting at ₹8,999. Direct developer collaboration.
      </p>
    </div>

    <!-- Right Interactive Showcase Card (5 Cols) -->
    <div class="lg:col-span-5">
      <div class="relative rounded-2xl bg-gradient-to-b from-slate-200 to-slate-100 p-1.5 shadow-2xl border border-slate-200">
        <div class="bg-white rounded-xl p-6 shadow-inner text-left">
          
          <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-4">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-red-400 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block"></span>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">YNS Studio Metrics</span>
          </div>

          <div class="space-y-3">
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
              <div>
                <p class="text-xs text-slate-400 font-medium">Local SEO Ranking</p>
                <p class="text-sm font-bold text-slate-800">Top Tier Indexing</p>
              </div>
              <span class="px-2.5 py-1 rounded-md bg-blue-50 text-blue-600 text-xs font-bold">Optimized</span>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
              <div>
                <p class="text-xs text-slate-400 font-medium">Client Conversion Rate</p>
                <p class="text-sm font-bold text-slate-800">3x More Enquiries</p>
              </div>
              <span class="px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-600 text-xs font-bold">Proven</span>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>Location: Jaipur, Rajasthan</span>
            <span class="text-emerald-600 font-semibold flex items-center gap-1">● Accepting Q4 Projects</span>
          </div>

        </div>
      </div>
    </div>

  </div>
</section>