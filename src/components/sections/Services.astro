---
// Services.astro
---

<section class="bg-gradient-to-b from-white via-slate-50/50 to-white py-24 md:py-32 border-b border-slate-100">
  <div class="max-w-6xl mx-auto px-6 text-center">

    <!-- Section Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-100 text-xs font-semibold text-emerald-600 mb-4 shadow-sm">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
      Specialized Web Solutions
    </div>

    <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
      Web Design Services Built For <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-600">Local Business Growth</span>
    </h2>

    <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto font-normal">
      Whether you run a local gym, medical clinic, retail shop, or service agency in Jaipur, we build high-performance web systems tailored to bring you consistent phone calls and WhatsApp enquiries.
    </p>

    <!-- Services Grid Cards -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8 text-left">

      <!-- Service 1 -->
      <div class="group bg-white p-8 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-emerald-200 transition-all duration-300 relative flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-lg mb-6 group-hover:scale-110 transition-transform">
            🏥
          </div>
          <h3 class="text-xl font-bold text-slate-900 group-hover:text-emerald-600 transition-colors">
            Websites for Clinics & Gyms
          </h3>
          <p class="mt-3 text-slate-600 text-base leading-relaxed">
            Specialized local business websites featuring easy appointment booking, service showcases, and direct WhatsApp consultation buttons.
          </p>
        </div>
        <div class="mt-8 pt-4 border-t border-slate-100 text-xs font-medium text-slate-500 flex flex-col gap-1.5">
          <span class="flex items-center gap-1.5">✓ Instant Appointment Booking UI</span>
          <span class="flex items-center gap-1.5">✓ Local Google Maps Integration</span>
        </div>
      </div>

      <!-- Service 2 -->
      <div class="group bg-white p-8 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-blue-200 transition-all duration-300 relative flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-lg mb-6 group-hover:scale-110 transition-transform">
            ⚡
          </div>
          <h3 class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
            Custom Web Development
          </h3>
          <p class="mt-3 text-slate-600 text-base leading-relaxed">
            Fast, scalable, and secure full-stack web apps and multi-page business websites built using modern React, Next.js, and Astro stacks.
          </p>
        </div>
        <div class="mt-8 pt-4 border-t border-slate-100 text-xs font-medium text-slate-500 flex flex-col gap-1.5">
          <span class="flex items-center gap-1.5">✓ 99+ Lighthouse Speed Score</span>
          <span class="flex items-center gap-1.5">✓ Secure & Scalable Architecture</span>
        </div>
      </div>

      <!-- Service 3 -->
      <div class="group bg-white p-8 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-indigo-200 transition-all duration-300 relative flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-lg mb-6 group-hover:scale-110 transition-transform">
            📈
          </div>
          <h3 class="text-xl font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">
            SEO & Speed Optimization
          </h3>
          <p class="mt-3 text-slate-600 text-base leading-relaxed">
            Rank higher on Google local searches in Jaipur with clean semantic markup, fast load times, and structured metadata optimization.
          </p>
        </div>
        <div class="mt-8 pt-4 border-t border-slate-100 text-xs font-medium text-slate-500 flex flex-col gap-1.5">
          <span class="flex items-center gap-1.5">✓ Local SEO Keyword Structuring</span>
          <span class="flex items-center gap-1.5">✓ Mobile-First Responsiveness</span>
        </div>
      </div>

    </div>

    <!-- CTA Button -->
    <div class="mt-14">
      <a
        href="/services"
        class="inline-flex items-center justify-center rounded-xl bg-slate-900 text-white px-8 py-4 font-semibold hover:bg-slate-800 transition shadow-lg shadow-slate-900/10 group"
      >
        View All Services & Pricing
        <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>

  </div>
</section>