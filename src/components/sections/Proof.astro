---
// Proof.astro
---

<section class="bg-gradient-to-b from-slate-50/50 via-white to-slate-50/50 py-24 md:py-32 border-b border-slate-100">
  <div class="max-w-6xl mx-auto px-6 text-center">

    <!-- Section Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-50 border border-indigo-100 text-xs font-semibold text-indigo-600 mb-4 shadow-sm">
      <span class="w-1.5 h-1.5 rounded-full bg-indigo-600 animate-pulse"></span>
      Uncompromising Quality
    </div>

    <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
      Built for Performance, <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-blue-600">Not Just Appearance</span>
    </h2>

    <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto font-normal">
      Every website we build follows rigorous technical conversion principles — engineered for speed, search engines, and real results instead of random templates.
    </p>

    <!-- Main Grid Content -->
    <div class="mt-16 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center text-left">

      <!-- Left: Interactive Visual Metric Card (5 Cols) -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl bg-gradient-to-b from-slate-200 to-slate-100 p-1.5 shadow-xl border border-slate-200">
          <div class="bg-white rounded-xl p-8 shadow-inner text-left">
            <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Performance Benchmark</span>
              <span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-600 text-xs font-extrabold">Grade A+</span>
            </div>

            <div class="space-y-4">
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
                <div>
                  <p class="text-xs text-slate-400 font-medium">Lighthouse Score</p>
                  <p class="text-sm font-bold text-slate-800">99 / 100 Overall</p>
                </div>
                <span class="text-emerald-600 font-bold text-sm">⚡ Fast</span>
              </div>

              <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
                <div>
                  <p class="text-xs text-slate-400 font-medium">Mobile Responsiveness</p>
                  <p class="text-sm font-bold text-slate-800">100% Optimized</p>
                </div>
                <span class="text-blue-600 font-bold text-sm">📱 Fluid</span>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
              <span>SEO Index Ready</span>
              <span class="text-emerald-600 font-semibold">● Fully Verified</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Key Results & Pillars (7 Cols) -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
        
        <!-- Pillar 1 -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-base mb-4">
            🎯
          </div>
          <h3 class="text-lg font-bold text-slate-900">Clear Messaging</h3>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">
            Visitors instantly understand your core value proposition within seconds of landing.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-base mb-4">
            💬
          </div>
          <h3 class="text-lg font-bold text-slate-900">Strong WhatsApp Flow</h3>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">
            Frictionless direct enquiry mechanisms strategically embedded into every key section.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-base mb-4">
            ⚡
          </div>
          <h3 class="text-lg font-bold text-slate-900">Mobile-First Speed</h3>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">
            Lightning-fast load times optimized specifically for real user mobile behavior.
          </p>
        </div>

        <!-- Pillar 4 -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-base mb-4">
            📈
          </div>
          <h3 class="text-lg font-bold text-slate-900">SEO-Ready Structure</h3>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">
            Clean heading hierarchy and technical foundations built correctly for search indexing.
          </p>
        </div>

      </div>

    </div>

  </div>
</section>