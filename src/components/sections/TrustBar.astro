---
// TrustBar.astro
---
<section class="py-10 bg-slate-50 border-y border-slate-200/60">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
    <div>
      <p class="text-2xl md:text-3xl font-extrabold text-slate-900">100%</p>
      <p class="text-xs md:text-sm text-slate-600 mt-1">Mobile-First Optimized</p>
    </div>
    <div>
      <p class="text-2xl md:text-3xl font-extrabold text-slate-900">₹8,999</p>
      <p class="text-xs md:text-sm text-slate-600 mt-1">Transparent Pricing</p>
    </div>
    <div>
      <p class="text-2xl md:text-3xl font-extrabold text-slate-900">7 Days</p>
      <p class="text-xs md:text-sm text-slate-600 mt-1">Fast Delivery Timeline</p>
    </div>
    <div>
      <p class="text-2xl md:text-3xl font-extrabold text-emerald-600">Jaipur-Based</p>
      <p class="text-xs md:text-sm text-slate-600 mt-1">Direct 1-on-1 Support</p>
    </div>
  </div>
</section>